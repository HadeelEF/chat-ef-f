diff --git a/client/src/utils/artifactTab.ts b/client/src/utils/artifactTab.ts
new file mode 100644
index 0000000..cbd6067
--- /dev/null
+++ b/client/src/utils/artifactTab.ts
@@ -0,0 +1,48 @@
+import { withEfFonts } from './efFonts';
+
+const TAILWIND_CDN = 'https://cdn.tailwindcss.com/3.4.17';
+
+/**
+ * EF (#153): an HTML page, SVG drawing or Markdown document in a tab of its own, like Claude's "Open in new tab".
+ * The tab is a blob page with no script of its own: the artifact runs only inside a sandboxed `srcdoc` frame without
+ * `allow-same-origin`, so it has an opaque origin and cannot reach the app, its storage or the signed-in API, and it
+ * gets no top navigation. `noopener` keeps it from steering the chat tab. Tailwind and the EF font, which Sandpack
+ * gives the panel's preview, are added the same way.
+ */
+export function openArtifactInTab(html: string, title: string): void {
+  let page = withEfFonts(html);
+  const script = `<script src="${TAILWIND_CDN}"></script>`;
+  const head = /<head\b[^>]*>/i.exec(page);
+  page = head
+    ? page.slice(0, head.index + head[0].length) + script + page.slice(head.index + head[0].length)
+    : script + page;
+
+  const doc = document.implementation.createHTMLDocument(title);
+  const referrer = doc.createElement('meta');
+  referrer.setAttribute('name', 'referrer');
+  referrer.setAttribute('content', 'no-referrer');
+  const style = doc.createElement('style');
+  style.textContent =
+    'html,body{margin:0;height:100%}iframe{display:block;border:0;width:100%;height:100%}';
+  doc.head.append(referrer, style);
+  const frame = doc.createElement('iframe');
+  frame.setAttribute('sandbox', 'allow-scripts allow-forms allow-modals allow-popups');
+  frame.setAttribute('referrerpolicy', 'no-referrer');
+  frame.setAttribute('title', title);
+  frame.setAttribute('srcdoc', page);
+  doc.body.append(frame);
+
+  const url = URL.createObjectURL(
+    new Blob([`<!DOCTYPE html>${doc.documentElement.outerHTML}`], {
+      type: 'text/html;charset=utf-8',
+    }),
+  );
+  const link = document.createElement('a');
+  link.href = url;
+  link.target = '_blank';
+  link.rel = 'noopener noreferrer';
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+  setTimeout(() => URL.revokeObjectURL(url), 60_000);
+}
