@@ -0,0 +1,32 @@
+import { Wrench } from 'lucide-react';
+import { useSandpack } from '@codesandbox/sandpack-react/unstyled';
+import { Button } from '@librechat/client';
+import { useLocalize } from '~/hooks';
+
+/**
+ * EF (#153): Claude's "Try fixing". When the preview reports an error (a compile or runtime error from the
+ * bundler), one press sends the error back to the model with the artifact's title. Renders inside SandpackProvider.
+ */
+export default function ArtifactFixButton({ onTryFix }: { onTryFix?: (error: string) => void }) {
+  const { sandpack } = useSandpack();
+  const localize = useLocalize();
+  const error = sandpack.error?.message?.trim();
+
+  if (onTryFix == null || !error) {
+    return null;
+  }
+
+  return (
+    <div className="pointer-events-none absolute inset-x-0 bottom-4 z-20 flex justify-center">
+      <Button
+        type="button"
+        variant="submit"
+        className="pointer-events-auto gap-2 rounded-full px-4 shadow-lg"
+        onClick={() => onTryFix(error)}
+      >
+        <Wrench size={16} aria-hidden="true" />
+        {localize('com_efaiw_artifact_try_fix')}
+      </Button>
+    </div>
+  );
+}
