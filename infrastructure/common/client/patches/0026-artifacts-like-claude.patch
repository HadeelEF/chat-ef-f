@@ -0,0 +1,77 @@
+import React, { useState } from 'react';
+import { MenuButton } from '@ariakit/react';
+import { Layers, Check } from 'lucide-react';
+import { DropdownPopup, TooltipAnchor, Button } from '@librechat/client';
+import type { Artifact } from '~/common';
+import { displayFilename } from '~/components/Chat/Messages/Content/Parts/attachmentTypes';
+import { useLocalize } from '~/hooks';
+
+/**
+ * EF (#153): the artifacts of this chat, each once by its newest version, like Claude's artifact list. Its versions
+ * stay in ArtifactVersion; this switches between different artifacts.
+ */
+export default function ArtifactSwitcher({
+  items,
+  currentId,
+  portalElement,
+  onSelect,
+}: {
+  /** Newest version of each artifact, in chat order. */
+  items: Artifact[];
+  currentId?: string | null;
+  portalElement?: HTMLElement | null;
+  onSelect: (id: string) => void;
+}) {
+  const localize = useLocalize();
+  const [isOpen, setIsOpen] = useState(false);
+  const label = localize('com_efaiw_artifact_switch');
+
+  if (items.length <= 1) {
+    return null;
+  }
+
+  const seen = new Map<string, number>();
+  const dropdownItems = items.map((item) => {
+    const name = displayFilename(item.title ?? '') || item.title || '';
+    const count = (seen.get(name) ?? 0) + 1;
+    seen.set(name, count);
+    return {
+      label: count > 1 ? `${name} (${count})` : name,
+      onClick: () => {
+        onSelect(item.id);
+        setIsOpen(false);
+      },
+      value: item.id,
+      icon:
+        item.id === currentId ? (
+          <Check size={16} className="text-text-primary" aria-hidden="true" />
+        ) : undefined,
+    };
+  });
+
+  return (
+    <DropdownPopup
+      menuId="artifact-switcher-menu"
+      portal
+      portalElement={portalElement}
+      focusLoop
+      unmountOnHide
+      isOpen={isOpen}
+      setIsOpen={setIsOpen}
+      trigger={
+        <TooltipAnchor
+          description={label}
+          portalElement={portalElement}
+          render={
+            <Button size="icon" variant="ghost" asChild aria-label={label}>
+              <MenuButton>
+                <Layers size={18} className="text-text-secondary" aria-hidden="true" />
+              </MenuButton>
+            </Button>
+          }
+        />
+      }
+      items={dropdownItems}
+    />
+  );
+}
