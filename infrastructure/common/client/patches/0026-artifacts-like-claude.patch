@@ -0,0 +1,60 @@
+import { ExternalLink } from 'lucide-react';
+import { Button, TooltipAnchor } from '@librechat/client';
+import type { Artifact } from '~/common';
+import useArtifactProps from '~/hooks/Artifacts/useArtifactProps';
+import { useCodeState } from '~/Providers/EditorContext';
+import { openArtifactInTab } from '~/utils/artifactTab';
+import { useLocalize } from '~/hooks';
+
+/** EF (#153): the types a browser tab can show on its own; React needs the bundler, so it keeps the full screen. */
+const TAB_TYPES = new Set([
+  'text/html',
+  'application/vnd.code-html',
+  'image/svg+xml',
+  'image/svg',
+  'text/markdown',
+  'text/md',
+]);
+
+export const canOpenInTab = (type?: string | null) => TAB_TYPES.has(type ?? '');
+
+/** EF (#153): Claude's "Open in new tab": the preview's page, edits included, in a sandboxed tab of its own. */
+export default function ArtifactOpenTab({
+  artifact,
+  portalElement,
+}: {
+  artifact: Artifact;
+  portalElement?: HTMLElement | null;
+}) {
+  const localize = useLocalize();
+  const { currentCode } = useCodeState();
+  const { files, fileKey, deriveFiles } = useArtifactProps({ artifact });
+  const label = localize('com_efaiw_artifact_open_tab');
+
+  const handleOpen = () => {
+    const code = currentCode || undefined;
+    const source = deriveFiles != null && code ? deriveFiles(code) : files;
+    const html = fileKey === 'index.html' && code ? code : source['index.html'];
+    if (typeof html === 'string' && html) {
+      openArtifactInTab(html, artifact.title ?? label);
+    }
+  };
+
+  return (
+    <TooltipAnchor
+      description={label}
+      portalElement={portalElement}
+      render={
+        <Button
+          size="icon"
+          variant="ghost"
+          className="h-9 w-9"
+          onClick={handleOpen}
+          aria-label={label}
+        >
+          <ExternalLink size={16} aria-hidden="true" />
+        </Button>
+      }
+    />
+  );
+}
