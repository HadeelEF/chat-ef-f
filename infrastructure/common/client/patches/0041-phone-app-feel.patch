@@ -0,0 +1,123 @@
+import React from 'react';
+import '@testing-library/jest-dom/extend-expect';
+import { act, fireEvent, render, screen } from '@testing-library/react';
+
+jest.mock('~/hooks', () => ({
+  useLocalize: () => (key: string) => key,
+}));
+
+import { dismissInstallHint, openInstallHint } from '~/utils/efaiwApp';
+import EfAppShell from '../EfAppShell';
+
+const IPHONE =
+  'Mozilla/5.0 (iPhone; CPU iPhone OS 17_5 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.5 Mobile/15E148 Safari/604.1';
+const ANDROID =
+  'Mozilla/5.0 (Linux; Android 14; Pixel 7) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Mobile Safari/537.36';
+
+const setNavigator = (key: string, value: unknown) =>
+  Object.defineProperty(window.navigator, key, { value, configurable: true });
+
+class FakeServiceWorker extends EventTarget {
+  controller: object | null;
+  update = jest.fn(() => Promise.resolve());
+  getRegistration = jest.fn(() => Promise.resolve({ update: this.update }));
+  constructor(controller: object | null) {
+    super();
+    this.controller = controller;
+  }
+}
+
+describe('EfAppShell: the iPhone install hint (#238)', () => {
+  beforeEach(() => {
+    localStorage.clear();
+    setNavigator('serviceWorker', undefined);
+    setNavigator('standalone', undefined);
+    setNavigator('platform', '');
+  });
+  afterEach(() => {
+    act(() => dismissInstallHint());
+    localStorage.clear();
+  });
+
+  it('iPhone browser: shown once; «فهمت» hides it for good; the menu row shows it again', () => {
+    setNavigator('userAgent', IPHONE);
+    const { unmount } = render(<EfAppShell />);
+    expect(screen.getByRole('note')).toHaveTextContent('com_efaiw_install_hint_title');
+    expect(screen.getByRole('note')).toHaveTextContent('com_efaiw_install_hint_body');
+
+    fireEvent.click(screen.getByTestId('efaiw-install-hint-ok'));
+    expect(screen.queryByRole('note')).toBeNull();
+    expect(localStorage.getItem('efaiw:install-hint-seen')).toBe('1');
+
+    unmount();
+    render(<EfAppShell />);
+    expect(screen.queryByRole('note')).toBeNull();
+    act(() => openInstallHint());
+    expect(screen.getByRole('note')).toBeInTheDocument();
+  });
+
+  it('never inside the installed app, and not on Android (it has the browser dialog)', () => {
+    setNavigator('userAgent', IPHONE);
+    setNavigator('standalone', true);
+    const { unmount } = render(<EfAppShell />);
+    expect(screen.queryByRole('note')).toBeNull();
+    unmount();
+
+    setNavigator('standalone', undefined);
+    setNavigator('userAgent', ANDROID);
+    render(<EfAppShell />);
+    expect(screen.queryByRole('note')).toBeNull();
+  });
+});
+
+describe('EfAppShell: the new-version bar (#238)', () => {
+  beforeEach(() => {
+    setNavigator('userAgent', ANDROID);
+  });
+
+  it('a new worker taking over an open page shows «تحديث»', () => {
+    const sw = new FakeServiceWorker({});
+    setNavigator('serviceWorker', sw);
+    render(<EfAppShell />);
+    expect(screen.queryByRole('status')).toBeNull();
+    act(() => {
+      sw.dispatchEvent(new Event('controllerchange'));
+    });
+    expect(screen.getByRole('status')).toHaveTextContent('com_efaiw_update_available');
+    expect(screen.getByTestId('efaiw-update-reload')).toHaveTextContent('com_efaiw_update_reload');
+  });
+
+  it('the first take-over after a fresh install is silent', () => {
+    const sw = new FakeServiceWorker(null);
+    setNavigator('serviceWorker', sw);
+    render(<EfAppShell />);
+    act(() => {
+      sw.dispatchEvent(new Event('controllerchange'));
+    });
+    expect(screen.queryByRole('status')).toBeNull();
+    act(() => {
+      sw.dispatchEvent(new Event('controllerchange'));
+    });
+    expect(screen.getByRole('status')).toBeInTheDocument();
+  });
+
+  it('back in the foreground: re-checks the worker at most every ten minutes', async () => {
+    const sw = new FakeServiceWorker({});
+    setNavigator('serviceWorker', sw);
+    const now = jest.spyOn(Date, 'now').mockReturnValue(1_000_000);
+    Object.defineProperty(document, 'visibilityState', { value: 'visible', configurable: true });
+    render(<EfAppShell />);
+
+    now.mockReturnValue(1_000_000 + 5 * 60 * 1000);
+    document.dispatchEvent(new Event('visibilitychange'));
+    expect(sw.getRegistration).not.toHaveBeenCalled();
+
+    now.mockReturnValue(1_000_000 + 11 * 60 * 1000);
+    await act(async () => {
+      document.dispatchEvent(new Event('visibilitychange'));
+    });
+    expect(sw.getRegistration).toHaveBeenCalledTimes(1);
+    expect(sw.update).toHaveBeenCalledTimes(1);
+    now.mockRestore();
+  });
+});
