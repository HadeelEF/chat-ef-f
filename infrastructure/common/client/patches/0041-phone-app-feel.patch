+import { useSyncExternalStore } from 'react';
+
+/**
+ * EF (phone app feel, #238): what makes the installed web app behave like a phone app.
+ *
+ * Chromium browsers (Android, desktop) offer installation once per page load with `beforeinstallprompt`, often
+ * before React mounts, so the offer is kept here from the first module load (main.jsx imports this file before the
+ * app). iPhone browsers have no such event: installation is Share → «Add to Home Screen», which the hint explains.
+ */
+type InstallPromptEvent = Event & {
+  prompt: () => Promise<void>;
+  userChoice: Promise<{ outcome: 'accepted' | 'dismissed' }>;
+};
+
+const HINT_SEEN_KEY = 'efaiw:install-hint-seen';
+
+let deferredPrompt: InstallPromptEvent | null = null;
+/** The menu row asked for the hint again. */
+let hintForced = false;
+/** «فهمت» in a browser that refuses storage: hidden for this visit. */
+let hintDismissed = false;
+const listeners = new Set<() => void>();
+const notify = () => listeners.forEach((listener) => listener());
+
+if (typeof window !== 'undefined') {
+  window.addEventListener('beforeinstallprompt', (event) => {
+    /** Keeps Chrome's own mini-infobar away; the menu row offers the same prompt when the employee wants it. */
+    event.preventDefault();
+    deferredPrompt = event as InstallPromptEvent;
+    notify();
+  });
+  window.addEventListener('appinstalled', () => {
+    deferredPrompt = null;
+    notify();
+  });
+}
+
+/** Opened from the home screen: display-mode for Chromium and newer Safari, `navigator.standalone` for older iOS. */
+export function isStandaloneApp(): boolean {
+  if (typeof window === 'undefined') {
+    return false;
+  }
+  const iosStandalone = (navigator as Navigator & { standalone?: boolean }).standalone === true;
+  return iosStandalone || window.matchMedia?.('(display-mode: standalone)').matches === true;
+}
+
+/** iPhone, iPod and iPad (iPadOS reports itself as a Mac with a touch screen). */
+export function isIOSDevice(): boolean {
+  if (typeof navigator === 'undefined') {
+    return false;
+  }
+  return (
+    /iPhone|iPad|iPod/.test(navigator.userAgent) ||
+    (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)
+  );
+}
+
+const hintSeen = () => {
+  try {
+    return localStorage.getItem(HINT_SEEN_KEY) === '1';
+  } catch {
+    return true;
+  }
+};
+
+const subscribe = (listener: () => void) => {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+};
+const canPrompt = () => deferredPrompt != null;
+const isHintOpen = () =>
+  hintForced || (!hintDismissed && isIOSDevice() && !isStandaloneApp() && !hintSeen());
+
+/** Shows the browser's install dialog; false when there is no offer (already used, or not installable). */
+export async function promptInstall(): Promise<boolean> {
+  const event = deferredPrompt;
+  if (event == null) {
+    return false;
+  }
+  /** One offer, one prompt: Chromium rejects a second `prompt()` on the same event. */
+  deferredPrompt = null;
+  notify();
+  await event.prompt();
+  const { outcome } = await event.userChoice;
+  return outcome === 'accepted';
+}
+
+/** The menu row on iPhone: the hint again, even after «فهمت». */
+export function openInstallHint() {
+  hintForced = true;
+  notify();
+}
+
+/** «فهمت»: the hint stays hidden on this browser. */
+export function dismissInstallHint() {
+  hintForced = false;
+  try {
+    localStorage.setItem(HINT_SEEN_KEY, '1');
+  } catch {
+    hintDismissed = true;
+  }
+  notify();
+}
+
+/**
+ * The iPhone hint: once, outside the installed app. Other first-visit tips (the skills tip) wait while it is open, so
+ * a new employee meets one card at a time.
+ */
+export function useInstallHintOpen() {
+  return useSyncExternalStore(subscribe, isHintOpen, () => false);
+}
+
+/**
+ * The menu row: on Android and desktop when the browser offers installation, on iPhone always (it opens the hint);
+ * never inside the installed app.
+ */
+export function useEfInstall() {
+  const canInstall = useSyncExternalStore(subscribe, canPrompt, () => false);
+  const standalone = isStandaloneApp();
+  const ios = isIOSDevice();
+  return { show: !standalone && (canInstall || ios), canInstall, ios };
+}
