diff --git a/client/src/components/EfApp/EfAppShell.tsx b/client/src/components/EfApp/EfAppShell.tsx
new file mode 100644
index 0000000..d030a9c
--- /dev/null
+++ b/client/src/components/EfApp/EfAppShell.tsx
@@ -0,0 +1,104 @@
+import { memo, useEffect, useState } from 'react';
+import { Share } from 'lucide-react';
+import { dismissInstallHint, useInstallHintOpen } from '~/utils/efaiwApp';
+import { useLocalize } from '~/hooks';
+
+/** The browser re-checks the service worker on each page load only; an installed app may stay open for days. */
+const UPDATE_CHECK_MS = 10 * 60 * 1000;
+
+/**
+ * EF (#238): on iPhone, outside the installed app, once: how to put «بصير» on the home screen (iPhone has no install
+ * button). «فهمت» hides it for good on this browser; the account menu's «تثبيت التطبيق» shows it again.
+ */
+function EfInstallHint() {
+  const localize = useLocalize();
+  const open = useInstallHintOpen();
+
+  if (!open) {
+    return null;
+  }
+  return (
+    <div className="efaiw-install-hint" role="note" aria-labelledby="efaiw-install-hint-title">
+      <span className="efaiw-install-hint-icon" aria-hidden="true">
+        <Share className="h-5 w-5" />
+      </span>
+      <div className="efaiw-install-hint-text">
+        <b id="efaiw-install-hint-title">{localize('com_efaiw_install_hint_title')}</b>
+        <span>{localize('com_efaiw_install_hint_body')}</span>
+      </div>
+      <button type="button" data-testid="efaiw-install-hint-ok" onClick={dismissInstallHint}>
+        {localize('com_efaiw_install_hint_ok')}
+      </button>
+    </div>
+  );
+}
+
+/**
+ * EF (#238): a new version deployed while the app is open. The new service worker takes over at once (skipWaiting,
+ * clientsClaim) but the page keeps running the old build, so the employee is told and chooses when to reload. The
+ * first take-over after a fresh install is not an update and stays silent. When the app comes back to the
+ * foreground, the worker is re-checked at most every ten minutes.
+ */
+function EfUpdateBar() {
+  const localize = useLocalize();
+  const [ready, setReady] = useState(false);
+
+  useEffect(() => {
+    const sw = typeof navigator !== 'undefined' ? navigator.serviceWorker : undefined;
+    if (sw == null) {
+      return;
+    }
+    let hadController = sw.controller != null;
+    const onControllerChange = () => {
+      if (hadController) {
+        setReady(true);
+      }
+      hadController = true;
+    };
+    let lastCheck = Date.now();
+    const onVisible = () => {
+      if (document.visibilityState !== 'visible' || Date.now() - lastCheck < UPDATE_CHECK_MS) {
+        return;
+      }
+      lastCheck = Date.now();
+      sw.getRegistration()
+        .then((registration) => registration?.update())
+        .catch(() => {
+          /* Offline or no worker: the next return to the foreground tries again. */
+        });
+    };
+    sw.addEventListener('controllerchange', onControllerChange);
+    document.addEventListener('visibilitychange', onVisible);
+    return () => {
+      sw.removeEventListener('controllerchange', onControllerChange);
+      document.removeEventListener('visibilitychange', onVisible);
+    };
+  }, []);
+
+  if (!ready) {
+    return null;
+  }
+  return (
+    <div className="efaiw-update-bar" role="status">
+      <span>{localize('com_efaiw_update_available')}</span>
+      <button
+        type="button"
+        data-testid="efaiw-update-reload"
+        onClick={() => window.location.reload()}
+      >
+        {localize('com_efaiw_update_reload')}
+      </button>
+    </div>
+  );
+}
+
+function EfAppShell() {
+  return (
+    <>
+      <EfInstallHint />
+      <EfUpdateBar />
+    </>
+  );
+}
+
+export default memo(EfAppShell);
