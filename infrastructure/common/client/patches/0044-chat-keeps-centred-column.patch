@@ -0,0 +1,18 @@
+import { snapshot_UNSTABLE } from 'recoil';
+import { registry } from '~/components/Nav/Settings/registry';
+import settings from '../settings';
+
+/** EF (#243): the chat keeps its centred reading column on wide screens, as ChatGPT and Claude do. */
+describe('maximizeChatSpace', () => {
+  afterEach(() => localStorage.clear());
+
+  it('ignores a «maximize» saved in this browser', () => {
+    localStorage.setItem('maximizeChatSpace', JSON.stringify(true));
+
+    expect(snapshot_UNSTABLE().getLoadable(settings.maximizeChatSpace).valueOrThrow()).toBe(false);
+  });
+
+  it('is not offered in Settings', () => {
+    expect(registry.find((entry) => entry.id === 'maximizeChatSpace')).toBeUndefined();
+  });
+});
