+  memories: 'com_efaiw_rail_memories',
+  bookmarks: 'com_efaiw_rail_bookmarks',
+  files: 'com_efaiw_rail_files',
+  parameters: 'com_efaiw_rail_parameters',
+};
+
+const rowClass =
+  'efaiw-side-row flex h-11 w-full items-center gap-3 rounded-xl px-3 text-start text-[15px] text-text-primary outline-none transition-colors hover:bg-surface-hover focus-visible:ring-2 focus-visible:ring-ring-primary';
+
+/**
+ * EF (Concept 1, owner-approved): the expanded sidebar as one column after ChatGPT's, on the desktop and in the phone
+ * drawer. Top to bottom: the EF logo and the close control; «New chat» in the primary blue; the chat search; the agents
+ * marketplace; «More», which lists every other panel LibreChat offers (agent builder, skills, prompts, memory,
+ * bookmarks, files, parameters, and any the deployment enables); the active panel (the chat history by default, with a
+ * way back to it from any other panel); the account menu. Nothing LibreChat offers is removed: the collapsed desktop
+ * sidebar keeps the labelled rail, and the hidden shortcut targets keep the panel shortcuts working.
+ */
+function EfSidebarColumn({
+  links,
+  mobile = false,
+  expanded = true,
+  onClose,
+  onLeaveInsights,
+}: {
+  links: NavLink[];
+  mobile?: boolean;
+  expanded?: boolean;
+  onClose: (afterSlide?: () => void) => void;
+  onLeaveInsights?: () => void;
+}) {
+  const localize = useLocalize();
+  const location = useLocation();
+  const { active, setActive } = useActivePanel();
+  const search = useRecoilValue(store.search);
+  const switchToHistory = useRecoilValue(store.newChatSwitchToHistory);
+  const showMarketplace = useShowMarketplace();
+  const [moreOpen, setMoreOpen] = useLocalStorage('efaiwSidebarMoreOpen', false);
+  const closeRef = useRef<HTMLButtonElement>(null);
+
+  const isInsightsRoute = location.pathname.startsWith('/insights');
+  const routeActiveId = isInsightsRoute ? 'insights' : undefined;
+  const activeId = routeActiveId ?? resolveActivePanel(active, links);
+  const activeLink = links.find((link) => link.id === activeId);
+  const moreLinks = links.filter((link) => link.id !== DEFAULT_PANEL);
+  const labelOf = (link: NavLink) => localize(MORE_LABELS[link.id] ?? link.title);
+
+  const toggleLabel = 'com_nav_close_sidebar';
+  const toggleHint = useShortcutHint('toggleSidebar', localize(toggleLabel));
+  const toggleAriaKey = useShortcutAriaKey('toggleSidebar');
+  const newChatHint = useShortcutHint('newChat', localize('com_ui_new_chat'));
+  const newChatAriaKey = useShortcutAriaKey('newChat');
+  /* The keys as bound now (the employee can rebind or turn shortcuts off in Settings). */
+  const newChatKeys = parseShortcutKeys(useShortcutDisplay('newChat'));
+  const logoAlt = localize('com_ui_logo', { 0: localize('com_efaiw_ef_name') });
+
+  /** The phone drawer makes the chat inert while open, so focus moves into it (as upstream's drawer header did). */
+  useEffect(() => {
+    if (mobile && expanded) {
+      closeRef.current?.focus();
+    }
+  }, [mobile, expanded]);
+
+  const { startNewChat, handleNewChatClick: desktopNewChat } = useNewChat({
+    onNewChat: () => {
+      if (switchToHistory) {
+        setActive(DEFAULT_PANEL);
+      }
+    },
+  });
+
+  /** Phone: close first and reset in the slide's callback, as upstream's drawer bottom bar did, so the reset does not
+   *  stall the slide; modified clicks still open /c/new in a new tab. */
+  const handleNewChat = useCallback(
+    (event: React.MouseEvent<HTMLAnchorElement>) => {
+      if (!mobile) {
+        desktopNewChat(event);
+        return;
+      }
+      if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey) {
+        return;
+      }
+      event.preventDefault();
+      onClose(() => startNewChat());
+    },
+    [mobile, desktopNewChat, onClose, startNewChat],
+  );
+
+  const openPanel = useCallback(
+    (link: NavLink, event?: React.MouseEvent<HTMLButtonElement>) => {
+      if (link.onClick) {
+        link.onClick(event);
+        if (mobile) {
+          onClose();
+        }
+        return;
+      }
+      setActive(link.id);
+      /* The list folds away so the chosen panel gets the room; its header names it and leads back to the chats. */
+      setMoreOpen(false);
+      if (routeActiveId) {
+        onLeaveInsights?.();
+      }
+    },
+    [mobile, onClose, setActive, setMoreOpen, routeActiveId, onLeaveInsights],
+  );
+
+  return (
+    <div className="efaiw-side flex h-full w-full min-w-0 flex-col bg-surface-primary-alt">
+      <div className="efaiw-side-top flex flex-shrink-0 items-center justify-between gap-2">
+        <img
+          src="assets/logo.svg"
+          className="efaiw-side-logo h-[52px] w-auto dark:hidden"
+          alt={logoAlt}
+        />
+        <img
+          src="assets/logo-dark.svg"
+          className="efaiw-side-logo hidden h-[52px] w-auto dark:block"
+          alt={logoAlt}
+        />
+        <TooltipAnchor
+          side={mobile ? 'bottom' : 'right'}
+          description={toggleHint}
+          render={
+            <Button
+              ref={closeRef}
+              /* OpenSidebar focuses this id after opening; claimed only while the column is shown. */
+              id={expanded ? CLOSE_SIDEBAR_ID : undefined}
+              data-testid={expanded ? 'close-sidebar-button' : undefined}
+              size="icon"
+              variant="ghost"
+              aria-label={localize(toggleLabel)}
+              aria-expanded={expanded}
+              aria-controls="chat-history-nav"
+              aria-keyshortcuts={toggleAriaKey}
+              tabIndex={expanded ? 0 : -1}
+              className="h-10 w-10 flex-shrink-0 rounded-lg text-text-secondary"
+              onClick={() => onClose()}
+            >
+              {mobile ? (
+                <X className="h-[22px] w-[22px]" aria-hidden="true" />
+              ) : (
+                <Sidebar className="h-5 w-5" aria-hidden="true" />
+              )}
+            </Button>
+          }
+        />
+      </div>
+
+      <div className="efaiw-side-nav flex flex-shrink-0 flex-col gap-0.5">
+        <TooltipAnchor
+          side={mobile ? 'bottom' : 'right'}
+          description={newChatHint}
+          render={
+            <a
+              href="/c/new"
+              data-testid={mobile ? 'nav-new-chat-fab' : 'new-chat-button'}
+              aria-label={localize('com_ui_new_chat')}
+              aria-keyshortcuts={newChatAriaKey}
+              className="efaiw-side-new flex h-[46px] w-full items-center gap-3 rounded-xl px-3 text-[15px] font-semibold outline-none focus-visible:ring-2 focus-visible:ring-ring-primary focus-visible:ring-offset-2"
+              onClick={handleNewChat}
+            >
+              <SquarePen className="h-5 w-5 flex-shrink-0" aria-hidden="true" />
+              <span className="flex-1 truncate">{localize('com_ui_new_chat')}</span>
+              {!mobile && newChatKeys.length > 0 && (
+                <span className="efaiw-side-kbd" aria-hidden="true">
+                  {newChatKeys.map((key, idx) => (
+                    <kbd key={`${key}-${idx}`}>{key}</kbd>
+                  ))}
+                </span>
+              )}
+            </a>
+          }
+        />
+
+        {search.enabled === true && (
+          <div
+            className="efaiw-side-search flex"
+            /* Searching filters the chat history, so the history comes back into view. */
+            onFocusCapture={() => {
+              if (activeId !== DEFAULT_PANEL && !routeActiveId) {
+                setActive(DEFAULT_PANEL);
+              }
+            }}
+          >
+            <SearchBar isSmallScreen={mobile} />
+          </div>
+        )}
+
+        {showMarketplace && (
+          <Link
+            to="/agents"
+            data-testid="nav-agents-marketplace-button"
+            aria-label={localize('com_agents_marketplace')}
+            title={localize('com_agents_marketplace')}
+            className={rowClass}
+            onClick={(event) => {
+              if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey) {
+                return;
+              }
+              if (mobile) {
+                onClose();
+              }
+            }}
+          >
+            <LayoutGrid className="h-5 w-5 flex-shrink-0 text-text-secondary" aria-hidden="true" />
+            <span className="flex-1 truncate">{localize('com_efaiw_rail_agents')}</span>
+          </Link>
+        )}
+
+        {moreLinks.length > 0 && (
+          <>
+            <button
+              type="button"
+              data-testid="efaiw-more-toggle"
+              aria-expanded={moreOpen}
+              aria-controls="efaiw-more-list"
+              className={cn(rowClass, moreOpen && 'efaiw-side-more-open')}
+              onClick={() => setMoreOpen(!moreOpen)}
+            >
+              <Ellipsis
+                className="efaiw-side-more-icon h-5 w-5 flex-shrink-0 text-text-secondary"
+                aria-hidden="true"
+              />
+              <span className="flex-1 truncate">{localize('com_efaiw_more')}</span>
+              <ChevronDown
+                className={cn(
+                  'h-4 w-4 flex-shrink-0 text-text-secondary transition-transform',
+                  moreOpen && 'rotate-180',
+                )}
+                aria-hidden="true"
+              />
+            </button>
+            {moreOpen && (
+              <ul id="efaiw-more-list" className="efaiw-side-more flex flex-col gap-0.5">
+                {moreLinks.map((link) => {
+                  const isActive = link.id === activeId;
+                  return (
+                    <li key={link.id}>
+                      <button
+                        type="button"
+                        data-testid={`efaiw-more-${link.id}`}
+                        aria-pressed={isActive}
+                        disabled={link.disabled}
+                        className={cn(
+                          rowClass,
+                          'h-10 text-[14.5px]',
+                          isActive && 'efaiw-side-active',
+                        )}
+                        onClick={(event) => openPanel(link, event)}
+                      >
+                        <link.icon className="h-[18px] w-[18px] flex-shrink-0" aria-hidden="true" />
+                        <span className="flex-1 truncate">{labelOf(link)}</span>
+                      </button>
+                    </li>
+                  );
+                })}
+              </ul>
+            )}
+          </>
+        )}
+      </div>
+
+      <div className="efaiw-side-panel flex min-h-0 flex-1 flex-col">
+        {activeId !== DEFAULT_PANEL && activeLink && !routeActiveId && (
+          <div className="efaiw-side-panel-head flex flex-shrink-0 items-center gap-2">
+            <button
+              type="button"
+              data-testid="efaiw-back-to-chats"
+              className="flex h-9 items-center gap-1 rounded-lg px-2 text-sm text-text-secondary outline-none hover:bg-surface-hover focus-visible:ring-2 focus-visible:ring-ring-primary"
+              onClick={() => setActive(DEFAULT_PANEL)}
+            >
+              <ChevronLeft className="h-4 w-4 rtl:rotate-180" aria-hidden="true" />
+              {localize('com_efaiw_back_to_chats')}
+            </button>
+            <h2 className="min-w-0 flex-1 truncate text-end text-sm font-semibold text-text-primary">
+              {labelOf(activeLink)}
+            </h2>
+          </div>
+        )}
+        <nav
+          id="chat-history-nav"
+          aria-label={localize('com_ui_chat_history')}
+          className="min-h-0 flex-1 overflow-hidden"
+        >
+          <SidePanelNav links={links} />
+        </nav>
+      </div>
+
+      <ShortcutTargets
+        links={links}
+        onLeaveInsights={onLeaveInsights}
+        routeActiveId={routeActiveId}
+      />
+
+      <div
+        className="efaiw-side-me flex-shrink-0"
+        style={
+          mobile ? { paddingBottom: 'calc(0.75rem + env(safe-area-inset-bottom, 0px))' } : undefined
+        }
+      >
+        <Suspense fallback={<Skeleton className="h-11 w-full rounded-xl" />}>
+          <AccountSettings />
+        </Suspense>
+      </div>
+    </div>
+  );
+}
+
+export default memo(EfSidebarColumn);
