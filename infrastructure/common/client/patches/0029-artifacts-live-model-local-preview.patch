diff --git a/client/src/components/Artifacts/StaticArtifactFrame.tsx b/client/src/components/Artifacts/StaticArtifactFrame.tsx
new file mode 100644
index 0000000..6655d35
--- /dev/null
+++ b/client/src/components/Artifacts/StaticArtifactFrame.tsx
@@ -0,0 +1,77 @@
+import { memo, useEffect, useMemo, useRef, useState, type MutableRefObject } from 'react';
+import type { SandpackPreviewRef } from '@codesandbox/sandpack-react/unstyled';
+import {
+  ARTIFACT_ERROR_MESSAGE,
+  ARTIFACT_FRAME_SANDBOX,
+  buildArtifactPage,
+} from '~/utils/artifactTab';
+import { TryFixButton } from './ArtifactFixButton';
+
+/**
+ * EF (#167): the preview of a page, drawing, document or code file, built here instead of by Sandpack's hosted static
+ * server. It is the page Sandpack served (Tailwind, the EF font) in a `srcdoc` frame sandboxed without
+ * `allow-same-origin`: an opaque origin, like the hosted server's own domain, so it cannot reach the app, its storage
+ * or the signed-in API, and it gets no top navigation. It shows at once, with no round trip to codesandbox.io, and
+ * works where that site is slow or blocked. The page's own errors reach Try fixing; the panel's refresh reloads it.
+ */
+const StaticArtifactFrame = memo(function StaticArtifactFrame({
+  html,
+  title,
+  previewRef,
+  onTryFix,
+}: {
+  html: string;
+  title: string;
+  previewRef: MutableRefObject<SandpackPreviewRef>;
+  onTryFix?: (error: string) => void;
+}) {
+  const frameRef = useRef<HTMLIFrameElement>(null);
+  const [reloads, setReloads] = useState(0);
+  const [error, setError] = useState<string | null>(null);
+  const srcDoc = useMemo(() => buildArtifactPage(html, true), [html]);
+
+  useEffect(() => {
+    setError(null);
+  }, [srcDoc, reloads]);
+
+  useEffect(() => {
+    const onMessage = (event: MessageEvent) => {
+      if (event.source == null || event.source !== frameRef.current?.contentWindow) {
+        return;
+      }
+      const data = event.data as { type?: unknown; message?: unknown } | null;
+      if (data?.type === ARTIFACT_ERROR_MESSAGE && typeof data.message === 'string') {
+        setError(data.message.slice(0, 2000));
+      }
+    };
+    window.addEventListener('message', onMessage);
+    return () => window.removeEventListener('message', onMessage);
+  }, []);
+
+  /* The panel's refresh button asks the preview ref for a Sandpack client and dispatches `refresh`; this frame
+   * answers the same call by loading the page again. */
+  useEffect(() => {
+    const reload = () => setReloads((count) => count + 1);
+    previewRef.current = {
+      clientId: null,
+      getClient: () => ({ dispatch: reload }),
+    } as unknown as SandpackPreviewRef;
+  }, [previewRef]);
+
+  return (
+    <div className="relative h-full w-full">
+      <iframe
+        key={reloads}
+        ref={frameRef}
+        title={title}
+        sandbox={ARTIFACT_FRAME_SANDBOX}
+        referrerPolicy="no-referrer"
+        srcDoc={srcDoc}
+        className="block h-full w-full border-0 bg-white"
+      />
+      <TryFixButton error={error} onTryFix={onTryFix} />
+    </div>
+  );
+});
+
+export default StaticArtifactFrame;
