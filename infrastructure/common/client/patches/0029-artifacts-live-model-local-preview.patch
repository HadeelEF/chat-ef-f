index 0000000..27c4eff
--- /dev/null
+++ b/client/src/components/Chat/Messages/Content/__tests__/MarkdownBlocks.artifactSource.test.tsx
@@ -0,0 +1,86 @@
+import React from 'react';
+import { RecoilRoot } from 'recoil';
+import { MemoryRouter } from 'react-router-dom';
+import { render, screen } from '@testing-library/react';
+import { MessageContext } from '~/Providers';
+import Markdown from '../Markdown';
+
+/**
+ * EF (#167): an artifact's content reaches the panel exactly as the model wrote it, whether the model fenced it as
+ * documented or wrote the document straight inside the directive (as Qwen does), and whether the fence was too short
+ * for the code blocks inside it. Only `ArtifactButton` is stubbed, to read the content back.
+ */
+jest.mock('~/components/Artifacts/ArtifactButton', () => ({
+  __esModule: true,
+  default: ({ artifact }: { artifact?: { content?: string } }) => (
+    <pre data-testid="art">{artifact?.content ?? ''}</pre>
+  ),
+}));
+
+const view = (content: string, submitting: boolean) => (
+  <MemoryRouter>
+    <RecoilRoot>
+      <MessageContext.Provider
+        value={{
+          messageId: 'm1',
+          isExpanded: true,
+          isSubmitting: submitting,
+          isLatestMessage: true,
+        }}
+      >
+        <Markdown content={content} isLatestMessage={true} />
+      </MessageContext.Provider>
+    </RecoilRoot>
+  </MemoryRouter>
+);
+
+/** The rendered code element ends with a newline, as for every fenced block. */
+const contentOf = async (message: string, streamed: boolean) => {
+  const rendered = render(view(message, streamed));
+  rendered.rerender(view(message, false));
+  return (await screen.findByTestId('art')).textContent?.replace(/\n$/, '');
+};
+
+const DOCUMENT = [
+  '**صندوق البيئة**',
+  'الإدارة العامة للشؤون الإدارية',
+  '',
+  '## تعميم داخلي',
+  '',
+  '1. **الطباعة على وجهين:** افتراضياً.',
+  '2. المراجعة قبل الطباعة.',
+  '',
+  '| البند | الكمية |',
+  '|---|---|',
+  '| ورق | 10 |',
+].join('\n');
+
+const open = '{identifier="paper-circular" type="text/markdown" title="تعميم"}';
+
+describe.each([
+  ['a finished', false],
+  ['a streamed', true],
+])('artifact content in %s message', (_label, streamed) => {
+  it('keeps a document written straight inside the directive, line by line', async () => {
+    const message = `مقدمة.\n\n:::artifact${open}\n${DOCUMENT}\n:::\n\nخاتمة.`;
+    expect(await contentOf(message, streamed)).toBe(DOCUMENT);
+  });
+
+  it('keeps the documented form (one fenced block) as before', async () => {
+    const message = `:::artifact${open}\n\`\`\`\`\n${DOCUMENT}\n\`\`\`\`\n:::`;
+    expect(await contentOf(message, streamed)).toBe(DOCUMENT);
+  });
+
+  it('drops a fence too short for the code blocks inside the document', async () => {
+    const inner = `# دليل\n\n\`\`\`python\nprint("مرحباً")\n\`\`\`\n\nنهاية الدليل.`;
+    const message = `:::artifact${open}\n\`\`\`markdown\n${inner}\n\`\`\`\n:::`;
+    expect(await contentOf(message, streamed)).toBe(inner);
+  });
+
+  it('keeps an unfenced HTML page as written', async () => {
+    const page =
+      '<!DOCTYPE html>\n<html lang="ar" dir="rtl">\n<body>\n<h1>مرحباً</h1>\n</body>\n</html>';
+    const message = `:::artifact{identifier="p" type="text/html" title="صفحة"}\n${page}\n:::`;
+    expect(await contentOf(message, streamed)).toBe(page);
+  });
+});
