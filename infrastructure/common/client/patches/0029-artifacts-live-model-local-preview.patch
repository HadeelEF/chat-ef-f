+export function artifactSource(node: SourceNode, source: string): string | null {
+  const children = node.children ?? [];
+  if (children.length === 0 || (children.length === 1 && children[0].type === 'code')) {
+    return null;
+  }
+  const start = children[0].position?.start?.offset;
+  const end = children[children.length - 1].position?.end?.offset;
+  if (start == null || end == null || source === '') {
+    return null;
+  }
+  const raw = source.slice(start, end);
+  return OPENING_FENCE.test(raw) && CLOSING_FENCE.test(raw)
+    ? raw.replace(OPENING_FENCE, '').replace(CLOSING_FENCE, '')
+    : raw;
+}
