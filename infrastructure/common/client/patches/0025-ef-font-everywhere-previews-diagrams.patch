+    `Object.assign({},th,{extend:Object.assign({},ex,{fontFamily:Object.assign({},ex.fontFamily,{sans:sans})})})});` +
+    `}catch(e){}}var current=window.tailwind;try{Object.defineProperty(window,'tailwind',{configurable:true,` +
+    `get:function(){return current},set:function(v){current=v;if(v)setTimeout(function(){apply(v)},0)}})}catch(e){}` +
+    `if(current)apply(current);document.addEventListener('DOMContentLoaded',function(){if(current)apply(current)})})();`;
