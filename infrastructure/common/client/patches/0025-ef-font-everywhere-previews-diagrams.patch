+/** Adds the font block once, at the start of `<head>` (or where a head would begin). */
+export function withEfFonts(html: string): string {
+  if (html.includes(MARKER)) {
+    return html;
+  }
+  const block = getEfFontHead();
+  const head = /<head\b[^>]*>/i.exec(html);
+  if (head) {
+    const at = head.index + head[0].length;
+    return html.slice(0, at) + block + html.slice(at);
+  }
+  const root = /<html\b[^>]*>/i.exec(html) ?? /^\s*<!doctype[^>]*>/i.exec(html);
+  if (root) {
+    const at = root.index + root[0].length;
+    return `${html.slice(0, at)}<head>${block}</head>${html.slice(at)}`;
+  }
+  return block + html;
+}
+
+/** Resolves once the page has the brand font (or after `timeout`), so Mermaid measures text in the face it draws. */
+export function waitForEfFonts(timeout = 1500): Promise<void> {
+  if (typeof document === 'undefined' || document.fonts?.load == null) {
+    return Promise.resolve();
+  }
+  const loads = Promise.all(
+    EF_FONT_FILES.map(([weight]) => document.fonts.load(`${weight} 16px "EF Aktiv Grotesk"`)),
+  ).then(
+    () => undefined,
+    () => undefined,
+  );
+  return Promise.race([loads, new Promise<void>((resolve) => setTimeout(resolve, timeout))]);
