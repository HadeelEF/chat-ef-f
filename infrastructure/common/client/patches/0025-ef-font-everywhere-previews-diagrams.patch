+      weights.push(EF_FONT_FILES[2]);
+    }
+    const faces = await Promise.all(
+      weights.map(
+        async ([weight, file]) =>
+          `@font-face{font-family:"EF Aktiv Grotesk";font-style:normal;font-weight:${weight}` +
+          `${weight === 700 ? ' 900' : ''};src:url("${await fontDataUrl(file)}") format("opentype")}`,
+      ),
