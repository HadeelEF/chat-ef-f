diff --git a/client/src/components/Messages/Content/Mermaid/MermaidSvg.tsx b/client/src/components/Messages/Content/Mermaid/MermaidSvg.tsx
new file mode 100644
index 0000000..038f1e5
--- /dev/null
+++ b/client/src/components/Messages/Content/Mermaid/MermaidSvg.tsx
@@ -0,0 +1,43 @@
+import React, { memo, useLayoutEffect, useRef } from 'react';
+
+/**
+ * EF (#152): a rendered diagram drawn inline instead of as `<img src=blob:…>`. An image cannot use the page's web
+ * fonts, so Mermaid measured labels in Aktiv Grotesk and drew them in a fallback face, and they could overflow. A
+ * shadow root keeps each diagram's `<style>` and element ids to itself while the app's `@font-face` rules still apply.
+ * The markup is the sanitized output of `sanitizeMermaidSvg` (no scripts, no external URLs), parsed as XML and
+ * imported as nodes, never assigned as HTML.
+ */
+const HOST_CSS = ':host{display:block}svg{display:block;width:100%;height:100%}';
+
+interface MermaidSvgProps {
+  svg: string;
+  label: string;
+  className?: string;
+  style?: React.CSSProperties;
+}
+
+const MermaidSvg = memo(({ svg, label, className, style }: MermaidSvgProps) => {
+  const hostRef = useRef<HTMLDivElement>(null);
+
+  useLayoutEffect(() => {
+    const host = hostRef.current;
+    if (!host) {
+      return;
+    }
+    const root = host.shadowRoot ?? host.attachShadow({ mode: 'open' });
+    const doc = new DOMParser().parseFromString(svg, 'image/svg+xml');
+    const css = document.createElement('style');
+    css.textContent = HOST_CSS;
+    if (doc.querySelector('parsererror') || doc.documentElement.localName !== 'svg') {
+      root.replaceChildren(css);
+      return;
+    }
+    root.replaceChildren(css, document.importNode(doc.documentElement, true));
+  }, [svg]);
+
+  return <div ref={hostRef} role="img" aria-label={label} className={className} style={style} />;
+});
+
+MermaidSvg.displayName = 'MermaidSvg';
+
+export default MermaidSvg;
