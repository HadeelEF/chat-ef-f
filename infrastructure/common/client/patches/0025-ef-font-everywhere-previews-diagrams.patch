+/**
+ * A downloaded SVG (or the PNG drawn from it) cannot reach the app's fonts, so the export carries them as data URIs:
+ * Regular always, Bold only when the diagram sets bold text (each weight adds about 1.4 MB). On any failure the SVG is
+ * returned as it was, in Tahoma.
+ */
+export async function embedEfFontsInSvg(svg: string): Promise<string> {
