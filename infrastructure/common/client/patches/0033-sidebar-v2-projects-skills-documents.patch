@@ -0,0 +1,37 @@
+import { memo, useCallback } from 'react';
+import { useMediaQuery } from '@librechat/client';
+import ProjectsSection from '~/components/Conversations/ProjectsSection';
+import useSidebarToggle from '~/hooks/Nav/useSidebarToggle';
+import { useAuthContext } from '~/hooks';
+
+/**
+ * EF (#189, owner-approved sidebar): «المشاريع» is a row of the sidebar that opens this panel, in place of the
+ * Projects section above the chat history: new project, the projects with their chats, and «All projects» (the
+ * upstream /projects page). Choosing a project or a chat on a phone closes the drawer, as in the chat history.
+ */
+function EfProjectsPanel() {
+  const isSmallScreen = useMediaQuery('(max-width: 768px)');
+  const { isAuthenticated } = useAuthContext();
+  const { setSidebarOpen } = useSidebarToggle();
+
+  const toggleNav = useCallback(
+    (afterSlide?: () => void) => {
+      if (isSmallScreen) {
+        setSidebarOpen(false, afterSlide);
+        return;
+      }
+      afterSlide?.();
+    },
+    [isSmallScreen, setSidebarOpen],
+  );
+
+  return (
+    <div className="flex h-full min-h-0 flex-col overflow-hidden pb-3 pt-1">
+      <div className="scrollbar-gutter-stable min-h-0 flex-1 overflow-y-auto overflow-x-hidden px-1">
+        <ProjectsSection toggleNav={toggleNav} isAuthenticated={isAuthenticated} embedded={true} />
+      </div>
+    </div>
+  );
+}
+
+export default memo(EfProjectsPanel);
