diff --git a/client/src/components/EfPages/EfFilesPage.tsx b/client/src/components/EfPages/EfFilesPage.tsx
new file mode 100644
index 0000000..75a382d
--- /dev/null
+++ b/client/src/components/EfPages/EfFilesPage.tsx
@@ -0,0 +1,68 @@
+import { useCallback } from 'react';
+import { useRecoilValue } from 'recoil';
+import { useNavigate } from 'react-router-dom';
+import { Constants } from 'librechat-data-provider';
+import type { TFile } from 'librechat-data-provider';
+import { SidebarChatProvider } from '~/components/UnifiedSidebar/UnifiedSidebar';
+import { columns } from '~/components/SidePanel/Files/PanelColumns';
+import DataTable from '~/components/SidePanel/Files/PanelTable';
+import {
+  getFilesDraft,
+  getNewConversationDraftId,
+  isFilesDraftOwnedByThisTab,
+  setFilesDraft,
+} from '~/utils';
+import { useGetFiles } from '~/data-provider';
+import { useChatContext } from '~/Providers';
+import EfSectionPage from './EfSectionPage';
+import { useLocalize } from '~/hooks';
+import store from '~/store';
+
+/** EF (sidebar v3 #198): the employee's documents as a page. Choosing one attaches it to the open chat, as upstream's
+ *  files panel does, and goes back to that chat; «Manage files» opens the full table (sort, filter, delete). */
+export default function EfFilesPage() {
+  const localize = useLocalize();
+  return (
+    <EfSectionPage title={localize('com_efaiw_documents')} hint={localize('com_efaiw_files_hint')}>
+      <SidebarChatProvider>
+        <FilesTable />
+      </SidebarChatProvider>
+    </EfSectionPage>
+  );
+}
+
+function FilesTable() {
+  const navigate = useNavigate();
+  const { conversation } = useChatContext();
+  const { data: files = [] } = useGetFiles<TFile[]>();
+  const saveDrafts = useRecoilValue(store.saveDrafts);
+  const conversationId = conversation?.conversationId ?? Constants.NEW_CONVO;
+  const projectId = conversation?.chatProjectId;
+
+  const backToChat = useCallback(
+    (fileId: string) => {
+      /** The message box clears its attachments when it mounts and restores those of its draft (useAutoSave), so
+       *  the chosen file joins that draft before the chat opens again. */
+      if (saveDrafts) {
+        const draftId =
+          conversationId === Constants.NEW_CONVO ? getNewConversationDraftId(0) : conversationId;
+        const draft = getFilesDraft(draftId);
+        if (isFilesDraftOwnedByThisTab(draft) && !draft.fileIds.includes(fileId)) {
+          setFilesDraft(draftId, { ...draft, fileIds: [...draft.fileIds, fileId] });
+        }
+      }
+      const query =
+        conversationId === Constants.NEW_CONVO && projectId
+          ? `?projectId=${encodeURIComponent(projectId)}`
+          : '';
+      navigate(`/c/${conversationId}${query}`);
+    },
+    [navigate, conversationId, projectId, saveDrafts],
+  );
+
+  return (
+    <div className="mx-auto w-full max-w-3xl px-4 py-5 md:px-6">
+      <DataTable columns={columns} data={files} onAttached={backToChat} />
+    </div>
+  );
+}
