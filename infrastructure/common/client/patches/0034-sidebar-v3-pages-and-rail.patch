+import { useParams } from 'react-router-dom';
+import { NotebookPen } from 'lucide-react';
+import { EmptyState } from '@librechat/client';
+import { PermissionTypes } from 'librechat-data-provider';
+import InlinePromptsView from '~/components/Prompts/layouts/InlinePromptsView';
+import { SidebarChatProvider } from '~/components/UnifiedSidebar/UnifiedSidebar';
+import { PromptsAccordion } from '~/components/Prompts';
+import EfSectionPage from './EfSectionPage';
+import { useLocalize } from '~/hooks';
+
+/** EF (sidebar v3 #198): ready commands (prompts) as a page, their list (filter, auto-send, the commands) beside
+ *  upstream's prompt view. They are used with «/» in the message box, which the page says. */
+export default function EfPromptsPage() {
+  const localize = useLocalize();
+  const { promptId } = useParams();
+  return (
+    <EfSectionPage
+      title={localize('com_efaiw_rail_prompts')}
+      hint={localize('com_efaiw_prompts_hint')}
+      permissionType={PermissionTypes.PROMPTS}
+      list={
+        /* The list's items can also send a command into a chat, so they read the chat helpers. */
+        <SidebarChatProvider>
+          <PromptsAccordion />
+        </SidebarChatProvider>
+      }
+      detailOpen={promptId != null}
+      backTo="/prompts"
+    >
+      {promptId != null ? (
+        <InlinePromptsView />
+      ) : (
+        <div className="flex flex-1 items-center justify-center p-6">
+          <EmptyState
+            icon={NotebookPen}
+            title={localize('com_efaiw_prompts_none')}
+            description={localize('com_efaiw_prompts_hint')}
+            className="w-full max-w-md"
+          />
+        </div>
+      )}
+    </EfSectionPage>
+  );
+}
