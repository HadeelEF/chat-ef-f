new file mode 100644
index 0000000..fb56dc9
--- /dev/null
+++ b/client/src/components/EfPages/EfSectionPage.tsx
@@ -0,0 +1,113 @@
+import { useId } from 'react';
+import { ChevronLeft } from 'lucide-react';
+import { Link, Navigate } from 'react-router-dom';
+import { Spinner, useMediaQuery } from '@librechat/client';
+import type { ReactNode } from 'react';
+import type { PermissionTypes } from 'librechat-data-provider';
+import { Permissions } from 'librechat-data-provider';
+import OpenSidebar from '~/components/Chat/Menus/OpenSidebar';
+import { useAuthContext, useHasAccess, useLocalize } from '~/hooks';
+import { cn } from '~/utils';
+
+/**
+ * EF (sidebar v3 #198, owner-approved): the frame of a section opened from the sidebar as a page in the main area, on
+ * the pattern of upstream's Projects page: a header with the title (and the menu button on phones), an optional line
+ * of help, then the section. A section with a list and a detail (skills, ready commands) shows both side by side from
+ * tablet width and one at a time on phones, where the header leads back to the list.
+ */
+export default function EfSectionPage({
+  title,
+  hint,
+  permissionType,
+  list,
+  detailOpen = false,
+  backTo,
+  children,
+}: {
+  title: string;
+  hint?: string;
+  /** Without USE permission the page sends the employee to a new chat, as upstream's own pages do. */
+  permissionType?: PermissionTypes;
+  list?: ReactNode;
+  /** Phones show the detail instead of the list while it is open. */
+  detailOpen?: boolean;
+  backTo?: string;
+  children?: ReactNode;
+}) {
+  const localize = useLocalize();
+  const titleId = useId();
+  const isSmallScreen = useMediaQuery('(max-width: 768px)');
+  const { user, roles } = useAuthContext();
+  const rolesLoaded = user?.role != null && roles?.[user.role] != null;
+  const hasAccess = useHasAccess({
+    permissionType: permissionType ?? ('' as PermissionTypes),
+    permission: Permissions.USE,
+  });
+
+  if (permissionType != null && !rolesLoaded) {
+    return (
+      <div className="flex h-full w-full items-center justify-center bg-presentation">
+        <Spinner className="text-text-secondary" aria-label={localize('com_ui_loading')} />
+      </div>
+    );
+  }
+  if (permissionType != null && !hasAccess) {
+    return <Navigate to="/c/new" replace />;
+  }
+
+  const split = list != null;
+  return (
+    <main
+      aria-labelledby={titleId}
+      className="efaiw-page flex h-full min-h-0 w-full flex-col overflow-hidden bg-presentation text-text-primary"
+    >
+      <header className="efaiw-page-head shrink-0 border-b border-border-light bg-presentation">
+        <div className="flex h-14 w-full items-center gap-2.5 px-4 md:h-16 md:px-6">
+          {isSmallScreen ? <OpenSidebar className="size-9 shrink-0" /> : null}
+          {isSmallScreen && split && detailOpen && backTo ? (
+            <Link
+              to={backTo}
+              aria-label={localize('com_ui_back')}
+              className="flex size-9 shrink-0 items-center justify-center rounded-lg text-text-secondary hover:bg-surface-hover"
+            >
+              <ChevronLeft className="h-5 w-5 rtl:rotate-180" aria-hidden="true" />
+            </Link>
+          ) : null}
+          <h1
+            id={titleId}
+            className="min-w-0 truncate text-lg font-semibold tracking-tight text-text-primary md:text-xl"
+          >
+            {title}
+          </h1>
+        </div>
+        {hint ? (
+          <p className="efaiw-page-hint -mt-1 px-4 pb-3 text-sm text-text-secondary md:-mt-2 md:px-6">
+            {hint}
+          </p>
+        ) : null}
+      </header>
+      {split ? (
+        <div className="flex min-h-0 flex-1">
+          <div
+            className={cn(
+              'efaiw-page-list min-h-0 w-full flex-col border-border-light md:flex md:w-80 md:shrink-0 md:border-e',
+              detailOpen ? 'hidden' : 'flex',
+            )}
+          >
+            {list}
+          </div>
+          <div
+            className={cn(
+              'min-h-0 min-w-0 flex-1 flex-col overflow-y-auto',
+              detailOpen ? 'flex' : 'hidden md:flex',
+            )}
+          >
+            {children}
+          </div>
+        </div>
+      ) : (
+        <div className="min-h-0 flex-1 overflow-y-auto">{children}</div>
+      )}
+    </main>
+  );
+}
