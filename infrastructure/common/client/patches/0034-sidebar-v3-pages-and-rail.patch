@@ -0,0 +1,94 @@
+import { useEffect, useRef } from 'react';
+import type { NavLink } from '~/common';
+import type { TranslationKeys } from '~/hooks';
+import { useActivePanel, DEFAULT_PANEL } from '~/Providers';
+
+/** EF (sidebar v3 #198, owner-approved): the sections that open as a page in the main area instead of a panel in the
+ *  sidebar, each with its route. The sidebar keeps the chat history; the chat-bound tools (the agent builder, the
+ *  parameters) stay panels. */
+export const EF_PAGES: Record<string, string> = {
+  projects: '/projects',
+  skills: '/skills',
+  files: '/files',
+  prompts: '/prompts',
+  memories: '/memories',
+  bookmarks: '/bookmarks',
+};
+
+/** The page section the route belongs to, so its row reads as the open one. */
+export function efPageIdOf(pathname: string): string | undefined {
+  return Object.keys(EF_PAGES).find(
+    (id) => pathname === EF_PAGES[id] || pathname.startsWith(`${EF_PAGES[id]}/`),
+  );
+}
+
+/** The names shown in the column, the rail and «More». The builder keeps its full name so it is not confused with
+ *  «المساعدون», which opens the marketplace. Files are presented as the employee's documents. */
+export const EF_LINK_LABELS: Record<string, TranslationKeys> = {
+  conversations: 'com_efaiw_rail_chats',
+  projects: 'com_ui_projects',
+  skills: 'com_efaiw_rail_skills',
+  files: 'com_efaiw_documents',
+  memories: 'com_efaiw_rail_memories',
+  bookmarks: 'com_efaiw_rail_bookmarks',
+  prompts: 'com_efaiw_rail_prompts',
+  agents: 'com_sidepanel_agent_builder',
+  parameters: 'com_efaiw_rail_parameters',
+};
+
+/** The column's main rows, each with its tint from the palette (brand.css). */
+export const EF_MAIN_PANELS: ReadonlyArray<{ id: string; tone: string }> = [
+  { id: 'projects', tone: 'efaiw-tone-blue' },
+  { id: 'skills', tone: 'efaiw-tone-green' },
+  { id: 'files', tone: 'efaiw-tone-brown' },
+];
+/** «More» lists these first, then any other section the deployment enables; the admin-only ones come last. */
+export const EF_MORE_FIRST = ['memories', 'bookmarks', 'prompts'];
+export const EF_ADMIN_PANELS = ['agents', 'parameters'];
+
+/** «More»'s entries for everyone, in order. The agent builder and the parameters only reach `links` for admins
+ *  (useUnifiedSidebarLinks). */
+export function efMoreLinks(links: NavLink[]): NavLink[] {
+  const mainIds = EF_MAIN_PANELS.map((panel) => panel.id);
+  return [
+    ...EF_MORE_FIRST.map((id) => links.find((link) => link.id === id)),
+    ...links.filter(
+      (link) =>
+        link.id !== DEFAULT_PANEL &&
+        !mainIds.includes(link.id) &&
+        !EF_MORE_FIRST.includes(link.id) &&
+        !EF_ADMIN_PANELS.includes(link.id),
+    ),
+  ].filter((link): link is NavLink => link != null);
+}
+
+export function efAdminLinks(links: NavLink[]): NavLink[] {
+  return EF_ADMIN_PANELS.map((id) => links.find((link) => link.id === id)).filter(
+    (link): link is NavLink => link != null,
+  );
+}
+
+/** Keeps the chats in the sidebar: a section that became a page (v2 kept them as panels) may still be the remembered
+ *  panel, and opening a page by a shortcut or a link puts a chat-bound tool away, as the rows do. A tool opened while
+ *  a page is shown stays (the rail opens it as it expands the column). */
+export function useEfPanelGuard(links: NavLink[], pageId: string | undefined) {
+  const { active, setActive } = useActivePanel();
+  const activeRef = useRef(active);
+  activeRef.current = active;
+  const shownPage = useRef(pageId);
+  const stale = links.some((link) => link.id === active && !link.Component);
+  useEffect(() => {
+    if (stale) {
+      setActive(DEFAULT_PANEL);
+    }
+  }, [stale, setActive]);
+  useEffect(() => {
+    if (pageId === shownPage.current) {
+      return;
+    }
+    shownPage.current = pageId;
+    if (pageId != null && activeRef.current !== DEFAULT_PANEL) {
+      setActive(DEFAULT_PANEL);
+    }
+  }, [pageId, setActive]);
+}
