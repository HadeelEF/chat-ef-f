@@ -0,0 +1,469 @@
+/**
+ * EF (#135): a reply saved as a Word document, built in the browser from its Markdown (no server round trip, no new
+ * dependency). Markdown is parsed with the client's own GFM parser; the document is plain WordprocessingML in a
+ * stored (uncompressed) ZIP. Paragraphs written in Arabic run right to left; code, URLs and English paragraphs left
+ * to right. Covered: headings, paragraphs, bold/italic/strike, inline code, links, ordered and bulleted lists (nested),
+ * tables, code blocks, quotes, rules. Images become their alt text.
+ */
+import { gfm } from 'micromark-extension-gfm';
+import { gfmFromMarkdown } from 'mdast-util-gfm';
+import { fromMarkdown } from 'mdast-util-from-markdown';
+
+type Node = {
+  type: string;
+  value?: string;
+  depth?: number;
+  ordered?: boolean | null;
+  start?: number | null;
+  url?: string;
+  alt?: string | null;
+  lang?: string | null;
+  align?: Array<string | null>;
+  children?: Node[];
+};
+
+type RunStyle = { bold?: boolean; italic?: boolean; strike?: boolean; code?: boolean; link?: boolean };
+
+const ARABIC = /[؀-ۿݐ-ݿࢠ-ࣿﭐ-﷿ﹰ-﻿]/;
+const LATIN = /[A-Za-z]/;
+
+/** Direction of a text from its first strong character (Arabic: right to left). */
+export const isRtlText = (text: string): boolean => {
+  for (const ch of text) {
+    if (ARABIC.test(ch)) {
+      return true;
+    }
+    if (LATIN.test(ch)) {
+      return false;
+    }
+  }
+  return false;
+};
+
+const xmlEscape = (text: string): string =>
+  text
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    // Characters XML 1.0 does not allow.
+    // eslint-disable-next-line no-control-regex
+    .replace(/[\u0000-\u0008\u000B\u000C\u000E-\u001F]/g, '');
+
+const plainText = (node: Node): string =>
+  node.value ?? (node.children ?? []).map(plainText).join('') ?? '';
+
+const TEXT_ARTIFACT = /type="(?:text\/markdown|text\/md|text\/plain)"/;
+
+/**
+ * LibreChat's artifact directive lines are dropped; the artifact's content stays in the document. A text or Markdown
+ * artifact comes wrapped in a code fence (LibreChat's artifact instructions): that fence is dropped too, so the
+ * document reads as the document, not as code. Code, HTML and diagrams keep theirs.
+ */
+export const stripArtifactDirectives = (markdown: string): string => {
+  const out: string[] = [];
+  let unwrapNext = false;
+  let closingFence: string | null = null;
+  for (const line of markdown.split('\n')) {
+    const directive = line.match(/^\s*:::artifact\{.*\}\s*$/);
+    if (directive) {
+      unwrapNext = TEXT_ARTIFACT.test(line);
+      continue;
+    }
+    if (/^\s*:::\s*$/.test(line)) {
+      unwrapNext = false;
+      closingFence = null;
+      continue;
+    }
+    const fence = line.match(/^\s*(`{3,})[\w-]*\s*$/);
+    if (unwrapNext && fence && closingFence == null) {
+      closingFence = fence[1];
+      unwrapNext = false;
+      continue;
+    }
+    if (closingFence != null && line.trim() === closingFence) {
+      closingFence = null;
+      continue;
+    }
+    if (line.trim() !== '') {
+      unwrapNext = false;
+    }
+    out.push(line);
+  }
+  return out.join('\n');
+};
+
+class DocxWriter {
+  private links: string[] = [];
+  private numbering: Array<{ abstract: 0 | 1; start: number }> = [];
+
+  body(nodes: Node[]): string {
+    return nodes.map((node) => this.block(node, 0, null)).join('');
+  }
+
+  private linkId(url: string): string {
+    this.links.push(url);
+    return `rIdLink${this.links.length}`;
+  }
+
+  /** A new list instance (numbering restarts), `abstract` 0 = bullets, 1 = decimal. */
+  private listInstance(ordered: boolean, start: number): number {
+    this.numbering.push({ abstract: ordered ? 1 : 0, start });
+    return this.numbering.length;
+  }
+
+  private runs(nodes: Node[], style: RunStyle, rtl: boolean): string {
+    return nodes.map((node) => this.inline(node, style, rtl)).join('');
+  }
+
+  private run(text: string, style: RunStyle, rtl: boolean): string {
+    if (text === '') {
+      return '';
+    }
+    const props = [
+      style.code
+        ? '<w:rFonts w:ascii="Consolas" w:hAnsi="Consolas" w:cs="Consolas"/>'
+        : '',
+      style.bold ? '<w:b/><w:bCs/>' : '',
+      style.italic ? '<w:i/><w:iCs/>' : '',
+      style.strike ? '<w:strike/>' : '',
+      style.link ? '<w:color w:val="1F5FAD"/><w:u w:val="single"/>' : '',
+      style.code ? '<w:shd w:val="clear" w:color="auto" w:fill="F2F2F2"/>' : '',
+      rtl && ARABIC.test(text) ? '<w:rtl/>' : '',
+    ].join('');
+    const parts = text.split('\n');
+    return parts
+      .map(
+        (part, i) =>
+          `<w:r>${props ? `<w:rPr>${props}</w:rPr>` : ''}${i > 0 ? '<w:br/>' : ''}<w:t xml:space="preserve">${xmlEscape(part)}</w:t></w:r>`,
+      )
+      .join('');
+  }
+
+  private inline(node: Node, style: RunStyle, rtl: boolean): string {
+    switch (node.type) {
+      case 'text':
+        return this.run(node.value ?? '', style, rtl);
+      case 'strong':
+        return this.runs(node.children ?? [], { ...style, bold: true }, rtl);
+      case 'emphasis':
+        return this.runs(node.children ?? [], { ...style, italic: true }, rtl);
+      case 'delete':
+        return this.runs(node.children ?? [], { ...style, strike: true }, rtl);
+      case 'inlineCode':
+        return this.run(node.value ?? '', { ...style, code: true }, rtl);
+      case 'break':
+        return '<w:r><w:br/></w:r>';
+      case 'link': {
+        const url = node.url ?? '';
+        if (!/^(https?:|mailto:)/i.test(url)) {
