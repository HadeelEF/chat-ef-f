+        return node.children ? this.runs(node.children, style, rtl) : this.run(node.value ?? '', style, rtl);
+    }
+  }
+
+  private paragraph(
+    content: string,
+    rtl: boolean,
+    { style, numId, level, indent, extra }: { style?: string; numId?: number; level?: number; indent?: number; extra?: string } = {},
+  ): string {
+    const props = [
+      style ? `<w:pStyle w:val="${style}"/>` : '',
