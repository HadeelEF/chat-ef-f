+  }
+
+  private block(node: Node, level: number, list: { numId: number } | null): string {
+    switch (node.type) {
+      case 'heading': {
+        const rtl = isRtlText(plainText(node));
+        const depth = Math.min(Math.max(node.depth ?? 1, 1), 4);
