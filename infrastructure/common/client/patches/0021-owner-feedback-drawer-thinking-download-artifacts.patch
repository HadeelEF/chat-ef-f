diff --git a/client/src/components/Chat/Input/ThinkingToggle.tsx b/client/src/components/Chat/Input/ThinkingToggle.tsx
new file mode 100644
index 0000000..8fe7bc4
--- /dev/null
+++ b/client/src/components/Chat/Input/ThinkingToggle.tsx
@@ -0,0 +1,106 @@
+import { memo, useMemo } from 'react';
+import { useRecoilValue } from 'recoil';
+import { Lightbulb } from 'lucide-react';
+import { composerControlClasses } from '@librechat/client';
+import type { TStartupConfig } from 'librechat-data-provider';
+import { useGetConversation, useLocalize, useNewConvo } from '~/hooks';
+import useSelectMention from '~/hooks/Input/useSelectMention';
+import { useAssistantsMapContext } from '~/Providers';
+import { useGetEndpointsQuery } from '~/data-provider';
+import { badgeAccents } from './accents';
+import { cn } from '~/utils';
+import store from '~/store';
+
+/**
+ * EF (#135): the «تفكير» switch next to the model button. The approved lineup (librechat.yaml, #131) sets thinking
+ * per spec: Lite and Plus are the same model without and with thinking, so the switch moves the chat between them in
+ * place, like picking the other one in the model menu (the model button follows). Pro always thinks: the switch shows
+ * on and cannot be turned off. Any other spec, and an upstream configuration, shows no switch.
+ */
+const THINKING_PAIRS: ReadonlyArray<{ off: string; on: string }> = [
+  { off: 'baseer-lite', on: 'baseer-plus' },
+];
+const ALWAYS_THINKS = new Set(['baseer-pro']);
+/** A chat saved without a spec name still carries its spec's endpoint. */
+const SPEC_BY_ENDPOINT: Record<string, string> = {
+  Qwen: 'baseer-lite',
+  'Qwen Thinking': 'baseer-plus',
+  DeepSeek: 'baseer-pro',
+};
+
+function ThinkingToggle({
+  startupConfig,
+  disabled = false,
+}: {
+  startupConfig?: TStartupConfig;
+  disabled?: boolean;
+}) {
+  const localize = useLocalize();
+  const spec = useRecoilValue(store.conversationSpecByIndex(0));
+  const endpoint = useRecoilValue(store.conversationEndpointByIndex(0));
+  const getConversation = useGetConversation(0);
+  const { newConversation } = useNewConvo();
+  const assistantsMap = useAssistantsMapContext();
+  const { data: endpointsConfig } = useGetEndpointsQuery();
+  const modelSpecs = useMemo(() => startupConfig?.modelSpecs?.list ?? [], [startupConfig]);
+  const { onSelectSpec } = useSelectMention({
+    modelSpecs,
+    assistantsMap,
+    endpointsConfig,
+    getConversation,
+    newConversation,
+    returnHandlers: true,
+  });
+
+  const current = spec || (endpoint != null ? SPEC_BY_ENDPOINT[endpoint] : undefined);
+  const state = useMemo(() => {
+    if (current == null) {
+      return null;
+    }
+    if (ALWAYS_THINKS.has(current)) {
+      return { on: true, locked: true, target: undefined };
+    }
+    const pair = THINKING_PAIRS.find((p) => p.off === current || p.on === current);
+    if (pair == null) {
+      return null;
+    }
+    const on = pair.on === current;
+    const target = modelSpecs.find((s) => s.name === (on ? pair.off : pair.on));
+    return target == null ? null : { on, locked: false, target };
+  }, [current, modelSpecs]);
+
+  if (state == null) {
+    return null;
+  }
+
+  const hint = state.locked
+    ? localize('com_efaiw_thinking_always')
+    : localize(state.on ? 'com_efaiw_thinking_on' : 'com_efaiw_thinking_off');
+
+  return (
+    <button
+      type="button"
+      aria-pressed={state.on}
+      aria-disabled={state.locked || disabled || undefined}
+      title={hint}
+      onClick={() => {
+        if (state.locked || disabled || state.target == null) {
+          return;
+        }
+        onSelectSpec?.(state.target);
+      }}
+      className={cn(
+        composerControlClasses(),
+        'px-theme-normal',
+        state.on && badgeAccents.purple,
+        (state.locked || disabled) && 'cursor-default opacity-80 hover:shadow-sm',
+      )}
+    >
+      <Lightbulb className="icon-md" aria-hidden="true" />
+      <span>{localize('com_efaiw_thinking')}</span>
+      <span className="sr-only">{hint}</span>
+    </button>
+  );
+}
+
+export default memo(ThinkingToggle);
