+            );
+            first = false;
+          } else if (child.type === 'list') {
+            out.push(this.block(child, Math.min(level + 1, 3), null));
+          } else {
+            out.push(this.block(child, level, null));
+          }
+        }
+        return out.join('');
+      }
+      case 'code': {
+        const lines = (node.value ?? '').split('\n');
