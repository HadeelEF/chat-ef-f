+        return `<w:hyperlink r:id="${this.linkId(url)}">${this.runs(node.children ?? [], { ...style, link: true }, rtl)}</w:hyperlink>`;
+      }
+      case 'image':
+        return this.run(node.alt ?? '', { ...style, italic: true }, rtl);
+      case 'inlineMath':
+      case 'html':
