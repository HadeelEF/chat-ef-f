+      }
+      case 'blockquote':
+        return (node.children ?? [])
+          .map((child) => {
+            if (child.type !== 'paragraph') {
+              return this.block(child, level, null);
+            }
+            const rtl = isRtlText(plainText(child));
+            return this.paragraph(this.runs(child.children ?? [], { italic: true }, rtl), rtl, { style: 'Quote' });
+          })
+          .join('');
+      case 'thematicBreak':
+        return this.paragraph('', false, {
+          extra: '<w:pBdr><w:bottom w:val="single" w:sz="6" w:space="1" w:color="BFBFBF"/></w:pBdr>',
+        });
+      case 'table':
+        return this.table(node);
+      case 'math':
+        return this.paragraph(this.run(node.value ?? '', { code: true }, false), false, { style: 'Code' });
+      case 'html':
+        return node.value ? this.paragraph(this.run(node.value, {}, false), isRtlText(node.value)) : '';
+      default:
+        return node.children ? node.children.map((child) => this.block(child, level, null)).join('') : '';
+    }
+  }
+
+  private table(node: Node): string {
+    const rows = node.children ?? [];
+    const rtl = isRtlText(plainText(node));
+    const columns = Math.max(1, ...rows.map((row) => row.children?.length ?? 0));
+    const width = Math.floor(9000 / columns);
+    const border = (side: string) => `<w:${side} w:val="single" w:sz="4" w:space="0" w:color="BFBFBF"/>`;
+    const tblPr = [
+      '<w:tblStyle w:val="TableGrid"/>',
+      rtl ? '<w:bidiVisual/>' : '',
+      '<w:tblW w:w="5000" w:type="pct"/>',
+      `<w:tblBorders>${['top', 'left', 'bottom', 'right', 'insideH', 'insideV'].map(border).join('')}</w:tblBorders>`,
+      '<w:tblCellMar><w:top w:w="60" w:type="dxa"/><w:left w:w="100" w:type="dxa"/><w:bottom w:w="60" w:type="dxa"/><w:right w:w="100" w:type="dxa"/></w:tblCellMar>',
+    ].join('');
+    const grid = `<w:tblGrid>${Array.from({ length: columns }, () => `<w:gridCol w:w="${width}"/>`).join('')}</w:tblGrid>`;
+    const body = rows
+      .map((row, r) => {
+        const cells = Array.from({ length: columns }, (_, c) => {
+          const cell = row.children?.[c];
+          const text = cell ? plainText(cell) : '';
+          const cellRtl = text.trim() === '' ? rtl : isRtlText(text);
+          const align = node.align?.[c];
+          // A right-to-left paragraph starts at the right on its own; only centring is written.
+          const jc = align === 'center' ? '<w:jc w:val="center"/>' : '';
+          const runs = cell ? this.runs(cell.children ?? [], r === 0 ? { bold: true } : {}, cellRtl) : '';
+          const p = `<w:p><w:pPr>${cellRtl ? '<w:bidi/>' : ''}${jc}<w:spacing w:after="0"/></w:pPr>${runs}</w:p>`;
+          const shade = r === 0 ? '<w:shd w:val="clear" w:color="auto" w:fill="EDF1F7"/>' : '';
+          return `<w:tc><w:tcPr><w:tcW w:w="${width}" w:type="dxa"/>${shade}</w:tcPr>${p}</w:tc>`;
+        }).join('');
+        const header = r === 0 ? '<w:trPr><w:tblHeader/></w:trPr>' : '';
+        return `<w:tr>${header}${cells}</w:tr>`;
+      })
+      .join('');
+    // An empty paragraph after the table keeps two adjacent tables apart.
+    return `<w:tbl><w:tblPr>${tblPr}</w:tblPr>${grid}${body}</w:tbl><w:p/>`;
+  }
+
+  relationships(): string {
+    const links = this.links
+      .map(
+        (url, i) =>
+          `<Relationship Id="rIdLink${i + 1}" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/hyperlink" Target="${xmlEscape(url)}" TargetMode="External"/>`,
+      )
+      .join('');
+    return `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
+<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rIdStyles" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/><Relationship Id="rIdNumbering" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/numbering" Target="numbering.xml"/>${links}</Relationships>`;
+  }
+
+  numberingXml(): string {
+    const level = (ilvl: number, ordered: boolean) => {
+      const bullets = ['•', '◦', '▪', '•'];
+      const formats = ['decimal', 'lowerLetter', 'lowerRoman', 'decimal'];
+      const indent = 720 * (ilvl + 1);
+      return `<w:lvl w:ilvl="${ilvl}"><w:start w:val="1"/><w:numFmt w:val="${ordered ? formats[ilvl] : 'bullet'}"/><w:lvlText w:val="${ordered ? `%${ilvl + 1}.` : bullets[ilvl]}"/><w:lvlJc w:val="left"/><w:pPr><w:ind w:start="${indent}" w:hanging="360"/></w:pPr></w:lvl>`;
+    };
+    const abstracts = [false, true]
+      .map(
+        (ordered, id) =>
+          `<w:abstractNum w:abstractNumId="${id}"><w:multiLevelType w:val="hybridMultilevel"/>${[0, 1, 2, 3].map((l) => level(l, ordered)).join('')}</w:abstractNum>`,
+      )
+      .join('');
+    const nums = this.numbering
+      .map(
+        ({ abstract, start }, i) =>
+          `<w:num w:numId="${i + 1}"><w:abstractNumId w:val="${abstract}"/>${abstract === 1 ? `<w:lvlOverride w:ilvl="0"><w:startOverride w:val="${start}"/></w:lvlOverride>` : ''}</w:num>`,
+      )
+      .join('');
+    return `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
+<w:numbering xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">${abstracts}${nums}</w:numbering>`;
+  }
+}
+
+const STYLES = `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
+<w:styles xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:docDefaults><w:rPrDefault><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:eastAsia="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="24"/><w:lang w:val="en-US" w:bidi="ar-SA"/></w:rPr></w:rPrDefault><w:pPrDefault><w:pPr><w:spacing w:after="120" w:line="300" w:lineRule="auto"/></w:pPr></w:pPrDefault></w:docDefaults><w:style w:type="paragraph" w:default="1" w:styleId="Normal"><w:name w:val="Normal"/></w:style><w:style w:type="paragraph" w:styleId="Title"><w:name w:val="Title"/><w:basedOn w:val="Normal"/><w:next w:val="Normal"/><w:pPr><w:spacing w:after="240"/></w:pPr><w:rPr><w:b/><w:bCs/><w:color w:val="1F3864"/><w:sz w:val="36"/><w:szCs w:val="40"/></w:rPr></w:style>${[1, 2, 3, 4]
