@@ -0,0 +1,100 @@
+import { memo, useId, useState } from 'react';
+import * as Ariakit from '@ariakit/react';
+import { Download, FileText, FileCode } from 'lucide-react';
+import { DropdownPopup, TooltipAnchor } from '@librechat/client';
+import { ContentTypes } from 'librechat-data-provider';
+import type { TMessage } from 'librechat-data-provider';
+import {
+  markdownToDocx,
+  safeFileName,
+  saveBlob,
+  stripArtifactDirectives,
+} from '~/utils/efaiwDocx';
+import { hoverButtonClasses } from './styles';
+import { useLocalize } from '~/hooks';
+
+/** The reply's own text, without its thinking or tool calls. */
+export const replyMarkdown = (message: TMessage): string => {
+  if (Array.isArray(message.content) && message.content.length > 0) {
+    return message.content
+      .map((part) => {
+        if (part == null || typeof part === 'string') {
+          return part ?? '';
+        }
+        if (part.type !== ContentTypes.TEXT) {
+          return '';
+        }
+        const text = (part as { text?: string | { value?: string } }).text;
+        return typeof text === 'string' ? text : (text?.value ?? '');
+      })
+      .filter((text) => text.trim() !== '')
+      .join('\n\n');
+  }
+  return message.text ?? '';
+};
+
+/**
+ * EF (#135): «تنزيل» on a reply: the reply as a Word document (.docx, right to left when written in Arabic) or as
+ * Markdown (.md). Built in the browser (utils/efaiwDocx.ts); the file is named after the chat.
+ */
+function DownloadReply({
+  message,
+  title,
+  isLast,
+}: {
+  message: TMessage;
+  title?: string | null;
+  isLast: boolean;
+}) {
+  const localize = useLocalize();
+  const menuId = useId();
+  const [isOpen, setIsOpen] = useState(false);
+  const label = localize('com_efaiw_download_reply');
+  const name = safeFileName(title, localize('com_efaiw_download_default_name'));
+
+  const items = [
+    {
+      label: localize('com_efaiw_download_word'),
+      icon: <FileText className="size-4 text-text-secondary" aria-hidden="true" />,
+      onClick: () => {
+        const markdown = replyMarkdown(message);
+        saveBlob(markdownToDocx(markdown, name), `${name}.docx`);
+      },
+    },
+    {
+      label: localize('com_efaiw_download_markdown'),
+      icon: <FileCode className="size-4 text-text-secondary" aria-hidden="true" />,
+      onClick: () => {
+        const markdown = stripArtifactDirectives(replyMarkdown(message));
+        saveBlob(new Blob([markdown], { type: 'text/markdown;charset=utf-8' }), `${name}.md`);
+      },
+    },
+  ];
+
+  return (
+    <DropdownPopup
+      portal={true}
+      menuId={menuId}
+      focusLoop={true}
+      unmountOnHide={true}
+      isOpen={isOpen}
+      setIsOpen={setIsOpen}
+      trigger={
+        <TooltipAnchor
+          description={label}
+          render={
+            <Ariakit.MenuButton
+              aria-label={label}
+              className={hoverButtonClasses({ isActive: isOpen, isLast })}
+            >
+              <Download size={19} aria-hidden="true" />
+            </Ariakit.MenuButton>
+          }
+        />
+      }
+      items={items}
+    />
+  );
+}
+
+export default memo(DownloadReply);
