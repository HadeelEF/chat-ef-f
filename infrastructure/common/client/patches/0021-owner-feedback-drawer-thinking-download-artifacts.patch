+  for (const c of all) {
+    out.set(c, at);
+    at += c.length;
+  }
+  return out;
+}
+
+export function markdownToDocx(markdown: string, title: string): Blob {
+  // `storedZip` allocates its own ArrayBuffer, so its whole buffer is the archive.
+  return new Blob([storedZip(buildDocxParts(markdown, title)).buffer as ArrayBuffer], {
+    type: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
+  });
+}
+
+/** A file name from a chat title: no path, reserved or Markdown characters, at most 80 characters. */
+export const safeFileName = (title: string | null | undefined, fallback: string): string => {
+  const cleaned = (title ?? '')
+    // eslint-disable-next-line no-control-regex
+    .replace(/[\\/:*?"<>|#`\u0000-\u001F]/g, ' ')
