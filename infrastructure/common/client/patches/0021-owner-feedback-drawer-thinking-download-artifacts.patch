+      }
+      case 'paragraph': {
+        const rtl = isRtlText(plainText(node));
+        return this.paragraph(this.runs(node.children ?? [], {}, rtl), rtl);
+      }
+      case 'list': {
+        const numId = this.listInstance(node.ordered === true, node.start ?? 1);
+        return (node.children ?? []).map((item) => this.block(item, level, { numId })).join('');
+      }
+      case 'listItem': {
+        const out: string[] = [];
+        let first = true;
+        for (const child of node.children ?? []) {
+          if (child.type === 'paragraph' && list != null) {
+            const rtl = isRtlText(plainText(child));
+            out.push(
+              this.paragraph(this.runs(child.children ?? [], {}, rtl), rtl, {
