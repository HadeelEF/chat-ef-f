+      y += h + GAP;
+    } else {
+      y += s.table(block, MARGIN_X, y) + GAP;
+    }
+  }
+  flushText();
+  const numberW = Math.round(0.8 * EMU);
+  s.textBox(
+    deckRtl ? MARGIN_X : SLIDE_W - MARGIN_X - numberW,
+    SLIDE_H - Math.round(0.6 * EMU),
+    numberW,
+    Math.round(0.4 * EMU),
+    `<a:p><a:pPr algn="${deckRtl ? 'l' : 'r'}"/>${s.run({ text: String(number) }, 12, EF.muted)}</a:p>`,
