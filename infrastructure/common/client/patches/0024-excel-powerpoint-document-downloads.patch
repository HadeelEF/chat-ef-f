@@ -0,0 +1,90 @@
+import { useMemo } from 'react';
+import { FileCode, FileSpreadsheet, FileText, Presentation, Printer } from 'lucide-react';
+import { useToastContext } from '@librechat/client';
+import { markdownToDocx, saveBlob, stripArtifactDirectives } from '~/utils/efaiwDocx';
+import { markdownToPptx } from '~/utils/efaiwPptx';
+import { markdownToXlsx } from '~/utils/efaiwXlsx';
+import { openPrintView } from '~/utils/efaiwPrint';
+import type { MenuItemProps } from '~/common';
+import { useLocalize } from '~/hooks';
+
+const iconClass = 'size-4 text-text-secondary';
+
+/**
+ * EF (#149): the download choices for a text — a reply (DownloadReply.tsx) or a Markdown document in the side panel
+ * (Artifacts/DownloadArtifact.tsx): Word, PowerPoint, Excel when the text has a table, PDF / print and Markdown. Each
+ * file is built in the browser in the Environment Fund identity (utils/efaiwDocx.ts, efaiwPptx.ts, efaiwXlsx.ts,
+ * efaiwPrint.ts) and named `name`. `onMarkdown` replaces the Markdown item's default save (the panel keeps its own:
+ * the original file, or the edited text).
+ */
+export default function useDocumentDownloads({
+  markdown,
+  name,
+  hasTable,
+  onMarkdown,
+}: {
+  markdown: () => string;
+  name: string;
+  hasTable: boolean;
+  onMarkdown?: MenuItemProps['onClick'];
+}): MenuItemProps[] {
+  const localize = useLocalize();
+  const { showToast } = useToastContext();
+
+  return useMemo(() => {
+    const items: MenuItemProps[] = [
+      {
+        label: localize('com_efaiw_download_word'),
+        icon: <FileText className={iconClass} aria-hidden="true" />,
+        onClick: () => saveBlob(markdownToDocx(markdown(), name), `${name}.docx`),
+      },
+      {
+        label: localize('com_efaiw_download_pptx'),
+        icon: <Presentation className={iconClass} aria-hidden="true" />,
+        onClick: () => saveBlob(markdownToPptx(markdown(), name), `${name}.pptx`),
+      },
+    ];
+    if (hasTable) {
+      items.push({
+        label: localize('com_efaiw_download_excel'),
+        icon: <FileSpreadsheet className={iconClass} aria-hidden="true" />,
+        onClick: () => {
+          const workbook = markdownToXlsx(markdown(), name);
+          if (workbook == null) {
+            showToast({ message: localize('com_efaiw_excel_no_table'), status: 'warning' });
+            return;
+          }
+          saveBlob(workbook, `${name}.xlsx`);
+        },
+      });
+    }
+    items.push(
+      {
+        label: localize('com_efaiw_download_pdf'),
+        icon: <Printer className={iconClass} aria-hidden="true" />,
+        onClick: () => {
+          const root = document.documentElement;
+          const opened = openPrintView(markdown(), name, {
+            print: localize('com_efaiw_print_save'),
+            dir: root.dir === 'rtl' ? 'rtl' : 'ltr',
+            lang: root.lang || 'ar',
+          });
+          if (!opened) {
+            showToast({ message: localize('com_efaiw_print_blocked'), status: 'warning' });
+          }
+        },
+      },
+      {
+        label: localize('com_efaiw_download_markdown'),
+        icon: <FileCode className={iconClass} aria-hidden="true" />,
+        onClick:
+          onMarkdown ??
+          (() => {
+            const text = stripArtifactDirectives(markdown());
+            saveBlob(new Blob([text], { type: 'text/markdown;charset=utf-8' }), `${name}.md`);
+          }),
+      },
+    );
+    return items;
+  }, [localize, showToast, markdown, name, hasTable, onMarkdown]);
+}
