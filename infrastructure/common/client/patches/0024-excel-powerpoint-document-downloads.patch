diff --git a/client/src/utils/efaiwPptx.ts b/client/src/utils/efaiwPptx.ts
new file mode 100644
index 0000000..c2ca1b0
--- /dev/null
+++ b/client/src/utils/efaiwPptx.ts
@@ -0,0 +1,791 @@
+/**
+ * EF (#149): a reply or document as a PowerPoint deck (16:9), built in the browser from its Markdown like the Word file
+ * (utils/efaiwDocx.ts): PresentationML in a stored ZIP, no new dependency.
+ * - Structure: the first `#` heading is the title slide (the paragraph under it, its subtitle); every `##` starts a
+ *   slide (every `#` when there is no `##`), and `---` ends one. Deeper headings, paragraphs, lists, quotes, code and
+ *   tables fill the slide; what does not fit continues on the next slide under the same title, and a long table repeats
+ *   its header row.
+ * - Environment Fund identity (visual identity guide v01, p22-31 and p93: 16:9, title, content and closing slides in
+ *   the palette): an EF-blue title slide with white title and a green subtitle, white content slides with primary-blue
+ *   titles over a green accent, primary-dark text and primary-blue table headers. The palette is the deck's theme, so
+ *   PowerPoint offers it for new shapes. Tahoma (the guide's secondary typeface), as in Word: the presenter's computer is
+ *   not guaranteed to have Aktiv Grotesk. No logo: the letterhead waits for the owner's decision (#145).
+ * - Titles are real title placeholders (slide outline, accessibility checker, navigation). Arabic slides, paragraphs and
+ *   tables run right to left; English and code left to right.
+ */
+import { gfm } from 'micromark-extension-gfm';
+import { gfmFromMarkdown } from 'mdast-util-gfm';
+import { fromMarkdown } from 'mdast-util-from-markdown';
+import { EF_DOC, isRtlText, storedZip, stripArtifactDirectives, xmlEscape } from './efaiwDocx';
+
+type Node = {
+  type: string;
+  value?: string;
+  depth?: number;
+  ordered?: boolean | null;
+  start?: number | null;
+  url?: string;
+  alt?: string | null;
+  align?: Array<string | null>;
+  children?: Node[];
+};
+
+type Inline = { text: string; bold?: boolean; italic?: boolean; code?: boolean; link?: string };
+type Para = {
+  kind: 'para';
+  runs: Inline[];
+  /** null: no letters (numbers, symbols), so the slide's direction applies. */
+  rtl: boolean | null;
+  style: 'body' | 'bullet' | 'number' | 'sub' | 'quote';
+  level: number;
+  number?: number;
+};
+type Table = { kind: 'table'; rows: Inline[][][]; align: Array<string | null>; rtl: boolean };
+type Code = { kind: 'code'; text: string };
+type Block = Para | Table | Code;
+type Slide = { title: string; blocks: Block[] };
+
+/** Environment Fund palette for the deck (hex without #), from the guide (p22-24). */
+const EF = {
+  dark: EF_DOC.text,
+  blue: EF_DOC.heading,
+  blue2: EF_DOC.link,
+  green: 'C0CB6C',
+  brown: 'A18E77',
+  warm: 'F1EEE8',
+  tint: EF_DOC.tint,
+  line: EF_DOC.line,
+  muted: '646A71',
+  white: 'FFFFFF',
+} as const;
+
+const EMU = 914400;
+const PT = 12700;
+const SLIDE_W = 12192000;
+const SLIDE_H = 6858000;
+const MARGIN_X = Math.round(0.65 * EMU);
+const CONTENT_W = SLIDE_W - 2 * MARGIN_X;
+const TITLE_Y = Math.round(0.42 * EMU);
+const TITLE_H = Math.round(0.95 * EMU);
+const ACCENT_Y = TITLE_Y + TITLE_H + Math.round(0.06 * EMU);
+const BODY_Y = ACCENT_Y + Math.round(0.28 * EMU);
+const BODY_BOTTOM = SLIDE_H - Math.round(0.75 * EMU);
+/** Room planned for content, kept below the box so an estimate that runs short still fits. */
+const BODY_CAPACITY = Math.round((BODY_BOTTOM - BODY_Y) * 0.92);
+
+const BODY_PT = 20;
+const TABLE_PT = 14;
+const CODE_PT = 14;
+
+const NS =
+  'xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"';
+const ARABIC = /[\u0600-\u06FF\u0750-\u077F\u08A0-\u08FF\uFB50-\uFDFF\uFE70-\uFEFF]/;
+const LETTER = /[A-Za-z\u0600-\u06FF\u0750-\u077F\u08A0-\u08FF\uFB50-\uFDFF\uFE70-\uFEFF]/;
+/** Direction from the first letter, or null for text without letters (a number lines up with its column). */
+const directionOf = (text: string): boolean | null => (LETTER.test(text) ? isRtlText(text) : null);
+
+// ----------------------------------------------------------------------------------------------------- Markdown
+const inlines = (nodes: Node[] = [], style: Omit<Inline, 'text'> = {}): Inline[] =>
+  nodes.flatMap((node): Inline[] => {
+    switch (node.type) {
+      case 'text':
+        return [{ ...style, text: node.value ?? '' }];
+      case 'strong':
+        return inlines(node.children, { ...style, bold: true });
+      case 'emphasis':
+        return inlines(node.children, { ...style, italic: true });
+      case 'inlineCode':
+        return [{ ...style, code: true, text: node.value ?? '' }];
+      case 'link': {
+        const url = node.url ?? '';
+        return inlines(
+          node.children,
+          /^(https?:|mailto:)/i.test(url) ? { ...style, link: url } : style,
+        );
+      }
+      case 'break':
+        return [{ ...style, text: ' ' }];
+      case 'image':
+        return node.alt ? [{ ...style, italic: true, text: node.alt }] : [];
+      default:
+        if (node.children) {
+          return inlines(node.children, style);
+        }
+        return node.value ? [{ ...style, text: node.value }] : [];
+    }
+  });
+
+const textOf = (runs: Inline[]): string => runs.map((r) => r.text).join('');
+const plain = (node: Node): string => textOf(inlines([node]));
+
+const para = (runs: Inline[], style: Para['style'], level = 0, number?: number): Para => ({
+  kind: 'para',
+  runs,
+  rtl: directionOf(textOf(runs)),
+  style,
+  level,
+  number,
+});
+
+function listBlocks(node: Node, level: number): Block[] {
+  const out: Block[] = [];
+  let n = node.start ?? 1;
+  for (const item of node.children ?? []) {
+    let first = true;
+    for (const child of item.children ?? []) {
+      if (child.type === 'list') {
+        out.push(...listBlocks(child, Math.min(level + 1, 4)));
+      } else if (first) {
+        out.push(
+          para(inlines(child.children ?? [child]), node.ordered ? 'number' : 'bullet', level, n),
+        );
+        first = false;
+      } else {
+        out.push(para(inlines(child.children ?? [child]), 'body', level + 1));
+      }
+    }
+    n += 1;
+  }
+  return out;
+}
+
+const tableBlock = (node: Node): Table => {
+  const rows = (node.children ?? []).map((row) =>
+    (row.children ?? []).map((cell) => inlines(cell.children)),
+  );
+  const columns = Math.max(1, ...rows.map((row) => row.length));
+  const filled = rows.map((row) => [
+    ...row,
+    ...Array.from({ length: columns - row.length }, () => []),
+  ]);
+  return {
+    kind: 'table',
+    rows: filled,
+    align: node.align ?? [],
+    rtl: isRtlText(
+      filled
+        .flat(2)
+        .map((r) => r.text)
+        .join(' '),
+    ),
+  };
+};
+
+/** The deck: its title, subtitle and slides (before pagination). */
+export function markdownToSlides(markdown: string, fallbackTitle: string) {
+  const tree = fromMarkdown(stripArtifactDirectives(markdown), {
+    extensions: [gfm()],
+    mdastExtensions: [gfmFromMarkdown()],
+  }) as unknown as Node;
+  let nodes = (tree.children ?? []).filter((n) => n.type !== 'html' && n.type !== 'definition');
+  /* A reply's lead-in before the document's first `#` ("here is the deck") is chat, not a slide. */
+  const firstHeading = nodes.findIndex((n) => n.type === 'heading');
+  if (
+    firstHeading > 0 &&
+    nodes[firstHeading].depth === 1 &&
+    nodes.slice(0, firstHeading).every((n) => n.type === 'paragraph')
+  ) {
+    nodes = nodes.slice(firstHeading);
+  }
+  const depths = nodes.filter((n) => n.type === 'heading').map((n) => n.depth ?? 1);
+  let i = 0;
+  let title = fallbackTitle;
+  let subtitle = '';
+  if (nodes[0]?.type === 'heading' && nodes[0].depth === 1) {
+    title = plain(nodes[0]).trim() || fallbackTitle;
+    i = 1;
+  }
+  const h1After = depths.filter((d) => d === 1).length - (i === 1 ? 1 : 0);
+  let splitDepth = h1After > 0 ? 1 : 0;
+  if (depths.includes(2)) {
+    splitDepth = 2;
+  }
+  if (splitDepth > 0 && nodes[i]?.type === 'paragraph') {
+    subtitle = plain(nodes[i]).trim();
+    i += 1;
+  }
+
+  const slides: Slide[] = [];
+  let current: Slide | null = null;
+  const open = (slideTitle: string) => {
+    current = { title: slideTitle, blocks: [] };
+    slides.push(current);
+  };
+  const add = (block: Block) => {
+    if (!current) {
+      open(title);
+    }
+    (current as unknown as Slide).blocks.push(block);
+  };
+  for (; i < nodes.length; i++) {
+    const node = nodes[i];
+    switch (node.type) {
+      case 'heading':
+        if ((node.depth ?? 1) <= splitDepth) {
+          open(plain(node).trim() || title);
+        } else {
+          add(para(inlines(node.children), 'sub'));
+        }
+        break;
+      case 'thematicBreak': {
+        const next = nodes[i + 1];
+        if (next && next.type !== 'heading') {
+          open((current as Slide | null)?.title ?? title);
+        } else {
+          current = null;
+        }
+        break;
+      }
+      case 'paragraph':
+        add(para(inlines(node.children), 'body'));
+        break;
+      case 'list':
+        listBlocks(node, 0).forEach(add);
+        break;
+      case 'blockquote':
+        for (const child of node.children ?? []) {
+          add(para(inlines(child.children ?? [child]), 'quote'));
+        }
+        break;
+      case 'table':
+        add(tableBlock(node));
+        break;
+      case 'code':
+      case 'math':
+        add({ kind: 'code', text: node.value ?? '' });
+        break;
+      default:
+        if (node.children) {
+          add(para(inlines(node.children), 'body'));
+        }
+    }
+  }
+  return {
+    title,
+    subtitle,
+    rtl: isRtlText(markdown),
+    slides: slides.filter((s) => s.blocks.length > 0),
+  };
+}
+
+// ----------------------------------------------------------------------------------------------------- layout
+const lineHeight = (pt: number) => Math.round(pt * 1.22 * PT);
+/** Characters on one line of `width` EMU at `pt` points (an average glyph is about half an em). */
+const charsPerLine = (width: number, pt: number) =>
+  Math.max(8, Math.floor(width / PT / (pt * 0.52)));
+const linesOf = (text: string, width: number, pt: number) =>
+  Math.max(
+    1,
+    text
+      .split('\n')
+      .reduce(
+        (sum, line) => sum + Math.max(1, Math.ceil(line.length / charsPerLine(width, pt))),
+        0,
+      ),
+  );
+
+const PARA_GAP = Math.round(6 * PT);
+const indentOf = (p: Para) =>
+  (p.style === 'bullet' || p.style === 'number' ? 342900 : 0) + p.level * 342900;
+const paraPt = (p: Para) => (p.style === 'sub' ? BODY_PT + 2 : BODY_PT);
+const paraHeight = (p: Para) =>
+  linesOf(textOf(p.runs), CONTENT_W - indentOf(p) - 182880, paraPt(p)) * lineHeight(paraPt(p)) +
+  PARA_GAP;
+
+const TABLE_PAD = Math.round(0.12 * EMU);
+const rowHeight = (row: Inline[][], columns: number) => {
+  const width = CONTENT_W / columns - 182880;
+  const lines = Math.max(1, ...row.map((cell) => linesOf(textOf(cell), width, TABLE_PT)));
+  return Math.max(Math.round(0.4 * EMU), lines * lineHeight(TABLE_PT) + TABLE_PAD);
+};
+const codeHeight = (c: Code) =>
+  linesOf(c.text, CONTENT_W - 182880, CODE_PT) * lineHeight(CODE_PT) + TABLE_PAD + PARA_GAP;
+const GAP = Math.round(0.15 * EMU);
+
+/** Pages of one slide: blocks that fit the body, a long table split with its header repeated. */
+function paginate(slide: Slide): Block[][] {
+  const pages: Block[][] = [[]];
+  let used = 0;
+  const page = () => pages[pages.length - 1];
+  const fresh = () => {
+    if (page().length > 0) {
+      pages.push([]);
+      used = 0;
+    }
+  };
+  for (const block of slide.blocks) {
+    if (block.kind === 'para') {
+      const h = paraHeight(block);
+      if (used + h > BODY_CAPACITY) {
+        fresh();
+      }
+      page().push(block);
+      used += h;
+    } else if (block.kind === 'code') {
+      const h = codeHeight(block) + GAP;
+      if (used + h > BODY_CAPACITY) {
+        fresh();
+      }
+      page().push(block);
+      used += h;
+    } else {
+      const columns = block.rows[0]?.length ?? 1;
+      const [header, ...body] = block.rows;
+      const headerH = header ? rowHeight(header, columns) : 0;
+      let rows: Inline[][][] = [];
+      let rowsH = 0;
+      const flush = () => {
+        if (rows.length > 0) {
+          page().push({ ...block, rows: header ? [header, ...rows] : rows });
+          used += headerH + rowsH + GAP;
+          rows = [];
+          rowsH = 0;
+        }
+      };
+      if (used + headerH + (body[0] ? rowHeight(body[0], columns) : 0) > BODY_CAPACITY) {
+        fresh();
+      }
+      for (const row of body) {
+        const h = rowHeight(row, columns);
+        if (used + headerH + rowsH + h > BODY_CAPACITY && rows.length > 0) {
+          flush();
+          fresh();
+        }
+        rows.push(row);
+        rowsH += h;
+      }
+      if (body.length === 0 && header) {
+        page().push(block);
+        used += headerH + GAP;
+      }
+      flush();
+    }
+  }
+  return pages.filter((p) => p.length > 0);
+}
+
+// ----------------------------------------------------------------------------------------------------- XML
+class SlideXml {
+  private shapes: string[] = [];
+  private nextId = 2;
+  links: string[] = [];
+
+  constructor(private readonly rtl: boolean) {}
+
+  private id(): number {
+    return this.nextId++;
+  }
+
+  private linkId(url: string): string {
+    this.links.push(url);
+    return `rId${this.links.length + 1}`;
+  }
+
+  run(
+    inline: Inline,
+    pt: number,
+    color: string,
+    extra: { bold?: boolean; italic?: boolean } = {},
+  ): string {
+    const text = inline.text;
+    if (text === '') {
+      return '';
+    }
+    const lang = ARABIC.test(text) ? ' lang="ar-SA" altLang="en-US"' : ' lang="en-US"';
+    const bold = inline.bold || extra.bold ? ' b="1"' : '';
+    const italic = inline.italic || extra.italic ? ' i="1"' : '';
+    const fill = `<a:solidFill><a:srgbClr val="${inline.link ? EF.blue2 : color}"/></a:solidFill>`;
+    const font = inline.code
+      ? '<a:latin typeface="Consolas"/><a:cs typeface="Consolas"/>'
+      : `<a:latin typeface="${EF_DOC.font}"/><a:cs typeface="${EF_DOC.font}"/>`;
+    const link = inline.link ? `<a:hlinkClick r:id="${this.linkId(inline.link)}"/>` : '';
+    const underline = inline.link ? ' u="sng"' : '';
+    return `<a:r><a:rPr${lang} sz="${pt * 100}"${bold}${italic}${underline} dirty="0">${fill}${font}${link}</a:rPr><a:t>${xmlEscape(text)}</a:t></a:r>`;
+  }
+
+  paragraph(p: Para, color = EF.dark): string {
+    const pt = paraPt(p);
+    const dir = p.rtl ?? this.rtl;
+    const algn = dir ? 'r' : 'l';
+    const rtl = dir ? ' rtl="1"' : '';
+    const spacing = `<a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="600"/></a:spcAft>`;
+    let bullet = '<a:buNone/>';
+    let mar = p.level * 342900;
+    let indent = 0;
+    if (p.style === 'bullet' || p.style === 'number') {
+      mar += 342900;
+      indent = -342900;
+      bullet =
+        `<a:buClr><a:srgbClr val="${EF.blue}"/></a:buClr><a:buSzPct val="100000"/>` +
+        (p.style === 'number'
+          ? `<a:buFont typeface="+mj-lt"/><a:buAutoNum type="arabicPeriod" startAt="${p.number ?? 1}"/>`
+          : `<a:buFont typeface="Arial"/><a:buChar char="${p.level % 2 === 0 ? '•' : '–'}"/>`);
+    }
+    const quote = p.style === 'quote';
+    const sub = p.style === 'sub';
+    let runColor = quote ? '373F48' : color;
+    if (sub) {
+      runColor = EF.blue;
+    }
+    const runs = p.runs
+      .map((r) => this.run(r, pt, runColor, { bold: sub, italic: quote }))
+      .join('');
+    return `<a:p><a:pPr marL="${mar}" indent="${indent}" algn="${algn}"${rtl}>${spacing}${bullet}</a:pPr>${runs || `<a:endParaRPr lang="en-US" sz="${pt * 100}" dirty="0"/>`}</a:p>`;
+  }
+
+  /** A title placeholder of the layout, positioned and styled here so the slide does not depend on the master. */
+  placeholder(
+    ph: string,
+    name: string,
+    x: number,
+    y: number,
+    w: number,
+    h: number,
+    text: string,
+    pt: number,
+    color: string,
+    anchor: 't' | 'b' | 'ctr',
+    bold: boolean,
+  ): void {
+    const strong = directionOf(text);
+    const rtl = strong === true;
+    const right = strong ?? this.rtl;
+    const runs = this.run({ text }, pt, color, { bold });
+    this.shapes.push(
+      `<p:sp><p:nvSpPr><p:cNvPr id="${this.id()}" name="${name}"/><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr>${ph}</p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="${x}" y="${y}"/><a:ext cx="${w}" cy="${h}"/></a:xfrm></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="91440" tIns="45720" rIns="91440" bIns="45720" anchor="${anchor}"><a:normAutofit/></a:bodyPr><a:lstStyle/><a:p><a:pPr algn="${right ? 'r' : 'l'}"${rtl ? ' rtl="1"' : ''}/>${runs}</a:p></p:txBody></p:sp>`,
+    );
+  }
+
+  rect(x: number, y: number, w: number, h: number, color: string, name: string): void {
+    this.shapes.push(
+      `<p:sp><p:nvSpPr><p:cNvPr id="${this.id()}" name="${name}"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="${x}" y="${y}"/><a:ext cx="${w}" cy="${h}"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:solidFill><a:srgbClr val="${color}"/></a:solidFill><a:ln><a:noFill/></a:ln></p:spPr></p:sp>`,
+    );
+  }
+
+  textBox(
+    x: number,
+    y: number,
+    w: number,
+    h: number,
+    paragraphs: string,
+    name: string,
+    fill?: string,
+  ): void {
+    const background = fill
+      ? `<a:solidFill><a:srgbClr val="${fill}"/></a:solidFill>`
+      : '<a:noFill/>';
+    this.shapes.push(
+      `<p:sp><p:nvSpPr><p:cNvPr id="${this.id()}" name="${name}"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="${x}" y="${y}"/><a:ext cx="${w}" cy="${h}"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom>${background}</p:spPr><p:txBody><a:bodyPr wrap="square" lIns="91440" tIns="45720" rIns="91440" bIns="45720" anchor="t"><a:normAutofit/></a:bodyPr><a:lstStyle/>${paragraphs}</p:txBody></p:sp>`,
+    );
+  }
+
+  table(t: Table, x: number, y: number): number {
+    const columns = t.rows[0]?.length ?? 1;
+    const colW = Math.floor(CONTENT_W / columns);
+    const border = (side: string) =>
+      `<a:${side} w="12700" cap="flat" cmpd="sng" algn="ctr"><a:solidFill><a:srgbClr val="${EF.line}"/></a:solidFill><a:prstDash val="solid"/></a:${side}>`;
+    let height = 0;
+    const rowsXml = t.rows
+      .map((row, r) => {
+        const h = rowHeight(row, columns);
+        height += h;
+        const cells = row
+          .map((cell, c) => {
+            /* A number keeps left-to-right order (-3% stays -3%) and lines up with its column's side. */
+            const strong = directionOf(textOf(cell));
+            const rtl = strong === true;
+            const side = (strong ?? t.rtl) ? 'r' : 'l';
+            const align = t.align[c] === 'center' ? 'ctr' : side;
+            const header = r === 0;
+            const runs = cell
+              .map((inline) =>
+                this.run(inline, TABLE_PT, header ? EF.white : EF.dark, { bold: header }),
+              )
+              .join('');
+            const band = r % 2 === 0 ? EF.tint : EF.white;
+            const fill = header ? EF.blue : band;
+            return `<a:tc><a:txBody><a:bodyPr/><a:lstStyle/><a:p><a:pPr algn="${align}"${rtl ? ' rtl="1"' : ''}/>${runs || `<a:endParaRPr lang="en-US" sz="${TABLE_PT * 100}" dirty="0"/>`}</a:p></a:txBody><a:tcPr marL="91440" marR="91440" marT="45720" marB="45720" anchor="ctr">${border('lnL')}${border('lnR')}${border('lnT')}${border('lnB')}<a:solidFill><a:srgbClr val="${fill}"/></a:solidFill></a:tcPr></a:tc>`;
+          })
+          .join('');
+        return `<a:tr h="${h}">${cells}</a:tr>`;
+      })
+      .join('');
+    const grid = Array.from({ length: columns }, () => `<a:gridCol w="${colW}"/>`).join('');
+    this.shapes.push(
+      `<p:graphicFrame><p:nvGraphicFramePr><p:cNvPr id="${this.id()}" name="Table ${this.nextId}"/><p:cNvGraphicFramePr><a:graphicFrameLocks noGrp="1"/></p:cNvGraphicFramePr><p:nvPr/></p:nvGraphicFramePr><p:xfrm><a:off x="${x}" y="${y}"/><a:ext cx="${colW * columns}" cy="${height}"/></p:xfrm><a:graphic><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/table"><a:tbl><a:tblPr firstRow="1" bandRow="1"${t.rtl ? ' rtl="1"' : ''}/><a:tblGrid>${grid}</a:tblGrid>${rowsXml}</a:tbl></a:graphicData></a:graphic></p:graphicFrame>`,
+    );
+    return height;
+  }
+
+  xml(background?: string): string {
+    const bg = background
+      ? `<p:bg><p:bgPr><a:solidFill><a:srgbClr val="${background}"/></a:solidFill><a:effectLst/></p:bgPr></p:bg>`
+      : '';
+    return `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
+<p:sld ${NS}><p:cSld>${bg}<p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr>${this.shapes.join('')}</p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>`;
+  }
+
+  rels(layout: number): string {
+    const links = this.links
+      .map(
+        (url, i) =>
+          `<Relationship Id="rId${i + 2}" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/hyperlink" Target="${xmlEscape(url)}" TargetMode="External"/>`,
+      )
+      .join('');
+    return `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
+<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/slideLayout" Target="../slideLayouts/slideLayout${layout}.xml"/>${links}</Relationships>`;
+  }
+}
+
+function titleSlide(title: string, subtitle: string, rtl: boolean): SlideXml {
+  const s = new SlideXml(rtl);
+  const titlePt = title.length > 60 ? 32 : 40;
+  s.placeholder(
+    '<p:ph type="ctrTitle"/>',
+    'Title 1',
+    MARGIN_X,
+    Math.round(2.0 * EMU),
+    CONTENT_W,
+    Math.round(1.9 * EMU),
+    title,
+    titlePt,
+    EF.white,
+    'b',
+    true,
+  );
+  const barW = Math.round(1.6 * EMU);
+  s.rect(
+    rtl ? SLIDE_W - MARGIN_X - barW : MARGIN_X,
+    Math.round(4.05 * EMU),
+    barW,
+    Math.round(0.07 * EMU),
+    EF.green,
+    'Accent 2',
+  );
+  if (subtitle) {
+    s.placeholder(
+      '<p:ph type="subTitle" idx="1"/>',
+      'Subtitle 3',
+      MARGIN_X,
+      Math.round(4.3 * EMU),
+      CONTENT_W,
+      Math.round(1.2 * EMU),
+      subtitle,
+      20,
+      EF.green,
+      't',
+      false,
+    );
+  }
+  return s;
+}
+
+function contentSlide(title: string, blocks: Block[], number: number, deckRtl: boolean): SlideXml {
+  const s = new SlideXml(deckRtl);
+  const titleRtl = directionOf(title) ?? deckRtl;
+  s.placeholder(
+    '<p:ph type="title"/>',
+    'Title 1',
+    MARGIN_X,
+    TITLE_Y,
+    CONTENT_W,
+    TITLE_H,
+    title,
+    title.length > 55 ? 24 : 28,
+    EF.blue,
+    'b',
+    true,
+  );
+  const barW = Math.round(1.2 * EMU);
+  s.rect(
+    titleRtl ? SLIDE_W - MARGIN_X - barW : MARGIN_X,
+    ACCENT_Y,
+    barW,
+    Math.round(0.06 * EMU),
+    EF.green,
+    'Accent 2',
+  );
+  let y = BODY_Y;
+  let pending: Para[] = [];
+  const flushText = () => {
+    if (pending.length === 0) {
+      return;
+    }
+    const h = Math.min(
+      BODY_BOTTOM - y,
+      pending.reduce((sum, p) => sum + paraHeight(p), 0) + Math.round(0.1 * EMU),
+    );
+    s.textBox(
+      MARGIN_X,
+      y,
+      CONTENT_W,
+      h,
+      pending.map((p) => s.paragraph(p)).join(''),
+      `Content ${y}`,
+    );
+    y += h;
+    pending = [];
+  };
+  for (const block of blocks) {
+    if (block.kind === 'para') {
+      pending.push(block);
+      continue;
+    }
+    flushText();
+    if (block.kind === 'code') {
+      const h = Math.min(BODY_BOTTOM - y, codeHeight(block) - PARA_GAP);
+      const lines = block.text
+        .split('\n')
+        .map(
+          (line) =>
+            `<a:p><a:pPr algn="l"/>${s.run({ text: line || ' ', code: true }, CODE_PT, EF.dark)}</a:p>`,
+        )
