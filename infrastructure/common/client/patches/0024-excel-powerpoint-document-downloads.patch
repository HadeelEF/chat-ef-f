+/**
+ * EF (#149): the tables of a reply or document as an Excel workbook, built in the browser from its Markdown like the
+ * Word file (utils/efaiwDocx.ts): SpreadsheetML in a stored ZIP, no new dependency. One sheet per table, named after
+ * the heading above it. A cell that is a number (Western, Arabic-Indic or Persian digits, thousands separators, a
+ * percentage, a unit or currency before or after it) is stored as a number and shown with its unit, so the sheet can be
+ * summed and sorted; dates, codes and phone numbers stay text. Header row in the Environment Fund palette (visual
+ * identity guide v01: the lightest primary-blue shade, primary dark text, neutral borders), frozen, with a filter;
+ * columns sized to their text; Arabic sheets run right to left. Tahoma, the guide's secondary typeface, as in Word.
+ */
+import { gfm } from 'micromark-extension-gfm';
+import { gfmFromMarkdown } from 'mdast-util-gfm';
+import { fromMarkdown } from 'mdast-util-from-markdown';
+import { EF_DOC, isRtlText, storedZip, stripArtifactDirectives, xmlEscape } from './efaiwDocx';
+
+type Node = {
+  type: string;
+  value?: string;
+  depth?: number;
+  alt?: string | null;
+  children?: Node[];
+};
+
+export type SheetTable = { name: string; rows: string[][]; rtl: boolean };
+
+const plain = (node: Node): string => {
+  if (node.type === 'image') {
+    return node.alt ?? '';
+  }
+  if (node.type === 'break') {
+    return ' ';
+  }
+  return node.value ?? (node.children ?? []).map(plain).join('');
+};
+
+/** Excel forbids these in sheet names, and a name of more than 31 characters. */
+const sheetName = (text: string, index: number, rtl: boolean, used: Set<string>): string => {
+  const base =
+    text
+      .replace(/[[\]:*?/\\]/g, ' ')
+      .replace(/\s+/g, ' ')
+      .trim()
+      .replace(/^'+|'+$/g, '')
+      .slice(0, 31)
+      .trim() || (rtl ? `جدول ${index}` : `Table ${index}`);
+  let name = base;
+  for (let n = 2; used.has(name.toLowerCase()); n++) {
+    const suffix = ` (${n})`;
+    name = base.slice(0, 31 - suffix.length) + suffix;
+  }
+  used.add(name.toLowerCase());
+  return name;
+};
+
+/** Every GFM table of the Markdown, with the text of the nearest heading above it. */
+export function markdownTables(markdown: string): SheetTable[] {
+  const tree = fromMarkdown(stripArtifactDirectives(markdown), {
+    extensions: [gfm()],
+    mdastExtensions: [gfmFromMarkdown()],
+  }) as unknown as Node;
+  const tables: SheetTable[] = [];
+  const used = new Set<string>();
+  let heading = '';
+  const walk = (nodes: Node[] = []) => {
+    for (const node of nodes) {
+      if (node.type === 'heading') {
+        heading = plain(node).trim();
+      } else if (node.type === 'table') {
+        const rows = (node.children ?? []).map((row) =>
+          (row.children ?? []).map((cell) => plain(cell).trim()),
+        );
+        const columns = Math.max(0, ...rows.map((row) => row.length));
+        if (rows.length === 0 || columns === 0) {
+          continue;
+        }
+        const filled = rows.map((row) => [...row, ...Array(columns - row.length).fill('')]);
+        const rtl = isRtlText(`${heading} ${filled.flat().join(' ')}`);
+        tables.push({ name: sheetName(heading, tables.length + 1, rtl, used), rows: filled, rtl });
+      } else if (node.children && node.type !== 'paragraph') {
+        walk(node.children);
+      }
+    }
+  };
+  walk(tree.children);
+  return tables;
+}
+
+/** A cheap check for a GFM table (its delimiter row), for menus drawn on every reply; markdownTables is exact. */
+export const hasMarkdownTable = (markdown: string): boolean =>
+  /^\s*\|?\s*:?-+:?\s*(\|\s*:?-+:?\s*)+\|?\s*$/m.test(markdown);
+
+const DIGITS: Record<string, string> = {};
+'٠١٢٣٤٥٦٧٨٩'.split('').forEach((d, i) => (DIGITS[d] = String(i)));
+'۰۱۲۳۴۵۶۷۸۹'.split('').forEach((d, i) => (DIGITS[d] = String(i)));
+
+type NumberCell = { value: number; format: string };
+
+/** A unit or currency written next to a number: letters and symbols, no digits, short. */
+const UNIT = /^[^\d\s\u0660-\u0669\u06F0-\u06F9][^\d\u0660-\u0669\u06F0-\u06F9]{0,11}$/;
+
+/**
+ * The cell as a number with its display format, or null when it must stay text: a date, a code with a leading zero
+ * (a phone or account number), more than 15 significant digits (Excel would round it), or other text.
+ */
+export function parseNumberCell(text: string): NumberCell | null {
+  let t = text
+    .trim()
+    .replace(/[\u0660-\u0669\u06F0-\u06F9]/g, (d) => DIGITS[d])
+    .replace(/[\u066C\u060C]/g, ',')
+    .replace(/\u066B/g, '.')
+    .replace(/[\u00A0\u202F\u2009]/g, ' ')
+    .replace(/\u2212/g, '-');
+  if (t === '') {
+    return null;
+  }
+  let negative = false;
+  const paren = t.match(/^\((.*)\)$/);
+  if (paren) {
+    negative = true;
+    t = paren[1].trim();
+  }
+  /* An accounting negative, (5), keeps its parentheses. */
+  const signed = (format: string): string => (paren ? `${format};(${format})` : format);
+  const sign = t.match(/^([-+])\s*/);
+  if (sign) {
+    negative = negative !== (sign[1] === '-');
+    t = t.slice(sign[0].length);
+  }
+  const m = t.match(
+    /^(?:([^\d\s][^\d]{0,11}?)(\s*))?(\d{1,3}(?:,\d{3})+|\d+)(?:\.(\d+))?(\s*)(%|[^\d\s][^\d]{0,11})?$/,
+  );
+  if (!m) {
+    return null;
+  }
+  const [, prefixRaw, prefixGap, intPart, fraction, suffixGap, suffixRaw] = m;
+  const prefix = prefixRaw?.trim() ?? '';
+  const suffix = suffixRaw?.trim() ?? '';
+  if ((prefix && !UNIT.test(prefix)) || (suffix && suffix !== '%' && !UNIT.test(suffix))) {
+    return null;
+  }
+  if (prefix && suffix) {
+    return null;
+  }
+  const grouping = intPart.includes(',');
+  const digits = intPart.replace(/,/g, '');
+  const leadingZero = digits.length > 1 && digits.startsWith('0') && !grouping;
+  if (leadingZero || digits.length + (fraction?.length ?? 0) > 15) {
+    return null;
+  }
+  let value = Number(`${digits}${fraction ? `.${fraction}` : ''}`);
+  if (!Number.isFinite(value)) {
+    return null;
+  }
+  if (negative) {
+    value = -value;
+  }
+  /* The number keeps how it was written: grouped only when the author grouped it (a year stays 2026). */
+  const decimals = fraction ? Math.min(fraction.length, 4) : 0;
+  const places = decimals > 0 ? `.${'0'.repeat(decimals)}` : '';
+  const base = `${grouping ? '#,##0' : '0'}${places}`;
+  if (suffix === '%') {
+    return { value: value / 100, format: signed(`0${places}%`) };
+  }
+  const quote = (unit: string) => `"${unit.replace(/"/g, '')}"`;
+  if (prefix) {
+    return { value, format: signed(`${quote(`${prefix}${prefixGap ? ' ' : ''}`)}${base}`) };
+  }
+  if (suffix) {
+    return { value, format: signed(`${base}${quote(`${suffixGap ? ' ' : ''}${suffix}`)}`) };
+  }
+  return { value, format: signed(base) };
+}
+
+/** Built-in number formats; anything else gets a custom id from 164 on. */
+const BUILTIN_FORMATS: Record<string, number> = {
+  '0': 1,
+  '0.00': 2,
+  '#,##0': 3,
+  '#,##0.00': 4,
+  '0%': 9,
+  '0.00%': 10,
+};
+
+const columnName = (index: number): string => {
+  let name = '';
+  for (let n = index + 1; n > 0; n = Math.floor((n - 1) / 26)) {
+    name = String.fromCharCode(65 + ((n - 1) % 26)) + name;
+  }
+  return name;
+};
+
+/** A column width (Excel's unit: about one digit) fitting the longest cell, within 8 and 60. */
+const columnWidth = (cells: string[]): number => {
+  const longest = Math.max(0, ...cells.map((cell) => cell.length));
+  return Math.min(60, Math.max(8, Math.ceil(longest * 1.15) + 2));
+};
+
+const quoteSheet = (name: string): string => `'${name.replace(/'/g, "''")}'`;
+
+export function buildXlsxParts(tables: SheetTable[], title: string): Record<string, string> {
+  const formats = new Map<string, number>();
+  const formatId = (code: string): number => {
+    if (BUILTIN_FORMATS[code] != null) {
+      return BUILTIN_FORMATS[code];
+    }
+    if (!formats.has(code)) {
+      formats.set(code, 164 + formats.size);
+    }
+    return formats.get(code) as number;
+  };
+  /** cellXfs: 0 default, 1 header, 2 body text; then one body style per number format. */
+  const numberStyles = new Map<number, number>();
+  const styleFor = (code: string): number => {
+    const id = formatId(code);
+    if (!numberStyles.has(id)) {
+      numberStyles.set(id, 3 + numberStyles.size);
+    }
+    return numberStyles.get(id) as number;
+  };
+
+  const sheets = tables.map((table, sheetIndex) => {
+    const columns = table.rows[0].length;
+    const last = `${columnName(columns - 1)}${table.rows.length}`;
+    const rowsXml = table.rows
+      .map((row, r) => {
+        const cells = row
+          .map((text, c) => {
+            const ref = `${columnName(c)}${r + 1}`;
+            if (text === '') {
+              return r === 0 ? `<c r="${ref}" s="1"/>` : `<c r="${ref}" s="2"/>`;
+            }
+            const number = r === 0 ? null : parseNumberCell(text);
+            if (number) {
+              return `<c r="${ref}" s="${styleFor(number.format)}"><v>${number.value}</v></c>`;
+            }
+            return `<c r="${ref}" s="${r === 0 ? 1 : 2}" t="inlineStr"><is><t xml:space="preserve">${xmlEscape(text)}</t></is></c>`;
+          })
+          .join('');
+        return `<row r="${r + 1}">${cells}</row>`;
+      })
+      .join('');
+    const cols = Array.from(
+      { length: columns },
+      (_, c) =>
+        `<col min="${c + 1}" max="${c + 1}" width="${columnWidth(table.rows.map((row) => row[c]))}" customWidth="1"/>`,
+    ).join('');
+    const pane =
+      table.rows.length > 1
+        ? '<pane ySplit="1" topLeftCell="A2" activePane="bottomLeft" state="frozen"/><selection pane="bottomLeft" activeCell="A2" sqref="A2"/>'
+        : '';
+    return `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
+<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><dimension ref="A1:${last}"/><sheetViews><sheetView workbookViewId="0"${table.rtl ? ' rightToLeft="1"' : ''}${sheetIndex === 0 ? ' tabSelected="1"' : ''}>${pane}</sheetView></sheetViews><sheetFormatPr defaultRowHeight="18"/><cols>${cols}</cols><sheetData>${rowsXml}</sheetData><autoFilter ref="A1:${last}"/><pageMargins left="0.7" right="0.7" top="0.75" bottom="0.75" header="0.3" footer="0.3"/><pageSetup orientation="landscape" paperSize="9"/></worksheet>`;
+  });
+
+  const border = `<border><left style="thin"><color rgb="FF${EF_DOC.line}"/></left><right style="thin"><color rgb="FF${EF_DOC.line}"/></right><top style="thin"><color rgb="FF${EF_DOC.line}"/></top><bottom style="thin"><color rgb="FF${EF_DOC.line}"/></bottom><diagonal/></border>`;
+  const numFmts = [...formats.entries()]
+    .map(([code, id]) => `<numFmt numFmtId="${id}" formatCode="${xmlEscape(code)}"/>`)
+    .join('');
+  const numberXfs = [...numberStyles.keys()]
+    .map(
+      (id) =>
+        `<xf numFmtId="${id}" fontId="0" fillId="0" borderId="1" xfId="0" applyNumberFormat="1" applyBorder="1" applyAlignment="1"><alignment vertical="top"/></xf>`,
+    )
+    .join('');
+  const styles = `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
+<styleSheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">${numFmts ? `<numFmts count="${formats.size}">${numFmts}</numFmts>` : ''}<fonts count="2"><font><sz val="11"/><color rgb="FF${EF_DOC.text}"/><name val="${EF_DOC.font}"/><family val="2"/></font><font><b/><sz val="11"/><color rgb="FF${EF_DOC.text}"/><name val="${EF_DOC.font}"/><family val="2"/></font></fonts><fills count="3"><fill><patternFill patternType="none"/></fill><fill><patternFill patternType="gray125"/></fill><fill><patternFill patternType="solid"><fgColor rgb="FF${EF_DOC.tint}"/><bgColor indexed="64"/></patternFill></fill></fills><borders count="2"><border><left/><right/><top/><bottom/><diagonal/></border>${border}</borders><cellStyleXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0"/></cellStyleXfs><cellXfs count="${3 + numberStyles.size}"><xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0"/><xf numFmtId="0" fontId="1" fillId="2" borderId="1" xfId="0" applyFont="1" applyFill="1" applyBorder="1" applyAlignment="1"><alignment horizontal="center" vertical="center" wrapText="1"/></xf><xf numFmtId="0" fontId="0" fillId="0" borderId="1" xfId="0" applyBorder="1" applyAlignment="1"><alignment vertical="top" wrapText="1"/></xf>${numberXfs}</cellXfs><cellStyles count="1"><cellStyle name="Normal" xfId="0" builtinId="0"/></cellStyles><dxfs count="0"/><tableStyles count="0" defaultTableStyle="TableStyleMedium2" defaultPivotStyle="PivotStyleLight16"/></styleSheet>`;
+
+  const filters = tables
+    .map((table, i) => {
+      const last = `$${columnName(table.rows[0].length - 1)}$${table.rows.length}`;
+      return `<definedName name="_xlnm._FilterDatabase" localSheetId="${i}" hidden="1">${xmlEscape(quoteSheet(table.name))}!$A$1:${last}</definedName>`;
+    })
+    .join('');
+  const now = new Date().toISOString().replace(/\.\d{3}Z$/, 'Z');
+  const parts: Record<string, string> = {
+    '[Content_Types].xml': `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
+<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/><Override PartName="/xl/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml"/>${tables
+      .map(
+        (_, i) =>
+          `<Override PartName="/xl/worksheets/sheet${i + 1}.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>`,
+      )
+      .join(
+        '',
+      )}<Override PartName="/docProps/core.xml" ContentType="application/vnd.openxmlformats-package.core-properties+xml"/><Override PartName="/docProps/app.xml" ContentType="application/vnd.openxmlformats-officedocument.extended-properties+xml"/></Types>`,
+    '_rels/.rels': `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
+<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/><Relationship Id="rId2" Type="http://schemas.openxmlformats.org/package/2006/relationships/metadata/core-properties" Target="docProps/core.xml"/><Relationship Id="rId3" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/extended-properties" Target="docProps/app.xml"/></Relationships>`,
+    'docProps/core.xml': `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
+<cp:coreProperties xmlns:cp="http://schemas.openxmlformats.org/package/2006/metadata/core-properties" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><dc:title>${xmlEscape(title)}</dc:title><dc:creator>بصير</dc:creator><dcterms:created xsi:type="dcterms:W3CDTF">${now}</dcterms:created></cp:coreProperties>`,
+    'docProps/app.xml': `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
+<Properties xmlns="http://schemas.openxmlformats.org/officeDocument/2006/extended-properties"><Application>Baseer</Application></Properties>`,
+    'xl/workbook.xml': `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
+<workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><bookViews><workbookView activeTab="0"/></bookViews><sheets>${tables
+      .map(
+        (table, i) =>
+          `<sheet name="${xmlEscape(table.name)}" sheetId="${i + 1}" r:id="rId${i + 1}"/>`,
+      )
+      .join('')}</sheets><definedNames>${filters}</definedNames></workbook>`,
+    'xl/_rels/workbook.xml.rels': `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
+<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">${tables
+      .map(
+        (_, i) =>
+          `<Relationship Id="rId${i + 1}" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet${i + 1}.xml"/>`,
+      )
+      .join(
+        '',
+      )}<Relationship Id="rId${tables.length + 1}" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/></Relationships>`,
+    'xl/styles.xml': styles,
+  };
+  sheets.forEach((xml, i) => {
+    parts[`xl/worksheets/sheet${i + 1}.xml`] = xml;
+  });
+  return parts;
+}
+
+/** The workbook of the Markdown's tables, or null when it has none. */
+export function markdownToXlsx(markdown: string, title: string): Blob | null {
+  const tables = markdownTables(markdown);
+  if (tables.length === 0) {
+    return null;
+  }
+  return new Blob([storedZip(buildXlsxParts(tables, title)).buffer as ArrayBuffer], {
+    type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
+  });
+}
