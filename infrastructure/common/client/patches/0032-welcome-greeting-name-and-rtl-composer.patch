@@ -0,0 +1,52 @@
+import { dayPart, firstName, msUntilNextDayPart } from '../efGreeting';
+
+const at = (hours: number, minutes = 0) => new Date(2026, 9, 24, hours, minutes, 0, 0);
+
+describe('firstName', () => {
+  it('takes the first word of the account name', () => {
+    expect(firstName('نورة القحطاني')).toBe('نورة');
+    expect(firstName('  Faisal   Synthetic ')).toBe('Faisal');
+  });
+
+  it('keeps compound first names whole', () => {
+    expect(firstName('عبد الله الشهري')).toBe('عبد الله');
+    expect(firstName('أبو بكر المالكي')).toBe('أبو بكر');
+    expect(firstName('Abdul Rahman Test')).toBe('Abdul Rahman');
+    expect(firstName('عبدالله الشهري')).toBe('عبدالله');
+  });
+
+  it('greets without a name when there is none or it is an email address', () => {
+    expect(firstName(undefined)).toBe('');
+    expect(firstName('   ')).toBe('');
+    expect(firstName('noura@example.invalid')).toBe('');
+  });
+
+  it('does not join a lone prefix to nothing', () => {
+    expect(firstName('عبد')).toBe('عبد');
+  });
+});
+
+describe('dayPart', () => {
+  it.each([
+    [3, 59, 'evening'],
+    [4, 0, 'morning'],
+    [11, 59, 'morning'],
+    [12, 0, 'afternoon'],
+    [16, 59, 'afternoon'],
+    [17, 0, 'evening'],
+    [23, 30, 'evening'],
+  ])('%i:%i is %s', (h, m, expected) => {
+    expect(dayPart(at(h, m))).toBe(expected);
+  });
+});
+
+describe('msUntilNextDayPart', () => {
+  it('counts to the next boundary the same day', () => {
+    expect(msUntilNextDayPart(at(11, 30))).toBe(30 * 60 * 1000);
+    expect(msUntilNextDayPart(at(2, 0))).toBe(2 * 60 * 60 * 1000);
+  });
+
+  it('counts to 04:00 the next day after 17:00', () => {
+    expect(msUntilNextDayPart(at(23, 0))).toBe(5 * 60 * 60 * 1000);
+  });
+});
diff --git a/client/src/components/Chat/efGreeting.ts b/client/src/components/Chat/efGreeting.ts
new file mode 100644
index 0000000..67440d9
--- /dev/null
+++ b/client/src/components/Chat/efGreeting.ts
@@ -0,0 +1,86 @@
+import { useState, useEffect } from 'react';
+import type { TranslationKeys } from '~/hooks';
+import { useLocalize } from '~/hooks';
+
+/**
+ * EF (#186, owner-approved option B): the welcome screen greets the employee by first name for the time of day on
+ * their device: morning from 04:00, afternoon from 12:00, evening from 17:00. Arabic says «صباح الخير» in the morning
+ * and «مساء الخير» after noon; English keeps three greetings.
+ */
+export type DayPart = 'morning' | 'afternoon' | 'evening';
+
+const BOUNDARIES = [4, 12, 17];
+
+export function dayPart(date: Date): DayPart {
+  const hour = date.getHours();
+  if (hour >= 4 && hour < 12) {
+    return 'morning';
+  }
+  return hour >= 12 && hour < 17 ? 'afternoon' : 'evening';
+}
+
+/** Milliseconds until the next of 04:00, 12:00 or 17:00, when the greeting changes. */
+export function msUntilNextDayPart(date: Date): number {
+  const next = new Date(date);
+  const hour = BOUNDARIES.find((h) => h > date.getHours());
+  if (hour == null) {
+    next.setDate(next.getDate() + 1);
+    next.setHours(BOUNDARIES[0], 0, 0, 0);
+  } else {
+    next.setHours(hour, 0, 0, 0);
+  }
+  return next.getTime() - date.getTime();
+}
+
+/** Prefixes that form one first name with the word after them: «عبد الله», «أبو بكر», Abdul Rahman. */
+const COMPOUND_PREFIX = /^(عبد|أبو|ابو|abd|abdul|abdel|abu)$/i;
+
+/** The first name in an account name; empty when there is no usable name (none, or an email address). */
+export function firstName(fullName?: string | null): string {
+  const parts = (fullName ?? '').trim().split(/\s+/).filter(Boolean);
+  if (parts.length === 0 || parts[0].includes('@')) {
+    return '';
+  }
+  if (parts.length > 1 && COMPOUND_PREFIX.test(parts[0])) {
+    return `${parts[0]} ${parts[1]}`;
+  }
+  return parts[0];
+}
+
+const KEYS: Record<DayPart, { named: TranslationKeys; plain: TranslationKeys }> = {
+  morning: { named: 'com_efaiw_greeting_morning_named', plain: 'com_efaiw_greeting_morning' },
+  afternoon: { named: 'com_efaiw_greeting_afternoon_named', plain: 'com_efaiw_greeting_afternoon' },
+  evening: { named: 'com_efaiw_greeting_evening_named', plain: 'com_efaiw_greeting_evening' },
+};
+
+/** The greeting for now; it changes at the next boundary and is rechecked when the tab comes back into view. */
+export default function useEfGreeting(fullName?: string | null): string {
+  const localize = useLocalize();
+  const [part, setPart] = useState<DayPart>(() => dayPart(new Date()));
+
+  useEffect(() => {
+    let timeoutId: ReturnType<typeof setTimeout>;
+    const update = () => {
+      clearTimeout(timeoutId);
+      const now = new Date();
+      setPart(dayPart(now));
+      timeoutId = setTimeout(update, Math.max(msUntilNextDayPart(now), 1000));
+    };
+    const handleVisibilityChange = () => {
+      if (document.visibilityState === 'visible') {
+        update();
+      }
+    };
+    update();
+    document.addEventListener('visibilitychange', handleVisibilityChange);
+    window.addEventListener('focus', update);
+    return () => {
+      clearTimeout(timeoutId);
+      document.removeEventListener('visibilitychange', handleVisibilityChange);
+      window.removeEventListener('focus', update);
+    };
+  }, []);
+
+  const name = firstName(fullName);
+  return name ? localize(KEYS[part].named, { name }) : localize(KEYS[part].plain);
+}
