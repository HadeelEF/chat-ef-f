+import { useMemo } from 'react';
+import { useRecoilValue } from 'recoil';
+import i18n from '~/locales/i18n';
+import store from '~/store';
+
+/**
+ * EF (#186): upstream's chat direction setting reverses the composer's rows for right-to-left text, assuming a
+ * left-to-right page. On a right-to-left page (Arabic) the rows already run right to left, so reversing them again
+ * put Send on the start side and + on the end side. The setting therefore reverses the rows on LTR pages only.
+ */
+export function reversesComposer(chatDirection: string | null | undefined, lang: string): boolean {
+  return chatDirection?.toLowerCase() === 'rtl' && i18n.dir(lang) !== 'rtl';
+}
+
+export default function useComposerReversed(): boolean {
+  const chatDirection = useRecoilValue(store.chatDirection);
+  const lang = useRecoilValue(store.lang);
+  return useMemo(() => reversesComposer(chatDirection, lang), [chatDirection, lang]);
+}
