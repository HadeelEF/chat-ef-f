+import { reversesComposer } from '../composerDirection';
+
+describe('reversesComposer', () => {
+  it('reverses the rows for right-to-left chat on a left-to-right page (upstream behaviour)', () => {
+    expect(reversesComposer('RTL', 'en')).toBe(true);
+    expect(reversesComposer('rtl', 'en-US')).toBe(true);
+  });
+
+  it('keeps the rows on a right-to-left page, where they already run right to left', () => {
+    expect(reversesComposer('RTL', 'ar')).toBe(false);
+    expect(reversesComposer('RTL', 'ar-SA')).toBe(false);
+  });
+
+  it('keeps the rows when the setting is left to right or unset', () => {
+    expect(reversesComposer('LTR', 'en')).toBe(false);
+    expect(reversesComposer('LTR', 'ar')).toBe(false);
+    expect(reversesComposer(null, 'en')).toBe(false);
+    expect(reversesComposer(undefined, 'ar')).toBe(false);
+  });
+});
