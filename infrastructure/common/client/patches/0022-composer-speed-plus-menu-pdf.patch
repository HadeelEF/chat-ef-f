--- /dev/null
+++ b/client/src/utils/efaiwPrint.ts
@@ -0,0 +1,186 @@
+/**
+ * EF (#138): a reply as a print view — the browser's print dialog saves it as PDF, on a phone too (ChatGPT and
+ * Claude offer PDF next to Word). Built from the reply's Markdown with the same parser as the Word file
+ * (utils/efaiwDocx.ts), in a new tab: right to left when written in Arabic, code left to right, no app chrome. The
+ * page carries no script of its own: the opener wires its button, so a strict CSP on the app does not stop it.
+ */
+import { gfm } from 'micromark-extension-gfm';
+import { gfmFromMarkdown } from 'mdast-util-gfm';
+import { fromMarkdown } from 'mdast-util-from-markdown';
+import { isRtlText, stripArtifactDirectives } from './efaiwDocx';
+
+type Node = {
+  type: string;
+  value?: string;
+  depth?: number;
+  ordered?: boolean | null;
+  start?: number | null;
+  url?: string;
+  alt?: string | null;
+  lang?: string | null;
+  align?: Array<string | null>;
+  children?: Node[];
+};
+
+const esc = (text: string): string =>
+  text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
+
+const plain = (node: Node): string => node.value ?? (node.children ?? []).map(plain).join('');
+
+/** ` dir="rtl"` or ` dir="ltr"` from the first Arabic or Latin letter; none (the parent's) for numbers alone. */
+const dirOf = (node: Node): string => {
+  const text = plain(node);
+  if (!/[A-Za-z\u0600-\u06FF\u0750-\u077F\u08A0-\u08FF\uFB50-\uFDFF\uFE70-\uFEFF]/.test(text)) {
+    return '';
+  }
+  return isRtlText(text) ? ' dir="rtl"' : ' dir="ltr"';
+};
+
+const inline = (nodes: Node[] = []): string =>
+  nodes
+    .map((node) => {
+      switch (node.type) {
+        case 'text':
+          return esc(node.value ?? '');
+        case 'strong':
+          return `<strong>${inline(node.children)}</strong>`;
+        case 'emphasis':
+          return `<em>${inline(node.children)}</em>`;
+        case 'delete':
+          return `<del>${inline(node.children)}</del>`;
+        case 'inlineCode':
+          return `<code>${esc(node.value ?? '')}</code>`;
+        case 'break':
+          return '<br>';
+        case 'link': {
+          const url = node.url ?? '';
+          return /^(https?:|mailto:)/i.test(url)
+            ? `<a href="${esc(url)}">${inline(node.children)}</a>`
+            : inline(node.children);
+        }
+        case 'image':
+          return `<em>${esc(node.alt ?? '')}</em>`;
+        default:
+          return node.children ? inline(node.children) : esc(node.value ?? '');
+      }
+    })
+    .join('');
+
+const block = (node: Node): string => {
+  switch (node.type) {
+    case 'heading': {
+      const level = Math.min(Math.max(node.depth ?? 1, 1), 4);
+      return `<h${level}${dirOf(node)}>${inline(node.children)}</h${level}>`;
+    }
+    case 'paragraph':
+      return `<p${dirOf(node)}>${inline(node.children)}</p>`;
+    case 'list': {
+      const tag = node.ordered ? 'ol' : 'ul';
+      const start =
+        node.ordered && node.start != null && node.start !== 1 ? ` start="${node.start}"` : '';
+      const items = (node.children ?? [])
+        .map((item) => `<li${dirOf(item)}>${(item.children ?? []).map(listChild).join('')}</li>`)
+        .join('');
+      return `<${tag}${dirOf(node)}${start}>${items}</${tag}>`;
+    }
+    case 'code':
+      return `<pre dir="ltr"><code>${esc(node.value ?? '')}</code></pre>`;
+    case 'math':
+      return `<pre dir="ltr">${esc(node.value ?? '')}</pre>`;
+    case 'blockquote':
+      return `<blockquote${dirOf(node)}>${(node.children ?? []).map(block).join('')}</blockquote>`;
+    case 'thematicBreak':
+      return '<hr>';
+    case 'table': {
+      const rows = node.children ?? [];
+      const body = rows
+        .map((row, r) => {
+          const tag = r === 0 ? 'th' : 'td';
+          const cells = (row.children ?? [])
+            .map((cell, c) => {
+              const align = node.align?.[c];
+              const style = align === 'center' ? ' style="text-align:center"' : '';
+              return `<${tag}${dirOf(cell)}${style}>${inline(cell.children)}</${tag}>`;
+            })
+            .join('');
+          return `<tr>${cells}</tr>`;
+        })
+        .join('');
+      return `<table${dirOf(node)}>${body}</table>`;
+    }
+    case 'html':
+      return node.value ? `<p>${esc(node.value)}</p>` : '';
+    default:
+      return node.children ? node.children.map(block).join('') : '';
+  }
+};
+
+/** A list item's paragraphs render inline, so a tight list prints tight. */
+const listChild = (node: Node): string =>
+  node.type === 'paragraph' ? `<span>${inline(node.children)}</span>` : block(node);
+
+export function markdownToPrintHtml(markdown: string): string {
+  const tree = fromMarkdown(stripArtifactDirectives(markdown), {
+    extensions: [gfm()],
+    mdastExtensions: [gfmFromMarkdown()],
+  }) as unknown as Node;
+  return (tree.children ?? []).map(block).join('\n');
+}
+
+const STYLE = `
+@page { size: A4; margin: 18mm 16mm; }
+* { box-sizing: border-box; }
+body { margin: 0; color: #17211e; background: #fff; font: 16px/1.75 "Segoe UI", "Geeza Pro", "Noto Naskh Arabic", Tahoma, Arial, sans-serif; }
+main { max-width: 760px; margin: 0 auto; padding: 24px 20px 48px; }
+h1, h2, h3, h4 { line-height: 1.4; margin: 1.2em 0 0.5em; color: #1f3864; }
+h1 { font-size: 1.6em; } h2 { font-size: 1.35em; } h3 { font-size: 1.15em; } h4 { font-size: 1em; }
+p, li, td, th, blockquote { text-align: start; }
+p { margin: 0 0 0.8em; }
+ul, ol { margin: 0 0 0.8em; padding-inline-start: 1.6em; }
+li { margin: 0.2em 0; }
+table { border-collapse: collapse; width: 100%; margin: 0.8em 0 1.2em; font-size: 0.95em; break-inside: auto; }
+th, td { border: 1px solid #bfbfbf; padding: 6px 10px; vertical-align: top; }
+th { background: #edf1f7; font-weight: 600; }
+tr { break-inside: avoid; }
+pre { background: #f2f2f2; border-radius: 6px; padding: 10px 12px; overflow-x: auto; white-space: pre-wrap; font: 13px/1.5 Consolas, "Courier New", monospace; text-align: left; break-inside: avoid; }
+code { font-family: Consolas, "Courier New", monospace; font-size: 0.92em; background: #f2f2f2; padding: 0 4px; border-radius: 4px; direction: ltr; unicode-bidi: isolate; }
+pre code { background: none; padding: 0; }
+blockquote { margin: 0 0 0.8em; padding-inline-start: 12px; border-inline-start: 3px solid #bfbfbf; color: #595959; }
+hr { border: 0; border-top: 1px solid #bfbfbf; margin: 1.2em 0; }
+a { color: #1f5fad; }
+.bar { position: sticky; top: 0; display: flex; justify-content: flex-end; gap: 8px; padding: 10px 20px; background: #f6f8f7; border-bottom: 1px solid #d9e1de; }
+.bar button { font: inherit; font-size: 15px; padding: 8px 18px; border-radius: 999px; border: 0; background: #2b3a8f; color: #fff; cursor: pointer; }
+@media print { .bar { display: none; } main { padding: 0; } }
+`;
+
+/**
+ * Opens the reply in a new tab and its print dialog. Returns false when the browser blocked the tab, so the caller
+ * can say so. Phones show the dialog from the page's own button when they ignore the automatic call.
+ */
+export function openPrintView(
+  markdown: string,
+  title: string,
+  labels: { print: string; dir: 'rtl' | 'ltr'; lang: string },
+): boolean {
+  const view = window.open('', '_blank');
+  if (view == null) {
+    return false;
+  }
+  const doc = view.document;
+  doc.open();
+  doc.write(`<!doctype html><html lang="${labels.lang}" dir="${labels.dir}"><head><meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1"><title>${esc(title)}</title>
+<style>${STYLE}</style></head><body><div class="bar"><button type="button" id="efaiw-print">${esc(labels.print)}</button></div>
+<main dir="${isRtlText(markdown) ? 'rtl' : 'ltr'}">${markdownToPrintHtml(markdown)}</main></body></html>`);
+  doc.close();
+  doc.getElementById('efaiw-print')?.addEventListener('click', () => view.print());
+  view.focus();
+  setTimeout(() => {
+    try {
+      view.print();
+    } catch {
+      /* the page's button remains */
+    }
+  }, 400);
+  return true;
+}
