+import { memo } from 'react';
+import { Globe } from 'lucide-react';
+import { CheckboxButton } from '@librechat/client';
+import useComposerModes from './composerModes';
+import { badgeAccents } from './accents';
+import { useLocalize } from '~/hooks';
+
+/**
+ * EF (#138): the chip of the provider's built-in web search (ADR-0015), shown while it is on for this chat. Tapping
+ * it moves the chat to the spec's no-search twin; the + menu turns it back on.
+ */
+function InternetBadge() {
+  const localize = useLocalize();
+  const { available, web, setWeb } = useComposerModes();
+  if (!available || !web) {
+    return null;
+  }
+  return (
+    <CheckboxButton
+      checked={true}
+      setValue={() => setWeb(false)}
+      label={localize('com_efaiw_internet')}
+      isCheckedClassName={badgeAccents.blue}
+      icon={<Globe className="icon-md" aria-hidden="true" />}
+    />
+  );
+}
+
+export default memo(InternetBadge);
