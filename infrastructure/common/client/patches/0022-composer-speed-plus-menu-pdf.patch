--- /dev/null
+++ b/client/src/components/Chat/Input/SpeedSelector.tsx
@@ -0,0 +1,94 @@
+import { memo } from 'react';
+import * as Ariakit from '@ariakit/react';
+import { Check, ChevronDown, Lightbulb, Telescope, Zap } from 'lucide-react';
+import { composerControlClasses } from '@librechat/client';
+import type { LucideIcon } from 'lucide-react';
+import type { TranslationKeys } from '~/hooks';
+import { useShortcutAriaKey } from '~/hooks/useKeyboardShortcuts';
+import useComposerModes from './composerModes';
+import type { SpeedId } from './composerModes';
+import { useLocalize } from '~/hooks';
+import { cn } from '~/utils';
+
+const OPTIONS: ReadonlyArray<{ id: SpeedId; icon: LucideIcon; label: TranslationKeys }> = [
+  { id: 'fast', icon: Zap, label: 'com_efaiw_speed_fast' },
+  { id: 'careful', icon: Lightbulb, label: 'com_efaiw_speed_careful' },
+  { id: 'deep', icon: Telescope, label: 'com_efaiw_speed_deep' },
+];
+
+/**
+ * EF (#138): «سريع / متأنٍّ / عميق» in place of the model button and the thinking switch, like Qwen Chat's mode
+ * menu: one choice named by its outcome. Each option is one of the three specs and names it under the outcome
+ * («بصير لايت · …», its description from librechat.yaml), so the reply's label still matches. The chat switches in
+ * place and keeps its internet setting.
+ */
+function SpeedSelector({ disabled = false }: { disabled?: boolean }) {
+  const localize = useLocalize();
+  const { speed, setSpeed, specOf } = useComposerModes();
+  const active = OPTIONS.find((o) => o.id === speed) ?? OPTIONS[0];
+  const ActiveIcon = active.icon;
+  const name = `${localize('com_efaiw_speed')}: ${localize(active.label)}`;
+  /* The model selector's shortcut (Ctrl/⌘ + Shift + M) opens this menu: it finds the button by its test id. */
+  const shortcut = useShortcutAriaKey('openModelSelector');
+
+  return (
+    <Ariakit.MenuProvider placement="top-start">
+      <Ariakit.MenuButton
+        disabled={disabled}
+        data-testid="model-selector-button"
+        aria-keyshortcuts={shortcut}
+        aria-label={name}
+        title={name}
+        className={cn(
+          composerControlClasses(),
+          'gap-1.5 px-theme-normal',
+          disabled && 'opacity-70',
+        )}
+      >
+        <ActiveIcon className="icon-md" aria-hidden="true" />
+        <span>{localize(active.label)}</span>
+        <ChevronDown className="size-4 text-text-secondary" aria-hidden="true" />
+      </Ariakit.MenuButton>
+      <Ariakit.Menu
+        portal={true}
+        gutter={6}
+        unmountOnHide={true}
+        aria-label={localize('com_efaiw_speed')}
+        className="popover-ui z-50 flex w-72 max-w-[calc(100vw-32px)] flex-col gap-0.5 rounded-xl border border-border-light bg-surface-secondary p-1.5 shadow-lg"
+      >
+        {OPTIONS.map((option) => {
+          const spec = specOf(option.id);
+          if (spec == null) {
+            return null;
+          }
+          const Icon = option.icon;
+          const checked = option.id === active.id;
+          return (
+            <Ariakit.MenuItem
+              key={option.id}
+              role="menuitemradio"
+              aria-checked={checked}
+              onClick={() => setSpeed(option.id)}
+              className="flex w-full cursor-pointer items-start gap-3 rounded-lg px-3 py-2.5 text-start text-text-primary outline-none hover:bg-surface-hover focus:bg-surface-hover data-[active-item]:bg-surface-hover"
+            >
+              <Icon className="icon-md mt-0.5 shrink-0" aria-hidden="true" />
+              <span className="flex min-w-0 flex-1 flex-col">
+                <span className="text-sm font-medium">{localize(option.label)}</span>
+                <span className="text-xs text-text-secondary">
+                  {spec.label}
+                  {spec.description ? ` · ${spec.description}` : ''}
+                </span>
+              </span>
+              <Check
+                className={cn('icon-sm mt-1 shrink-0', checked ? 'opacity-100' : 'opacity-0')}
+                aria-hidden="true"
+              />
+            </Ariakit.MenuItem>
+          );
+        })}
+      </Ariakit.Menu>
+    </Ariakit.MenuProvider>
+  );
+}
+
+export default memo(SpeedSelector);
