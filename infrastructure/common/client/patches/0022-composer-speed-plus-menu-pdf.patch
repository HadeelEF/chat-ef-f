diff --git a/client/src/components/Chat/Input/composerModes.ts b/client/src/components/Chat/Input/composerModes.ts
new file mode 100644
index 0000000..8159f66
--- /dev/null
+++ b/client/src/components/Chat/Input/composerModes.ts
@@ -0,0 +1,123 @@
+import { useCallback, useMemo } from 'react';
+import { useRecoilValue } from 'recoil';
+import type { TModelSpec } from 'librechat-data-provider';
+import { useGetEndpointsQuery, useGetStartupConfig } from '~/data-provider';
+import useSelectMention from '~/hooks/Input/useSelectMention';
+import { useGetConversation, useNewConvo } from '~/hooks';
+import { useAssistantsMapContext } from '~/Providers';
+import store from '~/store';
+
+/**
+ * EF (#138): the composer's speed and internet controls over the approved lineup (librechat.yaml, #131, #135).
+ * A speed is a visible spec; its no-search twin is a hidden spec (`showInMenu: false`) on a no-search endpoint. The
+ * server keeps hidden specs out of the browser's config but resolves them by name, so the twin is built here from
+ * the visible spec with the twin's name and endpoint. Any other spec (an agent, an upstream configuration) has no
+ * speed: the composer then shows the upstream model button.
+ */
+export type SpeedId = 'fast' | 'careful' | 'deep';
+
+export const SPEEDS: ReadonlyArray<{
+  id: SpeedId;
+  spec: string;
+  noWebSpec: string;
+  noWebEndpoint: string;
+}> = [
+  { id: 'fast', spec: 'baseer-lite', noWebSpec: 'baseer-lite-noweb', noWebEndpoint: 'Qwen NoWeb' },
+  {
+    id: 'careful',
+    spec: 'baseer-plus',
+    noWebSpec: 'baseer-plus-noweb',
+    noWebEndpoint: 'Qwen Thinking NoWeb',
+  },
+  {
+    id: 'deep',
+    spec: 'baseer-pro',
+    noWebSpec: 'baseer-pro-noweb',
+    noWebEndpoint: 'DeepSeek NoWeb',
+  },
+];
+
+/** A chat saved without a spec name still carries its spec's endpoint. */
+const SPEC_BY_ENDPOINT: Record<string, string> = {
+  Qwen: 'baseer-lite',
+  'Qwen Thinking': 'baseer-plus',
+  DeepSeek: 'baseer-pro',
+  'Qwen NoWeb': 'baseer-lite-noweb',
+  'Qwen Thinking NoWeb': 'baseer-plus-noweb',
+  'DeepSeek NoWeb': 'baseer-pro-noweb',
+};
+
+export default function useComposerModes() {
+  const { data: startupConfig } = useGetStartupConfig();
+  const spec = useRecoilValue(store.conversationSpecByIndex(0));
+  const endpoint = useRecoilValue(store.conversationEndpointByIndex(0));
+  const getConversation = useGetConversation(0);
+  const { newConversation } = useNewConvo();
+  const assistantsMap = useAssistantsMapContext();
+  const { data: endpointsConfig } = useGetEndpointsQuery();
+  const modelSpecs = useMemo(() => startupConfig?.modelSpecs?.list ?? [], [startupConfig]);
+  const { onSelectSpec } = useSelectMention({
+    modelSpecs,
+    assistantsMap,
+    endpointsConfig,
+    getConversation,
+    newConversation,
+    returnHandlers: true,
+  });
+
+  const current = spec || (endpoint != null ? SPEC_BY_ENDPOINT[endpoint] : undefined);
+  const speed = SPEEDS.find((s) => s.spec === current || s.noWebSpec === current);
+
+  const specFor = useCallback(
+    (target: (typeof SPEEDS)[number], web: boolean): TModelSpec | undefined => {
+      const visible = modelSpecs.find((s) => s.name === target.spec);
+      if (visible == null || web) {
+        return visible;
+      }
+      return {
+        ...visible,
+        name: target.noWebSpec,
+        preset: { ...visible.preset, endpoint: target.noWebEndpoint },
+      } as TModelSpec;
+    },
+    [modelSpecs],
+  );
+
+  const available = speed != null && specFor(speed, true) != null;
+  const web = speed != null && current === speed.spec;
+
+  const select = useCallback(
+    (target: TModelSpec | undefined) => {
+      if (target != null && target.name !== current) {
+        onSelectSpec?.(target);
+      }
+    },
+    [current, onSelectSpec],
+  );
+
+  const setSpeed = useCallback(
+    (id: SpeedId) => {
+      const target = SPEEDS.find((s) => s.id === id);
+      if (target != null) {
+        select(specFor(target, web));
+      }
+    },
+    [select, specFor, web],
+  );
+
+  const setWeb = useCallback(
+    (on: boolean) => {
+      if (speed != null) {
+        select(specFor(speed, on));
+      }
+    },
+    [select, specFor, speed],
+  );
+
+  const specOf = useCallback(
+    (id: SpeedId) => modelSpecs.find((s) => s.name === SPEEDS.find((x) => x.id === id)?.spec),
+    [modelSpecs],
+  );
+
+  return { available, speed: speed?.id, web, setSpeed, setWeb, specOf };
+}
