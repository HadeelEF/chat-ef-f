@@ -0,0 +1,73 @@
+import React from 'react';
+import { Provider, createStore } from 'jotai';
+import { RecoilRoot, useSetRecoilState } from 'recoil';
+import { act, render, screen } from '@testing-library/react';
+import '@testing-library/jest-dom';
+import { showSkillsPopoverFamily } from '../skillsState';
+import EfSkillsTip from '../EfSkillsTip';
+import store from '~/store';
+
+jest.mock('~/hooks', () => ({
+  useLocalize: () => (key: string) => key,
+  useHasAccess: () => true,
+  useGetAgentsConfig: () => ({ agentsConfig: { capabilities: ['skills'] } }),
+  useAgentCapabilities: () => ({ skillsEnabled: true }),
+}));
+
+jest.mock('~/utils/efaiwApp', () => ({
+  useInstallHintOpen: () => false,
+}));
+
+const SEEN_KEY = 'efaiw:skills-tip-seen';
+let openCommands: (open: boolean) => void = () => undefined;
+
+function CommandsListSwitch() {
+  const set = useSetRecoilState(store.showPromptsPopoverFamily(0));
+  openCommands = set;
+  return null;
+}
+
+function setup() {
+  const jotai = createStore();
+  render(
+    <RecoilRoot>
+      <Provider store={jotai}>
+        <CommandsListSwitch />
+        <EfSkillsTip />
+      </Provider>
+    </RecoilRoot>,
+  );
+  return jotai;
+}
+
+const tip = () => screen.queryByRole('note');
+
+describe('EfSkillsTip (#241)', () => {
+  beforeEach(() => localStorage.clear());
+
+  it('shows once above a new chat until «فهمت»', () => {
+    setup();
+    expect(tip()).toBeInTheDocument();
+    act(() => screen.getByRole('button', { name: 'com_efaiw_skills_tip_ok' }).click());
+    expect(tip()).not.toBeInTheDocument();
+    expect(localStorage.getItem(SEEN_KEY)).toBe('1');
+  });
+
+  it('hides for good once the skills list opens, so the list sits right above the box', () => {
+    const jotai = setup();
+    act(() => jotai.set(showSkillsPopoverFamily(0), true));
+    expect(tip()).not.toBeInTheDocument();
+    expect(localStorage.getItem(SEEN_KEY)).toBe('1');
+    act(() => jotai.set(showSkillsPopoverFamily(0), false));
+    expect(tip()).not.toBeInTheDocument();
+  });
+
+  it('steps aside while the «/» list is open and comes back after it', () => {
+    setup();
+    act(() => openCommands(true));
+    expect(tip()).not.toBeInTheDocument();
+    act(() => openCommands(false));
+    expect(tip()).toBeInTheDocument();
+    expect(localStorage.getItem(SEEN_KEY)).toBeNull();
+  });
+});
