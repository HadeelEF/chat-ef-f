@@ -0,0 +1,114 @@
+import React from 'react';
+import { RecoilRoot } from 'recoil';
+import { MemoryRouter } from 'react-router-dom';
+import { renderHook } from '@testing-library/react';
+import { Constants } from 'librechat-data-provider';
+import type { TConversation, TEndpointsConfig, TModelSpec } from 'librechat-data-provider';
+import type { ConvoGenerator } from '~/common';
+import useSelectMention from './useSelectMention';
+import store from '~/store';
+
+/** The default conversation takes the preset's settings and keeps the conversation it is built from. */
+jest.mock('~/hooks', () => ({
+  useDefaultConvo:
+    () =>
+    ({ conversation, preset }: { conversation: Partial<TConversation>; preset: object }) => ({
+      ...conversation,
+      ...preset,
+      conversationId: conversation.conversationId,
+    }),
+}));
+
+/** EF (#241): the lineup's speeds are custom endpoints of the same server (librechat.yaml). */
+const endpointsConfig = {
+  Qwen: { type: 'custom' },
+  'Qwen Thinking': { type: 'custom' },
+  DeepSeek: { type: 'custom' },
+} as unknown as TEndpointsConfig;
+
+const plus = {
+  name: 'baseer-plus',
+  label: 'بصير بلس',
+  preset: { endpoint: 'Qwen Thinking', model: 'qwen3.8-flash' },
+} as unknown as TModelSpec;
+
+const lite = (conversationId: string | null): TConversation =>
+  ({
+    conversationId,
+    endpoint: 'Qwen',
+    endpointType: 'custom',
+    model: 'qwen3.8-flash',
+    spec: 'baseer-lite',
+  }) as unknown as TConversation;
+
+function setup(conversation: TConversation | null, modularChat = true) {
+  const newConversation = jest.fn() as unknown as jest.MockedFunction<ConvoGenerator>;
+  const wrapper = ({ children }: { children: React.ReactNode }) => (
+    <RecoilRoot initializeState={({ set }) => set(store.modularChat, modularChat)}>
+      <MemoryRouter>{children}</MemoryRouter>
+    </RecoilRoot>
+  );
+  const { result } = renderHook(
+    () =>
+      useSelectMention({
+        modelSpecs: [plus],
+        endpointsConfig,
+        getConversation: () => conversation,
+        newConversation,
+        returnHandlers: true,
+      }),
+    { wrapper },
+  );
+  return { handlers: result.current, newConversation };
+}
+
+const lastCall = (fn: jest.Mock | jest.MockedFunction<ConvoGenerator>) =>
+  (fn as jest.Mock).mock.calls.at(-1)?.[0];
+
+describe('useSelectMention: the message box on a model switch (#241)', () => {
+  it('keeps the draft and attachments of a chat with no message yet (a picked skill, a file)', () => {
+    const { handlers, newConversation } = setup(lite(Constants.NEW_CONVO));
+    handlers.onSelectSpec?.(plus);
+    expect(newConversation).toHaveBeenCalledTimes(1);
+    expect(lastCall(newConversation)).toMatchObject({
+      preset: { spec: 'baseer-plus', endpoint: 'Qwen Thinking' },
+      keepComposerState: true,
+    });
+  });
+
+  it('keeps them before the conversation exists at all', () => {
+    const { handlers, newConversation } = setup(null);
+    handlers.onSelectSpec?.(plus);
+    expect(lastCall(newConversation)).toMatchObject({ keepComposerState: true });
+  });
+
+  it('keeps them when the model menu picks an endpoint and model', () => {
+    const { handlers, newConversation } = setup(lite(Constants.NEW_CONVO));
+    handlers.onSelectEndpoint?.('Qwen Thinking', { model: 'qwen3.8-flash' });
+    expect(lastCall(newConversation)).toMatchObject({
+      preset: { endpoint: 'Qwen Thinking', model: 'qwen3.8-flash' },
+      keepComposerState: true,
+    });
+  });
+
+  it('leaves a chat with messages on the upstream switch, which keeps its id', () => {
+    const { handlers, newConversation } = setup(lite('5e1c2a1e-0000-4000-8000-000000000001'));
+    handlers.onSelectSpec?.(plus);
+    const call = lastCall(newConversation);
+    expect(call.template.conversationId).toBe('5e1c2a1e-0000-4000-8000-000000000001');
+    expect(call.keepAddedConvos).toBe(true);
+    expect(call.keepComposerState).toBeUndefined();
+  });
+
+  it('still starts clean when a chat with messages moves to a new chat', () => {
+    const { handlers, newConversation } = setup(
+      lite('5e1c2a1e-0000-4000-8000-000000000002'),
+      false,
+    );
+    handlers.onSelectSpec?.(plus);
+    expect(lastCall(newConversation)).toMatchObject({
+      template: { conversationId: Constants.NEW_CONVO },
+      keepComposerState: false,
+    });
+  });
+});
