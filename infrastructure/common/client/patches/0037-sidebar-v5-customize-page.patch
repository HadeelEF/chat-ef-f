+import React from 'react';
+import '@testing-library/jest-dom/extend-expect';
+import { MemoryRouter } from 'react-router-dom';
+import { render, screen } from '@testing-library/react';
+
+let mockSmallScreen = false;
+
+jest.mock('@librechat/client', () => ({
+  Spinner: () => <div data-testid="spinner" />,
+  useMediaQuery: () => mockSmallScreen,
+}));
+jest.mock('~/components/Chat/Menus/OpenSidebar', () => ({
+  __esModule: true,
+  default: () => <button type="button" aria-label="open-sidebar" />,
+}));
+jest.mock('~/hooks', () => ({
+  useLocalize: () => (key: string, values?: Record<string, string>) =>
+    values ? `${key}:${Object.values(values).join(',')}` : key,
+  useAuthContext: () => ({ user: { role: 'USER' }, roles: { USER: {} } }),
+  useHasAccess: () => true,
+}));
+jest.mock('~/utils', () => ({
+  cn: (...classes: unknown[]) => classes.filter(Boolean).join(' '),
+}));
+
+import EfSectionPage from '../EfSectionPage';
+
+const parent = { to: '/customize', label: 'com_efaiw_customize' };
+
+function renderPage(props: Partial<React.ComponentProps<typeof EfSectionPage>> = {}) {
+  return render(
+    <MemoryRouter initialEntries={['/skills']}>
+      <EfSectionPage title="com_efaiw_rail_skills" {...props}>
+        <p data-testid="content" />
+      </EfSectionPage>
+    </MemoryRouter>,
+  );
+}
+
+describe('EfSectionPage: the way back to «Customize» (#221)', () => {
+  beforeEach(() => {
+    mockSmallScreen = false;
+  });
+
+  it('wider screens: a breadcrumb above the title leads to «Customize»', () => {
+    renderPage({ parent });
+    const crumb = screen.getByRole('navigation', { name: 'com_efaiw_breadcrumb' });
+    expect(crumb).toContainElement(screen.getByRole('link', { name: 'com_efaiw_customize' }));
+    expect(screen.getByRole('link', { name: 'com_efaiw_customize' })).toHaveAttribute(
+      'href',
+      '/customize',
+    );
+    expect(screen.getByRole('heading', { level: 1 })).toHaveTextContent('com_efaiw_rail_skills');
+    expect(screen.queryByRole('button', { name: 'open-sidebar' })).not.toBeInTheDocument();
+  });
+
+  it('phones: the menu button, then a back button to «Customize»', () => {
+    mockSmallScreen = true;
+    renderPage({ parent });
+    expect(screen.getByRole('button', { name: 'open-sidebar' })).toBeInTheDocument();
+    expect(
+      screen.getByRole('link', { name: 'com_efaiw_back_to:com_efaiw_customize' }),
+    ).toHaveAttribute('href', '/customize');
+    expect(screen.queryByRole('navigation')).not.toBeInTheDocument();
+  });
+
+  it('phones: an open detail leads back to its list instead', () => {
+    mockSmallScreen = true;
+    renderPage({ parent, list: <ul />, detailOpen: true, backTo: '/skills' });
+    expect(screen.getByRole('link', { name: 'com_ui_back' })).toHaveAttribute('href', '/skills');
+    expect(
+      screen.queryByRole('link', { name: 'com_efaiw_back_to:com_efaiw_customize' }),
+    ).not.toBeInTheDocument();
+  });
+
+  it('a page outside «Customize» (Documents, Projects) has no way back', () => {
+    renderPage();
+    expect(screen.queryByRole('navigation')).not.toBeInTheDocument();
+    expect(screen.queryByTestId('efaiw-page-parent')).not.toBeInTheDocument();
+  });
+});
