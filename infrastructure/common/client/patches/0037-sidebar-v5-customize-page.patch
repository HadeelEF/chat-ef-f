diff --git a/client/src/components/EfPages/__tests__/EfCustomizePage.spec.tsx b/client/src/components/EfPages/__tests__/EfCustomizePage.spec.tsx
new file mode 100644
index 0000000..8f41ae6
--- /dev/null
+++ b/client/src/components/EfPages/__tests__/EfCustomizePage.spec.tsx
@@ -0,0 +1,275 @@
+import React from 'react';
+import '@testing-library/jest-dom/extend-expect';
+import { MemoryRouter } from 'react-router-dom';
+import { render, fireEvent, screen, within } from '@testing-library/react';
+import {
+  BarChart3,
+  Bookmark,
+  Bot,
+  Brain,
+  CalendarClock,
+  Folder,
+  MessagesSquare,
+  NotebookPen,
+  Paperclip,
+  Server,
+  Settings2,
+} from 'lucide-react';
+import type { NavLink } from '~/common';
+
+const mockStartNewChat = jest.fn();
+const mockSetSidebarOpen = jest.fn();
+let mockRole = 'USER';
+let mockShowMarketplace = true;
+let mockExpanded = true;
+let mockLinks: NavLink[] = [];
+
+jest.mock('~/hooks', () => ({
+  useLocalize: () => (key: string) => key,
+  useAuthContext: () => ({ user: { role: mockRole } }),
+  useShowMarketplace: () => mockShowMarketplace,
+}));
+jest.mock('~/hooks/Nav/useUnifiedSidebarLinks', () => ({
+  __esModule: true,
+  default: () => mockLinks,
+}));
+jest.mock('~/hooks/Nav/useSidebarState', () => ({
+  __esModule: true,
+  default: () => ({ isSmallScreen: false, expanded: mockExpanded }),
+}));
+jest.mock('~/hooks/Nav/useSidebarToggle', () => ({
+  __esModule: true,
+  default: () => ({ setSidebarOpen: mockSetSidebarOpen }),
+}));
+jest.mock('~/hooks/Chat/useNewChat', () => ({
+  __esModule: true,
+  default: () => ({ startNewChat: mockStartNewChat }),
+}));
+jest.mock('~/utils', () => ({
+  cn: (...classes: unknown[]) => classes.filter(Boolean).join(' '),
+}));
+/** The page frame (title, permission check, phone header) has its own spec. */
+jest.mock('../EfSectionPage', () => ({
+  __esModule: true,
+  default: ({
+    title,
+    hint,
+    children,
+  }: {
+    title: string;
+    hint?: string;
+    children: React.ReactNode;
+  }) => (
+    <main>
+      <h1>{title}</h1>
+      <p>{hint}</p>
+      {children}
+    </main>
+  ),
+}));
+
+import EfCustomizePage from '../EfCustomizePage';
+
+const Panel = () => null;
+const page = (id: string, title: NavLink['title'], icon: NavLink['icon']): NavLink => ({
+  id,
+  title,
+  icon,
+  onClick: jest.fn(),
+});
+const panel = (id: string, title: NavLink['title'], icon: NavLink['icon']): NavLink => ({
+  id,
+  title,
+  icon,
+  Component: Panel,
+});
+
+/** As useUnifiedSidebarLinks returns them (the admin tools only for admins). */
+const createLinks = ({ admin = false, extra = [] as NavLink[] } = {}): NavLink[] => [
+  panel('conversations', 'com_ui_chat_history', MessagesSquare),
+  page('projects', 'com_ui_projects', Folder),
+  ...(admin ? [panel('agents', 'com_sidepanel_agent_builder', Bot)] : []),
+  page('skills', 'com_ui_skills', NotebookPen),
+  page('prompts', 'com_ui_prompts', NotebookPen),
+  page('memories', 'com_ui_memories', Brain),
+  page('bookmarks', 'com_sidepanel_conversation_tags', Bookmark),
+  page('files', 'com_sidepanel_attach_files', Paperclip),
+  ...(admin
+    ? [
+        panel('parameters', 'com_sidepanel_parameters', Settings2),
+        panel('mcp-builder', 'com_nav_setting_mcp', Server),
+      ]
+    : []),
+  ...extra,
+];
+
+/** The sidebar's hidden shortcut targets, which the page presses to open a panel tool. */
+function addTargets(ids: string[], pressed: string[] = []) {
+  const clicks: Record<string, jest.Mock> = {};
+  for (const id of ids) {
+    const button = document.createElement('button');
+    button.hidden = true;
+    button.dataset.testid = `nav-panel-${id}`;
+    button.setAttribute('aria-pressed', pressed.includes(id) ? 'true' : 'false');
+    clicks[id] = jest.fn();
+    button.addEventListener('click', clicks[id]);
+    document.body.appendChild(button);
+  }
+  return clicks;
+}
+
+function renderPage() {
+  return render(
+    <MemoryRouter initialEntries={['/customize']}>
+      <EfCustomizePage />
+    </MemoryRouter>,
+  );
+}
+
+const section = (name: string) =>
+  screen.getByRole('heading', { level: 2, name }).closest('section') as HTMLElement;
+const cardIds = (container: HTMLElement) =>
+  within(container)
+    .getAllByRole('listitem')
+    .map((item) => item.getAttribute('data-testid'));
+
+describe('EfCustomizePage («Customize», sidebar v5 #221)', () => {
+  beforeEach(() => {
+    jest.clearAllMocks();
+    jest.useRealTimers();
+    document.querySelectorAll('[data-testid^="nav-panel-"]').forEach((node) => node.remove());
+    mockRole = 'USER';
+    mockShowMarketplace = true;
+    mockExpanded = true;
+    mockLinks = createLinks();
+  });
+
+  it("an employee's page: the tools for everyone, in order, each a page with its line, and no admin tools", () => {
+    renderPage();
+    expect(screen.getByRole('heading', { level: 1 })).toHaveTextContent('com_efaiw_customize');
+    const forYou = section('com_efaiw_customize_for_you');
+    expect(cardIds(forYou)).toEqual([
+      'efaiw-cz-prompts',
+      'efaiw-cz-skills',
+      'efaiw-cz-memories',
+      'efaiw-cz-bookmarks',
+    ]);
+    const prompts = within(forYou).getByRole('link', { name: 'com_ui_prompts' });
+    expect(prompts).toHaveAttribute('href', '/prompts');
+    expect(prompts).toHaveAccessibleDescription('com_efaiw_desc_prompts');
+    expect(within(forYou).getByRole('link', { name: 'com_efaiw_rail_skills' })).toHaveAttribute(
+      'href',
+      '/skills',
+    );
+    expect(screen.queryByText('com_efaiw_admin_tools')).not.toBeInTheDocument();
+    expect(screen.queryByTestId('efaiw-cz-marketplace')).not.toBeInTheDocument();
+    expect(screen.queryByText('com_efaiw_new')).not.toBeInTheDocument();
+    expect(screen.getByText('com_efaiw_customize_tip')).toBeInTheDocument();
+  });
+
+  it('the work sections (projects, documents) stay in the sidebar, not here', () => {
+    renderPage();
+    expect(screen.queryByTestId('efaiw-cz-projects')).not.toBeInTheDocument();
+    expect(screen.queryByTestId('efaiw-cz-files')).not.toBeInTheDocument();
+    expect(screen.queryByTestId('efaiw-cz-conversations')).not.toBeInTheDocument();
+  });
+
+  it('a section the deployment adds (an upgrade, a new feature) gets its card by itself, marked new', () => {
+    mockLinks = createLinks({
+      extra: [panel('schedules', 'com_ui_schedules' as NavLink['title'], CalendarClock)],
+    });
+    const clicks = addTargets(['schedules']);
+    renderPage();
+    const card = screen.getByTestId('efaiw-cz-schedules');
+    expect(section('com_efaiw_customize_for_you')).toContainElement(card);
+    expect(card).toHaveTextContent('com_efaiw_new');
+    const open = within(card).getByRole('button', { name: 'com_ui_schedules' });
+    expect(open).toHaveAccessibleDescription('com_efaiw_desc_new');
+    fireEvent.click(open);
+    expect(clicks.schedules).toHaveBeenCalledTimes(1);
+  });
+
+  it('a section that navigates by itself (Insights) keeps doing so', () => {
+    const insights = page('insights', 'com_insights_navigation' as NavLink['title'], BarChart3);
+    mockLinks = createLinks({ extra: [insights] });
+    renderPage();
+    fireEvent.click(screen.getByRole('button', { name: 'com_insights_navigation' }));
+    expect(insights.onClick).toHaveBeenCalledTimes(1);
+  });
+
+  it("an admin's page adds «Admins only»: the marketplace with «New assistant», the parameters and the connectors", () => {
+    mockRole = 'ADMIN';
+    mockLinks = createLinks({ admin: true });
+    renderPage();
+    const admin = section('com_efaiw_admin_tools');
+    expect(cardIds(admin)).toEqual([
+      'efaiw-cz-marketplace',
+      'efaiw-cz-parameters',
+      'efaiw-cz-mcp-builder',
+    ]);
+    expect(within(admin).getByRole('link', { name: 'com_efaiw_rail_agents' })).toHaveAttribute(
+      'href',
+      '/agents',
+    );
+    for (const id of ['efaiw-cz-marketplace', 'efaiw-cz-parameters', 'efaiw-cz-mcp-builder']) {
+      expect(screen.getByTestId(id)).toHaveTextContent('com_efaiw_admin_only');
+    }
+    expect(
+      within(admin).getByRole('button', { name: 'com_efaiw_connectors' }),
+    ).toHaveAccessibleDescription('com_efaiw_desc_connectors');
+    /** The builder is the marketplace card's action, not a card of its own. */
+    expect(screen.queryByTestId('efaiw-cz-agents')).not.toBeInTheDocument();
+    expect(cardIds(section('com_efaiw_customize_for_you'))).toHaveLength(4);
+  });
+
+  it('«New assistant» starts a new chat and opens the builder in the sidebar', () => {
+    mockRole = 'ADMIN';
+    mockLinks = createLinks({ admin: true });
+    const clicks = addTargets(['agents']);
+    renderPage();
+    fireEvent.click(screen.getByTestId('efaiw-cz-new-agent'));
+    expect(mockStartNewChat).toHaveBeenCalledTimes(1);
+    expect(clicks.agents).toHaveBeenCalledTimes(1);
+  });
+
+  it('without the marketplace, the builder has its own card', () => {
+    mockRole = 'ADMIN';
+    mockShowMarketplace = false;
+    mockLinks = createLinks({ admin: true });
+    renderPage();
+    expect(cardIds(section('com_efaiw_admin_tools'))).toEqual([
+      'efaiw-cz-agents',
+      'efaiw-cz-parameters',
+      'efaiw-cz-mcp-builder',
+    ]);
+    expect(screen.queryByTestId('efaiw-cz-new-agent')).not.toBeInTheDocument();
+  });
+
+  it('a panel tool opens in the open sidebar, and leaves an already open one alone', () => {
+    mockRole = 'ADMIN';
+    mockLinks = createLinks({ admin: true });
+    const clicks = addTargets(['mcp-builder', 'parameters'], ['parameters']);
+    renderPage();
+    fireEvent.click(screen.getByRole('button', { name: 'com_efaiw_connectors' }));
+    expect(clicks['mcp-builder']).toHaveBeenCalledTimes(1);
+    fireEvent.click(screen.getByRole('button', { name: 'com_efaiw_rail_parameters' }));
+    expect(clicks.parameters).not.toHaveBeenCalled();
+    expect(mockSetSidebarOpen).not.toHaveBeenCalled();
+  });
+
+  it('a panel tool opens the closed sidebar (the phone drawer) first', () => {
+    jest.useFakeTimers();
+    mockRole = 'ADMIN';
+    mockExpanded = false;
+    mockLinks = createLinks({ admin: true });
+    const clicks = addTargets(['mcp-builder']);
+    renderPage();
+    fireEvent.click(screen.getByRole('button', { name: 'com_efaiw_connectors' }));
+    expect(mockSetSidebarOpen).toHaveBeenCalledWith(true, expect.any(Function));
+    expect(clicks['mcp-builder']).not.toHaveBeenCalled();
+    const afterSlide = mockSetSidebarOpen.mock.calls[0][1] as () => void;
+    afterSlide();
+    jest.runAllTimers();
+    expect(clicks['mcp-builder']).toHaveBeenCalledTimes(1);
+  });
+});
