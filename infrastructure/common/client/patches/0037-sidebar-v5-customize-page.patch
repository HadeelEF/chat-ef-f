+++ b/client/src/components/EfPages/EfCustomizePage.tsx
@@ -0,0 +1,269 @@
+import { useCallback, useId } from 'react';
+import { Link } from 'react-router-dom';
+import { ChevronLeft, LayoutGrid, Plus, Slash } from 'lucide-react';
+import { SystemRoles } from 'librechat-data-provider';
+import type { ReactNode } from 'react';
+import type { NavLink } from '~/common';
+import type { TranslationKeys } from '~/hooks';
+import {
+  EF_PAGES,
+  EF_LINK_LABELS,
+  efAdminLinks,
+  efCustomizeLinks,
+} from '~/components/UnifiedSidebar/efSidebar';
+import useUnifiedSidebarLinks from '~/hooks/Nav/useUnifiedSidebarLinks';
+import useSidebarToggle from '~/hooks/Nav/useSidebarToggle';
+import useSidebarState from '~/hooks/Nav/useSidebarState';
+import { useAuthContext, useLocalize, useShowMarketplace } from '~/hooks';
+import useNewChat from '~/hooks/Chat/useNewChat';
+import EfSectionPage from './EfSectionPage';
+import { cn } from '~/utils';
+
+/** A card's title where it differs from the sidebar's short name. */
+const CARD_LABELS: Record<string, TranslationKeys> = {
+  prompts: 'com_ui_prompts',
+};
+
+/** One line on what each known tool is for. A section without one is new to the workspace (a LibreChat upgrade or a
+ *  newly enabled feature added it): it still gets its card, marked «New», until it is described here. */
+const CARD_DESCRIPTIONS: Record<string, TranslationKeys> = {
+  prompts: 'com_efaiw_desc_prompts',
+  skills: 'com_efaiw_desc_skills',
+  memories: 'com_efaiw_desc_memories',
+  bookmarks: 'com_efaiw_desc_bookmarks',
+  agents: 'com_efaiw_desc_builder',
+  parameters: 'com_efaiw_desc_parameters',
+  'mcp-builder': 'com_efaiw_desc_connectors',
+};
+
+const CARD_TONES: Record<string, string> = {
+  prompts: 'efaiw-tone-blue',
+  skills: 'efaiw-tone-green',
+  memories: 'efaiw-tone-brown',
+  bookmarks: 'efaiw-tone-sec',
+  'mcp-builder': 'efaiw-tone-sec',
+  parameters: 'efaiw-tone-neutral',
+};
+
+/** Opens a tool that works in the sidebar's panel (the builder, the parameters, the MCP servers, or a panel section
+ *  the deployment adds): the page lives outside the sidebar's panel state, so it presses the panel's hidden shortcut
+ *  target, as the keyboard shortcuts do, opening the sidebar (the phone's drawer) first when it is closed. */
+function useOpenSidebarPanel() {
+  const { expanded } = useSidebarState();
+  const { setSidebarOpen } = useSidebarToggle();
+  return useCallback(
+    (id: string) => {
+      const activate = () => {
+        const target = document.querySelector<HTMLButtonElement>(`[data-testid="nav-panel-${id}"]`);
+        if (target != null && !target.disabled && target.getAttribute('aria-pressed') !== 'true') {
+          target.click();
+        }
+      };
+      if (!expanded) {
+        setSidebarOpen(true, () => setTimeout(activate, 0));
+        return;
+      }
+      activate();
+    },
+    [expanded, setSidebarOpen],
+  );
+}
+
+function CustomizeCard({
+  testId,
+  icon: Icon,
+  tone,
+  title,
+  description,
+  to,
+  onOpen,
+  badge,
+  action,
+}: {
+  testId: string;
+  icon: NavLink['icon'];
+  tone?: string;
+  title: string;
+  description: string;
+  /** A page opens by its link; a panel tool by `onOpen`. The whole card is the target (`efaiw-cz-link::after`); the
+   *  badge sits beside the name and an action under the line, so a narrow card keeps its text readable. */
+  to?: string;
+  onOpen?: () => void;
+  badge?: ReactNode;
+  action?: ReactNode;
+}) {
+  const descriptionId = useId();
+  return (
+    <li className="efaiw-cz-card" data-testid={testId}>
+      <span
+        className={cn('efaiw-side-tile efaiw-cz-tile', tone ?? 'efaiw-tone-neutral')}
+        aria-hidden="true"
+      >
+        <Icon className="h-5 w-5" />
+      </span>
+      <div className="efaiw-cz-text">
+        <div className="efaiw-cz-head">
+          <h3 className="efaiw-cz-title">
+            {to != null ? (
+              <Link to={to} className="efaiw-cz-link" aria-describedby={descriptionId}>
+                {title}
+              </Link>
+            ) : (
+              <button
+                type="button"
+                className="efaiw-cz-link"
+                aria-describedby={descriptionId}
+                onClick={onOpen}
+              >
+                {title}
+              </button>
+            )}
+          </h3>
+          {badge}
+        </div>
+        <p id={descriptionId} className="efaiw-cz-desc">
+          {description}
+        </p>
+        {action != null && <div className="efaiw-cz-actions">{action}</div>}
+      </div>
+      {action == null && (
+        <ChevronLeft
+          className="efaiw-cz-chevron h-4 w-4 flex-shrink-0 ltr:rotate-180"
+          aria-hidden="true"
+        />
+      )}
+    </li>
+  );
+}
+
+/**
+ * EF (sidebar v5 #221, owner-approved): «Customize», the page of every tool, opened from the rail and the phone
+ * drawer. It is built from LibreChat's own sidebar links (useUnifiedSidebarLinks), so whatever the deployment enables
+ * appears here without a change to the sidebar:
+ *   - «For you»: ready commands, skills, memory, bookmarks, then any other section (marked «New» until described);
+ *   - «Admins only» (#189, #218): the assistants marketplace with «New assistant» (a new chat with the builder open),
+ *     the builder when the marketplace is off, the parameters, and the MCP connectors.
+ * Pages open in the main area; the chat-bound tools open in the sidebar's panel, as they always did.
+ */
+export default function EfCustomizePage() {
+  const localize = useLocalize();
+  const links = useUnifiedSidebarLinks();
+  const { user } = useAuthContext();
+  const isAdmin = user?.role === SystemRoles.ADMIN;
+  const showMarketplace = useShowMarketplace();
+  const openPanel = useOpenSidebarPanel();
+  const { startNewChat } = useNewChat();
+  const forYouId = useId();
+  const adminId = useId();
+
+  const userLinks = efCustomizeLinks(links);
+  const adminLinks = efAdminLinks(links);
+  const builder = adminLinks.find((link) => link.id === 'agents');
+  const marketplace = isAdmin && showMarketplace;
+  /** With the marketplace, the builder is its «New assistant» action; without it, the builder has its own card. */
+  const adminPanels = marketplace ? adminLinks.filter((link) => link.id !== 'agents') : adminLinks;
+  const hasCommands = userLinks.some((link) => link.id === 'prompts' || link.id === 'skills');
+
+  const newAssistant = useCallback(() => {
+    startNewChat();
+    openPanel('agents');
+  }, [openPanel, startNewChat]);
+
+  /** Admin tools carry «Admins»; a section without a description is new to the workspace. */
+  const badgeOf = (admin: boolean, unknown: boolean) => {
+    if (admin) {
+      return <span className="efaiw-admin-badge">{localize('com_efaiw_admin_only')}</span>;
+    }
+    if (unknown) {
+      return <span className="efaiw-cz-new">{localize('com_efaiw_new')}</span>;
+    }
+    return undefined;
+  };
+
+  const card = (link: NavLink, admin: boolean) => {
+    const known = CARD_DESCRIPTIONS[link.id];
+    const path = EF_PAGES[link.id];
+    const title = localize(CARD_LABELS[link.id] ?? EF_LINK_LABELS[link.id] ?? link.title);
+    return (
+      <CustomizeCard
+        key={link.id}
+        testId={`efaiw-cz-${link.id}`}
+        icon={link.icon}
+        tone={CARD_TONES[link.id]}
+        title={title}
+        description={localize(known ?? 'com_efaiw_desc_new')}
+        to={path}
+        onOpen={
+          path != null
+            ? undefined
+            : () => {
+                if (link.onClick) {
+                  link.onClick();
+                  return;
+                }
+                openPanel(link.id);
+              }
+        }
+        badge={badgeOf(admin, known == null)}
+      />
+    );
+  };
+
+  return (
+    <EfSectionPage
+      title={localize('com_efaiw_customize')}
+      hint={localize('com_efaiw_customize_hint')}
+    >
+      <div className="efaiw-cz mx-auto flex w-full max-w-4xl flex-col gap-7 px-4 py-5 md:px-6 md:py-6">
+        {userLinks.length > 0 && (
+          <section aria-labelledby={forYouId} className="flex flex-col gap-3">
+            <h2 id={forYouId} className="efaiw-cz-heading">
+              {localize('com_efaiw_customize_for_you')}
+            </h2>
+            <ul className="efaiw-cz-grid">{userLinks.map((link) => card(link, false))}</ul>
+          </section>
+        )}
+        {(marketplace || adminPanels.length > 0) && (
+          <section aria-labelledby={adminId} className="flex flex-col gap-3">
+            <h2 id={adminId} className="efaiw-cz-heading">
+              {localize('com_efaiw_admin_tools')}
+            </h2>
+            <ul className="efaiw-cz-grid">
+              {marketplace && (
+                <CustomizeCard
+                  testId="efaiw-cz-marketplace"
+                  icon={LayoutGrid}
+                  tone="efaiw-tone-sec"
+                  title={localize('com_efaiw_rail_agents')}
+                  description={localize('com_efaiw_desc_agents')}
+                  to="/agents"
+                  badge={badgeOf(true, false)}
+                  action={
+                    builder != null ? (
+                      <button
+                        type="button"
+                        data-testid="efaiw-cz-new-agent"
+                        className="efaiw-cz-action"
+                        onClick={newAssistant}
+                      >
+                        <Plus className="h-4 w-4" aria-hidden="true" />
+                        {localize('com_efaiw_new_agent')}
+                      </button>
+                    ) : undefined
+                  }
+                />
+              )}
+              {adminPanels.map((link) => card(link, true))}
+            </ul>
+          </section>
+        )}
+        {hasCommands && (
+          <p className="efaiw-cz-tip">
+            <Slash className="h-4 w-4 flex-shrink-0" aria-hidden="true" />
+            <span>{localize('com_efaiw_customize_tip')}</span>
+          </p>
+        )}
+      </div>
+    </EfSectionPage>
+  );
+}
