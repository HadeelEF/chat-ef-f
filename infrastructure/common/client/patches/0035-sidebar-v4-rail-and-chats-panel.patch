+import { memo } from 'react';
+import * as Ariakit from '@ariakit/react';
+import { LayoutGrid } from 'lucide-react';
+import { Link, useLocation } from 'react-router-dom';
+import { SystemRoles } from 'librechat-data-provider';
+import { TooltipAnchor } from '@librechat/client';
+import type { ReactNode, MouseEvent } from 'react';
+import type { NavLink } from '~/common';
+import { useAuthContext, useLocalize, useShowMarketplace } from '~/hooks';
+import { EF_PAGES, EF_LINK_LABELS, efAdminLinks, efMoreLinks } from './efSidebar';
+import { cn } from '~/utils';
+
+const popItemClass =
+  'efaiw-rail-pop-item flex h-10 w-full cursor-pointer items-center gap-3 rounded-lg px-3 text-start text-[14.5px] text-text-primary no-underline outline-none data-[active-item]:bg-surface-hover';
+
+/** Whether «More» has anything to show (its sections, or the admin tools). */
+export function useEfMoreVisible(links: NavLink[]): boolean {
+  const showMarketplace = useShowMarketplace();
+  const { user } = useAuthContext();
+  const isAdmin = user?.role === SystemRoles.ADMIN;
+  return (
+    efMoreLinks(links).length > 0 || efAdminLinks(links).length > 0 || (isAdmin && showMarketplace)
+  );
+}
+
+/**
+ * EF (sidebar v3 #198, v4 #204): «More» as a small menu, from the rail on the desktop and from the tab bar on a phone.
+ * Memory, bookmarks, ready commands and any other section the deployment enables; for admins the assistants
+ * marketplace, their builder and the parameters under «Admins only» (owner decision, #189). Sections open as pages
+ * (`onOpenPage` lets the phone close its drawer first); the chat-bound tools open as a panel (`onOpenPanel`).
+ */
+function EfMoreMenu({
+  links,
+  pageId,
+  activeId,
+  placement,
+  testId,
+  className,
+  children,
+  onOpenPage,
+  onOpenPanel,
+}: {
+  links: NavLink[];
+  pageId?: string;
+  activeId: string;
+  placement: 'left-start' | 'right-start' | 'top-end' | 'top-start';
+  testId: string;
+  /** The trigger's classes, the current look included when one of its sections is open. */
+  className: string;
+  children: ReactNode;
+  onOpenPage?: (path: string, event: MouseEvent<HTMLElement>) => void;
+  onOpenPanel: (link: NavLink) => void;
+}) {
+  const localize = useLocalize();
+  const location = useLocation();
+  const showMarketplace = useShowMarketplace();
+  const { user } = useAuthContext();
+  const isAdmin = user?.role === SystemRoles.ADMIN;
+  const moreLinks = efMoreLinks(links);
+  const adminLinks = efAdminLinks(links);
+  const hasAdminItems = adminLinks.length > 0 || (isAdmin && showMarketplace);
+  const isMarketplaceRoute = location.pathname.startsWith('/agents');
+  const labelOf = (link: NavLink) => localize(EF_LINK_LABELS[link.id] ?? link.title);
+
+  const pageClick = (path: string) => (event: MouseEvent<HTMLElement>) => {
+    if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) {
+      return;
+    }
+    onOpenPage?.(path, event);
+  };
+
+  const popItem = (link: NavLink, badge = false) => {
+    const path = EF_PAGES[link.id];
+    const content = (
+      <>
+        <link.icon
+          className="h-[18px] w-[18px] flex-shrink-0 text-text-secondary"
+          aria-hidden="true"
+        />
+        <span className="min-w-0 flex-1 truncate">{labelOf(link)}</span>
+        {badge && <span className="efaiw-admin-badge">{localize('com_efaiw_admin_only')}</span>}
+      </>
+    );
+    if (path) {
+      const current = link.id === pageId;
+      return (
+        <Ariakit.MenuItem
+          key={link.id}
+          data-testid={`${testId}-${link.id}`}
+          aria-current={current ? 'page' : undefined}
+          className={cn(popItemClass, current && 'efaiw-rail-pop-current')}
+          render={<Link to={path} onClick={pageClick(path)} />}
+        >
+          {content}
+        </Ariakit.MenuItem>
+      );
+    }
+    return (
+      <Ariakit.MenuItem
+        key={link.id}
+        data-testid={`${testId}-${link.id}`}
+        disabled={link.disabled}
+        className={cn(popItemClass, link.id === activeId && 'efaiw-rail-pop-current')}
+        onClick={() => onOpenPanel(link)}
+      >
+        {content}
+      </Ariakit.MenuItem>
+    );
+  };
+
+  return (
+    <Ariakit.MenuProvider placement={placement}>
+      <TooltipAnchor
+        side={placement.startsWith('top') ? 'top' : 'right'}
+        description={localize('com_efaiw_more')}
+        render={
+          <Ariakit.MenuButton
+            data-testid={testId}
+            aria-label={localize('com_efaiw_more')}
+            className={className}
+          >
+            {children}
+          </Ariakit.MenuButton>
+        }
+      />
+      <Ariakit.Menu
+        portal
+        gutter={14}
+        unmountOnHide
+        /* Focus moves into the menu when it opens; no focusable aria-hidden traps around the portal (axe). */
+        preserveTabOrder={false}
+        data-testid={`${testId}-menu`}
+        className="efaiw-rail-pop popover-ui z-[125] flex w-[268px] flex-col gap-0.5 rounded-2xl p-2"
+      >
+        {moreLinks.map((link) => popItem(link))}
+        {hasAdminItems && (
+          <>
+            {moreLinks.length > 0 && (
+              <Ariakit.MenuSeparator className="efaiw-rail-pop-sep mx-2 my-1 border-border-light" />
+            )}
+            <Ariakit.MenuGroup className="flex flex-col gap-0.5">
+              <Ariakit.MenuGroupLabel className="efaiw-rail-pop-label px-3 pb-0.5 pt-1.5 text-xs font-semibold text-text-secondary">
+                {localize('com_efaiw_admin_tools')}
+              </Ariakit.MenuGroupLabel>
+              {isAdmin && showMarketplace && (
+                <Ariakit.MenuItem
+                  data-testid={`${testId}-marketplace`}
+                  aria-current={isMarketplaceRoute ? 'page' : undefined}
+                  className={cn(popItemClass, isMarketplaceRoute && 'efaiw-rail-pop-current')}
+                  render={<Link to="/agents" onClick={pageClick('/agents')} />}
+                >
+                  <LayoutGrid
+                    className="h-[18px] w-[18px] flex-shrink-0 text-text-secondary"
+                    aria-hidden="true"
+                  />
+                  <span className="min-w-0 flex-1 truncate">
+                    {localize('com_efaiw_rail_agents')}
+                  </span>
+                  <span className="efaiw-admin-badge">{localize('com_efaiw_admin_only')}</span>
+                </Ariakit.MenuItem>
+              )}
+              {adminLinks.map((link) => popItem(link, true))}
+            </Ariakit.MenuGroup>
+          </>
+        )}
+      </Ariakit.Menu>
+    </Ariakit.MenuProvider>
+  );
+}
+
+export default memo(EfMoreMenu);
