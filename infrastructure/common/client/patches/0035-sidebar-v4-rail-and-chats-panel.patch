@@ -0,0 +1,338 @@
+import { memo, lazy, Suspense, useCallback, useEffect, useMemo, useRef } from 'react';
+import { useRecoilValue } from 'recoil';
+import { useLocation, useNavigate } from 'react-router-dom';
+import { ChevronLeft, Ellipsis, MessagesSquare, SquarePen, X } from 'lucide-react';
+import { Button, Sidebar, Skeleton, TooltipAnchor } from '@librechat/client';
+import type { NavLink } from '~/common';
+import { useActivePanel, resolveActivePanel, DEFAULT_PANEL } from '~/Providers';
+import { useShortcutAriaKey, useShortcutHint } from '~/hooks/useKeyboardShortcuts';
+import { CLOSE_SIDEBAR_ID } from '~/components/Chat/Menus/OpenSidebar';
+import ChatFilterMenu from '~/components/Conversations/ChatFilterMenu';
+import SidePanelNav from '~/components/SidePanel/Nav';
+import SearchBar from '~/components/Nav/SearchBar';
+import useNewChat from '~/hooks/Chat/useNewChat';
+import { useLocalize } from '~/hooks';
+import { MobileShortcutTargets as ShortcutTargets } from './mobile';
+import EfMoreMenu, { useEfMoreVisible } from './EfMoreMenu';
+import EfChatChips from './EfChatChips';
+import { EF_PAGES, EF_LINK_LABELS, EF_MAIN_PANELS, efPageIdOf, useEfPanelGuard } from './efSidebar';
+import { EF_CHATS_PANEL_ID } from './constants';
+import { cn } from '~/utils';
+import store from '~/store';
+
+const AccountSettings = lazy(() => import('~/components/Nav/AccountSettings'));
+
+/** Each tab takes its content's width plus an equal share of the rest, so a long name («المستندات», «Documents») keeps
+ *  its letters on a narrow drawer instead of every tab getting a fifth. */
+const tabClass =
+  'efaiw-tab flex min-w-0 flex-auto flex-col items-center justify-center gap-0.5 rounded-xl px-0.5 text-text-secondary no-underline outline-none';
+
+/**
+ * EF (sidebar v4 #204, owner-approved Concept 2): the chats panel. On the desktop it stands beside the rail at full
+ * height; on a phone it is the drawer, which reads as the chats screen.
+ *   - Header: «Chats», upstream's sort and filter menu, and the control that closes the panel (on a phone also the
+ *     account). A chat-bound tool (the agent builder, the parameters; admins) takes the panel under its own name, with
+ *     the way back to the chats.
+ *   - The chat search, the chips «All / Pinned / Project» (EfChatChips) and the history, pinned first.
+ *   - Phone only: a floating «New chat» and a tab bar (Chats, Projects, Skills, Documents, More); a tab closes the
+ *     drawer and opens its page, as the v3 rows did. The hidden shortcut targets live here on a phone and in the rail
+ *     on the desktop.
+ * Sections open as pages in the main area (EF_PAGES) and never replace the chats here.
+ */
+function EfChatsPanel({
+  links,
+  mobile = false,
+  expanded = true,
+  onClose,
+  onLeaveInsights,
+}: {
+  links: NavLink[];
+  mobile?: boolean;
+  expanded?: boolean;
+  onClose: (afterSlide?: () => void) => void;
+  onLeaveInsights?: () => void;
+}) {
+  const localize = useLocalize();
+  const location = useLocation();
+  const navigate = useNavigate();
+  const { active, setActive } = useActivePanel();
+  const search = useRecoilValue(store.search);
+  const switchToHistory = useRecoilValue(store.newChatSwitchToHistory);
+  const moreVisible = useEfMoreVisible(links);
+  const closeRef = useRef<HTMLButtonElement>(null);
+
+  const isInsightsRoute = location.pathname.startsWith('/insights');
+  const routeActiveId = isInsightsRoute ? 'insights' : undefined;
+  const pageId = efPageIdOf(location.pathname);
+  const activeId = routeActiveId ?? resolveActivePanel(active, links);
+  const activeLink = links.find((link) => link.id === activeId);
+  const chatsShown = activeId === DEFAULT_PANEL && !routeActiveId;
+  const labelOf = (link: NavLink) => localize(EF_LINK_LABELS[link.id] ?? link.title);
+
+  /** One guard: the rail runs it on the desktop. */
+  const guardLinks = mobile ? links : [];
+  useEfPanelGuard(guardLinks, mobile ? pageId : undefined);
+
+  const closeLabel = mobile ? 'com_nav_close_sidebar' : 'com_efaiw_collapse_chats';
+  const closeHint = useShortcutHint('toggleSidebar', localize(closeLabel));
+  const closeAriaKey = useShortcutAriaKey('toggleSidebar');
+  const newChatAriaKey = useShortcutAriaKey('newChat');
+
+  /** The phone drawer makes the chat inert while open, so focus moves into it (as upstream's drawer header did). */
+  useEffect(() => {
+    if (mobile && expanded) {
+      closeRef.current?.focus();
+    }
+  }, [mobile, expanded]);
+
+  const { startNewChat } = useNewChat({
+    onNewChat: () => {
+      if (switchToHistory) {
+        setActive(DEFAULT_PANEL);
+      }
+    },
+  });
+
+  /** Phone: close first and reset in the slide's callback, as upstream's drawer bottom bar did, so the reset does not
+   *  stall the slide; modified clicks still open /c/new in a new tab. */
+  const handleNewChat = useCallback(
+    (event: React.MouseEvent<HTMLAnchorElement>) => {
+      if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey) {
+        return;
+      }
+      event.preventDefault();
+      onClose(() => startNewChat());
+    },
+    [onClose, startNewChat],
+  );
+
+  /** Phone: a page closes the drawer first, then opens; the panel goes back to the chats if a tool held it. */
+  const openPage = useCallback(
+    (path: string, event: React.MouseEvent<HTMLElement>) => {
+      if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) {
+        return;
+      }
+      event.preventDefault();
+      if (active !== DEFAULT_PANEL) {
+        setActive(DEFAULT_PANEL);
+      }
+      onClose(() => navigate(path));
+    },
+    [active, navigate, onClose, setActive],
+  );
+
+  const openPanel = useCallback(
+    (link: NavLink) => {
+      if (link.onClick) {
+        onClose(() => link.onClick?.());
+        return;
+      }
+      setActive(link.id);
+      if (routeActiveId) {
+        onLeaveInsights?.();
+      }
+    },
+    [onClose, setActive, routeActiveId, onLeaveInsights],
+  );
+
+  /** The phone's shortcut targets close the drawer before a page opens, like the tabs. */
+  const targetLinks = useMemo(
+    () =>
+      links.map((link) =>
+        EF_PAGES[link.id] ? { ...link, onClick: () => onClose(() => link.onClick?.()) } : link,
+      ),
+    [links, onClose],
+  );
+
+  return (
+    <div
+      id={EF_CHATS_PANEL_ID}
+      className={cn(
+        'efaiw-side efaiw-chats relative flex h-full w-full min-w-0 flex-col',
+        mobile && 'efaiw-chats-mobile',
+      )}
+    >
+      <div className="efaiw-chats-head flex flex-shrink-0 items-center gap-1">
+        {chatsShown || !activeLink ? (
+          <>
+            {mobile && (
+              <img
+                src="assets/ef-baseer-icon.svg"
+                className="efaiw-rail-logo h-9 w-9 flex-shrink-0 rounded-full"
+                alt={localize('com_ui_logo', { 0: localize('com_efaiw_product_name') })}
+              />
+            )}
+            <h2 className="efaiw-chats-title min-w-0 flex-1 truncate">
