--- /dev/null
+++ b/client/src/components/UnifiedSidebar/efChatScope.ts
@@ -0,0 +1,16 @@
+import { atom } from 'jotai';
+
+/**
+ * EF (sidebar v4 #204, owner-approved Concept 2): which chats the chips above the history show. One choice at a time:
+ * every chat, the pinned ones only, or the chats of one project (or of none, `unassigned`), which the server filters
+ * by `projectId`. Session-scoped like upstream's status and bookmark filters (chatFilters.ts): a filter that hides
+ * chats should not greet the employee on the next visit.
+ */
+export type EfChatScope =
+  | { kind: 'all' }
+  | { kind: 'pinned' }
+  | { kind: 'project'; projectId: string; name: string };
+
+export const EF_UNASSIGNED_PROJECT = 'unassigned';
+
+export const efChatScopeAtom = atom<EfChatScope>({ kind: 'all' });
