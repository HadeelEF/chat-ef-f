diff --git a/client/src/components/UnifiedSidebar/EfChatChips.tsx b/client/src/components/UnifiedSidebar/EfChatChips.tsx
new file mode 100644
index 0000000..2e42afd
--- /dev/null
+++ b/client/src/components/UnifiedSidebar/EfChatChips.tsx
@@ -0,0 +1,136 @@
+import { memo, useMemo, useState } from 'react';
+import * as Ariakit from '@ariakit/react';
+import { useAtom } from 'jotai';
+import { Check, ChevronDown, FolderMinus } from 'lucide-react';
+import { usePopoverZIndex } from '@librechat/client';
+import { useProjectsInfiniteQuery } from '~/data-provider';
+import { EF_UNASSIGNED_PROJECT, efChatScopeAtom } from './efChatScope';
+import { useLocalize } from '~/hooks';
+import { cn } from '~/utils';
+
+const chipClass =
+  'efaiw-chip flex h-8 min-w-0 flex-shrink-0 items-center gap-1 rounded-full px-3 text-[13px] font-semibold outline-none';
+const itemClass =
+  'flex w-full cursor-pointer select-none items-center gap-2 rounded-lg px-2 py-2 text-sm text-text-primary outline-none data-[active-item]:bg-surface-hover';
+
+/**
+ * EF (sidebar v4 #204, owner-approved Concept 2): «All», «Pinned» and «Project ▾» above the chat history, one at a
+ * time (efChatScope.ts). The project chip lists the employee's projects and «No project»; it names the chosen one.
+ * Sorting, the archive and bookmarks stay in upstream's filter menu in the panel header.
+ */
+function EfChatChips() {
+  const localize = useLocalize();
+  const zIndex = usePopoverZIndex();
+  const [scope, setScope] = useAtom(efChatScopeAtom);
+  const [projectsOpen, setProjectsOpen] = useState(false);
+  const { data } = useProjectsInfiniteQuery(
+    { sortBy: 'lastConversationAt', sortDirection: 'desc' },
+    { enabled: projectsOpen },
+  );
+  const projects = useMemo(() => (data?.pages ?? []).flatMap((page) => page.projects), [data]);
+  const noProject = localize('com_efaiw_no_project');
+  const projectLabel = scope.kind === 'project' ? scope.name : localize('com_efaiw_chip_project');
+
+  return (
+    <div
+      role="group"
+      aria-label={localize('com_efaiw_chats_filter')}
+      className="efaiw-chips flex min-w-0 items-center gap-1.5"
+    >
+      <button
+        type="button"
+        data-testid="efaiw-chip-all"
+        aria-pressed={scope.kind === 'all'}
+        className={chipClass}
+        onClick={() => setScope({ kind: 'all' })}
+      >
+        {localize('com_efaiw_chip_all')}
+      </button>
+      <button
+        type="button"
+        data-testid="efaiw-chip-pinned"
+        aria-pressed={scope.kind === 'pinned'}
+        className={chipClass}
+        onClick={() => setScope(scope.kind === 'pinned' ? { kind: 'all' } : { kind: 'pinned' })}
+      >
+        {localize('com_efaiw_chip_pinned')}
+      </button>
+      <Ariakit.MenuProvider
+        open={projectsOpen}
+        setOpen={setProjectsOpen}
+        placement="bottom-start"
+        focusLoop={true}
+      >
+        <Ariakit.MenuButton
+          data-testid="efaiw-chip-project"
+          aria-pressed={scope.kind === 'project'}
+          aria-label={
+            scope.kind === 'project'
+              ? localize('com_efaiw_chip_project_named', { 0: scope.name })
+              : localize('com_efaiw_chip_project')
+          }
+          className={cn(chipClass, 'max-w-[9.5rem]')}
+        >
+          <span className="min-w-0 truncate">{projectLabel}</span>
+          <ChevronDown className="size-3.5 flex-shrink-0" aria-hidden="true" />
+        </Ariakit.MenuButton>
+        <Ariakit.Menu
+          portal={true}
+          gutter={6}
+          unmountOnHide={true}
+          /* Focus moves into the menu when it opens; no focusable aria-hidden traps around the portal (axe). */
+          preserveTabOrder={false}
+          data-testid="efaiw-chip-project-menu"
+          className="popover-ui max-h-80 min-w-52 max-w-72 overflow-y-auto"
+          /** Portaled beside modal dialog layers, which disable pointer events on body. */
+          style={{ zIndex, pointerEvents: 'auto' }}
+        >
+          <Ariakit.MenuGroup>
+            <Ariakit.MenuGroupLabel className="px-2 pb-1 pt-1.5 text-xs font-medium text-text-secondary">
+              {localize('com_efaiw_filter_by_project')}
+            </Ariakit.MenuGroupLabel>
+            {projects.map((project) => {
+              const checked = scope.kind === 'project' && scope.projectId === project._id;
+              return (
+                <Ariakit.MenuItem
+                  key={project._id}
+                  role="menuitemradio"
+                  aria-checked={checked}
+                  className={itemClass}
+                  onClick={() =>
+                    setScope({ kind: 'project', projectId: project._id, name: project.name })
+                  }
+                >
+                  <span className="min-w-0 flex-1 truncate">{project.name}</span>
+                  {checked && <Check className="size-4 flex-shrink-0" aria-hidden="true" />}
+                </Ariakit.MenuItem>
+              );
+            })}
+            {data != null && projects.length === 0 && (
+              <div className="px-2 py-2 text-sm text-text-secondary">
+                {localize('com_efaiw_no_projects')}
+              </div>
+            )}
+          </Ariakit.MenuGroup>
+          <Ariakit.MenuSeparator className="my-1 h-px border-border-medium" />
+          <Ariakit.MenuItem
+            role="menuitemradio"
+            aria-checked={scope.kind === 'project' && scope.projectId === EF_UNASSIGNED_PROJECT}
+            className={itemClass}
+            onClick={() =>
+              setScope({ kind: 'project', projectId: EF_UNASSIGNED_PROJECT, name: noProject })
+            }
+          >
+            <FolderMinus className="size-4 flex-shrink-0 text-text-secondary" aria-hidden="true" />
+            <span className="min-w-0 flex-1 truncate">{noProject}</span>
+            {scope.kind === 'project' && scope.projectId === EF_UNASSIGNED_PROJECT && (
+              <Check className="size-4 flex-shrink-0" aria-hidden="true" />
+            )}
+          </Ariakit.MenuItem>
+        </Ariakit.Menu>
+      </Ariakit.MenuProvider>
+    </div>
+  );
+}
+
+export default memo(EfChatChips);
