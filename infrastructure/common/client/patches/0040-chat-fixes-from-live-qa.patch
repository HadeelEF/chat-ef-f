+/** User messages whose empty reply was already retried in this page: at most one automatic retry each. */
+const retriedEmpty = new Set<string>();
+/** A reply this recent is one the employee just asked for, not an old chat being opened. */
+const FRESH_REPLY_MS = 90_000;
+
+/** A reply that only says it is searching («أبحث عن…», «Let me search…») and stops there. */
+const SEARCH_ONLY_RE =
+  /^(?:أبحث|سأبحث|جار[ٍي]? البحث|دعني أبحث|سأقوم بالبحث|let me search|i(?:'m| am) searching|searching)/i;
+const SEARCH_ONLY_MAX = 120;
+
+/**
+ * EF (live QA): a finished reply with nothing to show: no text once the suggestion block and a written search call are
+ * left out (Qwen sometimes sends only the block, only «<tool_call>…», or only «أبحث عن…»), and no tool or other output.
+ * Thinking alone does not count as an answer. A reply the employee stopped (`unfinished`) is not empty: it was cut.
+ */
+export function isEmptyReply(message: TMessage): boolean {
+  if (message.isCreatedByUser === true || message.error === true || message.unfinished === true) {
+    return false;
+  }
+  const parts = Array.isArray(message.content) ? message.content : [];
+  const other = parts.some(
+    (part) =>
+      part != null &&
+      typeof part !== 'string' &&
+      part.type !== ContentTypes.TEXT &&
+      part.type !== ContentTypes.THINK,
+  );
+  if (other) {
+    return false;
+  }
+  const text = visibleReplyText(rawReplyMarkdown(message)).trim();
+  return text === '' || (text.length < SEARCH_ONLY_MAX && SEARCH_ONLY_RE.test(text));
+}
+
+/**
+ * EF (live QA): an empty reply says so instead of showing nothing. The latest one is retried once by itself when the
+ * employee has just asked (an old chat opened later is not), and offers «أعد المحاولة».
+ */
+export const EfEmptyReply = memo(function EfEmptyReply({
+  message,
+  isLast,
+  regenerate,
+}: {
+  message: TMessage;
+  isLast: boolean;
+  regenerate: () => void;
+}) {
+  const localize = useLocalize();
+  const empty = useMemo(() => isEmptyReply(message), [message]);
+  const parentId = message.parentMessageId ?? '';
+
+  useEffect(() => {
+    if (!empty || !isLast || parentId === '' || retriedEmpty.has(parentId)) {
+      return;
+    }
+    /* A reply streamed in this page has no `createdAt` until the chat is loaded again; one loaded from the server has it. */
+    const created = message.createdAt;
+    if (created != null && !(Date.now() - Date.parse(created) < FRESH_REPLY_MS)) {
+      return;
+    }
+    retriedEmpty.add(parentId);
+    regenerate();
+  }, [empty, isLast, parentId, message.createdAt, regenerate]);
+
+  if (!empty) {
+    return null;
+  }
+  return (
+    <div className="efaiw-empty-reply" role="status">
+      <span>{localize('com_efaiw_empty_reply')}</span>
+      {isLast && (
+        <button type="button" className="efaiw-empty-retry" onClick={() => regenerate()}>
+          <RotateCcw className="icon-sm" aria-hidden="true" />
+          <span>{localize('com_efaiw_empty_retry')}</span>
+        </button>
+      )}
+    </div>
+  );
+});
