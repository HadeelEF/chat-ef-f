@@ -0,0 +1,26 @@
+/**
+ * EF (live QA): models write «<br>» for a line break inside a Markdown table cell, where Markdown has none. The reply
+ * view and the downloads show raw HTML as text, so a lone <br> tag becomes a real line break; any other HTML stays text.
+ */
+type MdNode = { type: string; value?: string; children?: MdNode[] };
+
+const BR_TAG = /^<br\s*\/?>$/i;
+
+export function htmlBreaksToBreaks<T extends MdNode>(tree: T): T {
+  const walk = (node: MdNode) => {
+    node.children?.forEach((child, i, list) => {
+      if (child.type === 'html' && BR_TAG.test((child.value ?? '').trim())) {
+        list[i] = { type: 'break' };
+      } else {
+        walk(child);
+      }
+    });
+  };
+  walk(tree);
+  return tree;
+}
+
+/** The same in the reply view, as a remark plugin. */
+export const remarkHtmlBreaks = () => (tree: MdNode) => {
+  htmlBreaksToBreaks(tree);
+};
