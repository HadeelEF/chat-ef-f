+++ b/client/src/utils/__tests__/efaiwSkills.spec.ts
@@ -0,0 +1,34 @@
+import {
+  isSkillFilename,
+  skillContextText,
+  skillFilename,
+  skillTitleFromFilename,
+} from '../efaiwSkills';
+
+describe('efaiwSkills (chat design #224)', () => {
+  it('names the attachment after the skill and reads the title back, also after the server swaps spaces', () => {
+    const name = skillFilename('كتابة المحاضر: بأسلوب الإدارة');
+    expect(name).toBe('كتابة المحاضر بأسلوب الإدارة.efaiw-skill.txt');
+    expect(isSkillFilename(name)).toBe(true);
+    expect(skillTitleFromFilename(name)).toBe('كتابة المحاضر بأسلوب الإدارة');
+    expect(skillTitleFromFilename('كتابة_المحاضر.efaiw-skill.txt')).toBe('كتابة المحاضر');
+  });
+
+  it('tells a skill attachment from any other file', () => {
+    expect(isSkillFilename('pasted-text.txt')).toBe(false);
+    expect(isSkillFilename('report.efaiw-skill.txt.pdf')).toBe(false);
+    expect(isSkillFilename(undefined)).toBe(false);
+    expect(skillFilename('  ')).toBe('skill.efaiw-skill.txt');
+  });
+
+  it('gives Baseer who chose the instructions, then the skill text', () => {
+    const text = skillContextText({
+      title: 'مراجعة الخطابات',
+      description: 'راجع الخطاب قبل إرساله',
+      body: '## الخطوات\n- دقّق اللغة',
+    });
+    expect(text.startsWith('تعليمات مهارة «مراجعة الخطابات»')).toBe(true);
+    expect(text).toContain('راجع الخطاب قبل إرساله');
+    expect(text.trimEnd().endsWith('- دقّق اللغة')).toBe(true);
+  });
+});
diff --git a/client/src/utils/efaiwFollowUps.ts b/client/src/utils/efaiwFollowUps.ts
new file mode 100644
index 0000000..b657ec4
--- /dev/null
+++ b/client/src/utils/efaiwFollowUps.ts
@@ -0,0 +1,160 @@
+/**
+ * EF (chat design #224): the suggestions under the latest reply.
+ *
+ * Baseer ends a reply with a hidden block (librechat.yaml asks for it), fenced with its own language so the Markdown
+ * renderer can drop it:
+ *
+ *   ```efaiw-followups
+ *   {"q": ["…", "…"], "a": ["letter", "shorten"]}
+ *   ```
+ *
+ * `q` are follow-up questions written from the reply itself; `a` are actions from the fund's fixed list, so a
+ * suggestion is always something the platform can do. When the block is missing or malformed, the actions come from
+ * simple rules on the reply's text and there are no questions.
+ */
+
+export const FOLLOW_UPS_LANG = 'efaiw-followups';
+
+export type EfFollowUpAction =
+  | 'letter'
+  | 'email'
+  | 'proofread'
+  | 'shorten'
+  | 'table'
+  | 'explain'
+  | 'translate';
+
+export const EF_FOLLOW_UP_ACTIONS: readonly EfFollowUpAction[] = [
+  'letter',
+  'email',
+  'proofread',
+  'shorten',
+  'table',
+  'explain',
+  'translate',
+];
+
+export interface EfFollowUps {
+  questions: string[];
+  actions: EfFollowUpAction[];
+  /** True when Baseer wrote the block; false when the actions come from the rules. */
+  fromModel: boolean;
+}
+
+const MAX_QUESTIONS = 3;
+const MAX_ACTIONS = 2;
+const MAX_QUESTION_CHARS = 90;
+
+/** Complete blocks, and a block still open at the end of the text (while the reply streams). */
+const BLOCK_RE = new RegExp(
+  '(?:^|\\n)[ \\t]*```+[ \\t]*' +
+    FOLLOW_UPS_LANG +
+    '[^\\n]*\\n([\\s\\S]*?)(?:\\n[ \\t]*```+[ \\t]*(?=\\n|$)|$)',
+  'g',
+);
+
+/** A fence at the very end whose language is still being written («```efa»), while the reply streams. */
+const PARTIAL_FENCE_RE = /\n[ \t]*```+[ \t]*(e[a-z-]*)$/;
+
+/** The reply without its suggestion blocks: for display, copy, download and sharing. */
+export function stripFollowUps(text: string): string {
+  if (!text) {
+    return text;
+  }
+  const partial = PARTIAL_FENCE_RE.exec(text);
+  if (partial != null && FOLLOW_UPS_LANG.startsWith(partial[1])) {
+    return text.slice(0, partial.index).replace(/\s+$/, '');
+  }
+  if (!text.includes(FOLLOW_UPS_LANG)) {
+    return text;
+  }
+  return text.replace(BLOCK_RE, '').replace(/\s+$/, '');
+}
+
+const isAction = (value: unknown): value is EfFollowUpAction =>
+  typeof value === 'string' && (EF_FOLLOW_UP_ACTIONS as readonly string[]).includes(value);
+
+/** The block Baseer wrote, validated: questions trimmed and short, actions only from the list. Null if absent. */
+export function parseFollowUpsBlock(text: string): Omit<EfFollowUps, 'fromModel'> | null {
+  if (!text || !text.includes(FOLLOW_UPS_LANG)) {
+    return null;
+  }
+  const matches = [...text.matchAll(BLOCK_RE)];
+  const body = matches.length > 0 ? matches[matches.length - 1][1] : '';
+  const start = body.indexOf('{');
+  const end = body.lastIndexOf('}');
+  if (start < 0 || end <= start) {
+    return null;
+  }
+  let data: unknown;
+  try {
+    data = JSON.parse(body.slice(start, end + 1));
+  } catch {
+    return null;
+  }
+  if (data == null || typeof data !== 'object') {
+    return null;
+  }
+  const { q, a } = data as { q?: unknown; a?: unknown };
+  const questions = (Array.isArray(q) ? q : [])
+    .filter((item): item is string => typeof item === 'string')
+    .map((item) => item.replace(/\s+/g, ' ').trim())
+    .filter((item) => item.length > 0 && item.length <= MAX_QUESTION_CHARS)
+    .slice(0, MAX_QUESTIONS);
+  const actions = [...new Set((Array.isArray(a) ? a : []).filter(isAction))].slice(0, MAX_ACTIONS);
+  if (questions.length === 0 && actions.length === 0) {
+    return null;
+  }
+  return { questions, actions };
+}
+
+/** The reply's language from its first strong letter: an Arabic reply gets Arabic labels and «translate to English». */
+export function replyLanguage(text: string): 'ar' | 'en' {
+  const match = /[A-Za-z؀-ۿ]/.exec(stripFollowUps(text ?? ''));
+  return match != null && /[A-Za-z]/.test(match[0]) ? 'en' : 'ar';
+}
+
+const words = (text: string) => text.split(/\s+/).filter(Boolean).length;
+
+/** A letter, a memo or minutes: opens with a subject line, a formal greeting or a «محضر» title. */
+export function isDocumentReply(text: string): boolean {
+  const head = stripFollowUps(text ?? '')
+    .replace(/^[\s>#*_]+/gm, '')
+    .split('\n')
+    .map((line) => line.trim())
+    .filter(Boolean)
+    .slice(0, 4)
+    .join('\n');
+  return /(^|\n)(الموضوع\s*:|سعادة\s|معالي\s|السلام عليكم|محضر\s|Subject\s*:|Dear\s)/i.test(head);
+}
+
+/** The rules used when the block is missing: up to two actions by the reply's shape, then translation. */
+export function ruleActions(text: string): EfFollowUpAction[] {
+  const body = stripFollowUps(text ?? '');
+  const count = words(body);
+  const hasTable = /^\s*\|.+\|\s*$/m.test(body);
+  const listItems = (body.match(/^\s*(?:[-*•]|\d+[.)])\s+\S/gm) ?? []).length;
+  const document = isDocumentReply(body);
+  const picks: EfFollowUpAction[] = [];
+  const add = (action: EfFollowUpAction, when: boolean) => {
+    if (when && picks.length < MAX_ACTIONS && !picks.includes(action)) {
+      picks.push(action);
+    }
+  };
+  add('letter', !document && (hasTable || listItems >= 3));
+  add('email', document);
+  add('proofread', document);
+  add('shorten', count > 150);
+  add('table', listItems >= 3 && !hasTable);
+  add('explain', count > 0 && count < 60 && !hasTable && listItems < 3 && !document);
+  return [...picks.slice(0, MAX_ACTIONS), 'translate'];
+}
+
+/** What the suggestions under a finished reply are: the model's block when valid, else the rules. */
+export function followUpsFor(text: string): EfFollowUps {
+  const parsed = parseFollowUpsBlock(text);
+  if (parsed != null) {
+    return { ...parsed, fromModel: true };
+  }
+  return { questions: [], actions: ruleActions(text), fromModel: false };
+}
diff --git a/client/src/utils/efaiwSkills.ts b/client/src/utils/efaiwSkills.ts
new file mode 100644
index 0000000..789ca0e
--- /dev/null
+++ b/client/src/utils/efaiwSkills.ts
@@ -0,0 +1,52 @@
+/**
+ * EF (chat design #224): a skill the employee picks with «$» travels as a text attachment, not as LibreChat's skill
+ * tools. Qwen stops its built-in web search whenever a request carries tools (#213), so the tool route would cost
+ * every skill chat its search. The attachment is a plain-text context file, the same route a long paste takes, named
+ * `<title>.efaiw-skill.txt` so the composer and the sent message can show it as a «$» skill chip.
+ */
+
+export const SKILL_FILE_SUFFIX = '.efaiw-skill.txt';
+
+/** Platform skills (ai/skills/, ADR-0017) have no display title in LibreChat: the names employees read. */
+export const PLATFORM_SKILL_TITLES: Record<string, 'com_efaiw_skill_brand'> = {
+  'ef-brand-guidelines': 'com_efaiw_skill_brand',
+};
+
+/** The upload keeps the name the browser sends, after the server swaps unsafe punctuation; the suffix survives it. */
+export const isSkillFilename = (filename?: string | null): boolean =>
+  typeof filename === 'string' && filename.toLowerCase().endsWith(SKILL_FILE_SUFFIX);
+
+export function skillFilename(title: string): string {
+  const safe = title
+    .replace(/[\\/:*?"<>|]+/g, ' ')
+    .replace(/\p{Cc}+/gu, ' ')
+    .replace(/\s+/g, ' ')
+    .trim()
+    .slice(0, 80);
+  return `${safe || 'skill'}${SKILL_FILE_SUFFIX}`;
+}
+
+/** The skill's title for the chip, from a name `skillFilename` produced (the server may have turned spaces into _). */
+export function skillTitleFromFilename(filename: string): string {
+  return filename
+    .slice(0, filename.length - SKILL_FILE_SUFFIX.length)
+    .replace(/_+/g, ' ')
+    .trim();
+}
+
+/** What Baseer reads: who the instructions are from, then the skill's own text. */
+export function skillContextText(skill: {
+  title: string;
+  description?: string;
+  body: string;
+}): string {
+  const lines = [
+    `تعليمات مهارة «${skill.title}» اختارها الموظف لهذه الرسالة. اتبعها في ردك، وابحث في الإنترنت كالمعتاد متى احتاج السؤال.`,
+    `Instructions of the skill "${skill.title}", chosen by the employee for this message. Follow them in your reply.`,
+  ];
+  if (skill.description) {
+    lines.push('', skill.description.trim());
+  }
+  lines.push('', skill.body.trim());
+  return `${lines.join('\n')}\n`;
+}
