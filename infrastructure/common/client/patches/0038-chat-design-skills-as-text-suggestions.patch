diff --git a/client/src/components/Chat/Messages/__tests__/EfReplyExtras.spec.tsx b/client/src/components/Chat/Messages/__tests__/EfReplyExtras.spec.tsx
new file mode 100644
index 0000000..cda447d
--- /dev/null
+++ b/client/src/components/Chat/Messages/__tests__/EfReplyExtras.spec.tsx
@@ -0,0 +1,85 @@
+import React from 'react';
+import { render, screen, fireEvent } from '@testing-library/react';
+import { ContentTypes } from 'librechat-data-provider';
+import type { TMessage } from 'librechat-data-provider';
+import { EfDocBar, EfFollowUps } from '../EfReplyExtras';
+
+jest.mock('~/hooks', () => ({
+  useLocalize: () => (key: string, vars?: Record<string, string>) =>
+    vars ? `${key}:${Object.values(vars).join(',')}` : key,
+}));
+
+const mockDocx = jest.fn();
+const mockPdf = jest.fn();
+jest.mock('../useDocumentDownloads', () => ({
+  __esModule: true,
+  default: () => [
+    { id: 'download-docx', ariaLabel: 'Word', onClick: mockDocx },
+    { id: 'download-pdf', ariaLabel: 'PDF', onClick: mockPdf },
+  ],
+}));
+
+const reply = (text: string, extra: Partial<TMessage> = {}) =>
+  ({
+    messageId: 'm1',
+    isCreatedByUser: false,
+    text: '',
+    content: [{ type: ContentTypes.TEXT, text }],
+    ...extra,
+  }) as unknown as TMessage;
+
+const BLOCK = '\n\n```efaiw-followups\n{"q":["قارن بالعام الماضي"],"a":["letter","shorten"]}\n```';
+
+describe('EfFollowUps (chat design #224)', () => {
+  it('shows the questions Baseer wrote and sends them as they read', () => {
+    const ask = jest.fn();
+    render(<EfFollowUps message={reply(`> **الخلاصة:** تحسّن.${BLOCK}`)} ask={ask} />);
+    fireEvent.click(screen.getByRole('button', { name: 'قارن بالعام الماضي' }));
+    expect(ask).toHaveBeenCalledWith({ text: 'قارن بالعام الماضي' });
+  });
+
+  it("sends an action as a short request in the reply's language", () => {
+    const ask = jest.fn();
+    render(<EfFollowUps message={reply(`> **الخلاصة:** تحسّن.${BLOCK}`)} ask={ask} />);
+    fireEvent.click(screen.getByRole('button', { name: 'com_efaiw_fu_letter' }));
+    expect(ask).toHaveBeenCalledWith({ text: 'حوّل هذا الرد إلى خطاب رسمي.' });
+  });
+
+  it('falls back to rules without the block, and offers Arabic for an English reply', () => {
+    const ask = jest.fn();
+    render(<EfFollowUps message={reply('Yes, two stations in Riyadh.')} ask={ask} />);
+    expect(screen.queryByRole('button', { name: /قارن/ })).toBeNull();
+    fireEvent.click(screen.getByRole('button', { name: 'com_efaiw_fu_translate_ar' }));
+    expect(ask).toHaveBeenCalledWith({ text: 'Translate the reply into Arabic.' });
+  });
+
+  it('shows nothing under a failed reply', () => {
+    const failed = {
+      messageId: 'm2',
+      isCreatedByUser: false,
+      content: [
+        { type: ContentTypes.TEXT, text: 'جزء' },
+        { type: ContentTypes.ERROR, error: 'x' },
+      ],
+    } as unknown as TMessage;
+    const { container } = render(<EfFollowUps message={failed} ask={jest.fn()} />);
+    expect(container).toBeEmptyDOMElement();
+  });
+});
+
+describe('EfDocBar (chat design #224)', () => {
+  it('offers Word and PDF under a letter, named after the chat', () => {
+    const letter = reply('**الموضوع:** ملخص التقرير\n\nسعادة المدير المحترم،\nنرفع لكم الملخص.');
+    render(<EfDocBar message={letter} title="ملخص جودة الهواء" />);
+    expect(screen.getByText(/\.docx$/)).toBeInTheDocument();
+    fireEvent.click(screen.getByRole('button', { name: 'com_efaiw_docbar_download:Word' }));
+    expect(mockDocx).toHaveBeenCalled();
+    fireEvent.click(screen.getByRole('button', { name: 'com_efaiw_docbar_download:PDF' }));
+    expect(mockPdf).toHaveBeenCalled();
+  });
+
+  it('stays away from an ordinary answer', () => {
+    const { container } = render(<EfDocBar message={reply('نعم، محطتان.')} title="t" />);
+    expect(container).toBeEmptyDOMElement();
+  });
+});
