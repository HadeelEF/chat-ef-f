diff --git a/client/src/components/Chat/Messages/EfReplyExtras.tsx b/client/src/components/Chat/Messages/EfReplyExtras.tsx
new file mode 100644
index 0000000..685aca3
--- /dev/null
+++ b/client/src/components/Chat/Messages/EfReplyExtras.tsx
@@ -0,0 +1,160 @@
+import { memo, useCallback, useMemo } from 'react';
+import {
+  CornerDownLeft,
+  Download,
+  FileText,
+  Languages,
+  Lightbulb,
+  Mail,
+  Minimize2,
+  SpellCheck,
+  Table,
+} from 'lucide-react';
+import type { LucideIcon } from 'lucide-react';
+import { ContentTypes } from 'librechat-data-provider';
+import type { TMessage } from 'librechat-data-provider';
+import type { TranslationKeys } from '~/hooks';
+import type { TAskFunction } from '~/common';
+import { followUpsFor, isDocumentReply, replyLanguage } from '~/utils/efaiwFollowUps';
+import type { EfFollowUpAction } from '~/utils/efaiwFollowUps';
+import useDocumentDownloads from './useDocumentDownloads';
+import { rawReplyMarkdown, replyMarkdown } from './DownloadReply';
+import { safeFileName } from '~/utils/efaiwDocx';
+import { useLocalize } from '~/hooks';
+
+/** What each action asks Baseer, in the reply's language so the answer keeps it. */
+const ACTION_PROMPTS: Record<EfFollowUpAction, { ar: string; en: string }> = {
+  letter: { ar: 'حوّل هذا الرد إلى خطاب رسمي.', en: 'Turn this reply into a formal letter.' },
+  email: { ar: 'اكتبه بريداً إلكترونياً موجزاً.', en: 'Write it as a short email.' },
+  proofread: {
+    ar: 'دقّق هذا النص لغوياً وصحّح أخطاءه.',
+    en: 'Proofread this text and fix its errors.',
+  },
+  shorten: { ar: 'اختصر الرد في نصف طوله.', en: 'Shorten the reply to half its length.' },
+  table: { ar: 'اعرض الرد في جدول.', en: 'Show the reply as a table.' },
+  explain: { ar: 'اشرح أكثر بمثال.', en: 'Explain more, with an example.' },
+  translate: { ar: 'ترجم الرد إلى الإنجليزية.', en: 'Translate the reply into Arabic.' },
+};
+
+const ACTION_VIEW: Record<EfFollowUpAction, { icon: LucideIcon; label: TranslationKeys }> = {
+  letter: { icon: FileText, label: 'com_efaiw_fu_letter' },
+  email: { icon: Mail, label: 'com_efaiw_fu_email' },
+  proofread: { icon: SpellCheck, label: 'com_efaiw_fu_proofread' },
+  shorten: { icon: Minimize2, label: 'com_efaiw_fu_shorten' },
+  table: { icon: Table, label: 'com_efaiw_fu_table' },
+  explain: { icon: Lightbulb, label: 'com_efaiw_fu_explain' },
+  translate: { icon: Languages, label: 'com_efaiw_fu_translate_en' },
+};
+
+/**
+ * EF (chat design #224): the suggestions under the latest finished reply. Questions come from the reply itself (the
+ * block Baseer writes, utils/efaiwFollowUps.ts) and send as they read; actions come from the fund's fixed list (or,
+ * without the block, from rules on the reply's shape) and send a short request in the reply's language.
+ */
+export const EfFollowUps = memo(function EfFollowUps({
+  message,
+  ask,
+}: {
+  message: TMessage;
+  ask: TAskFunction;
+}) {
+  const localize = useLocalize();
+  const raw = useMemo(() => rawReplyMarkdown(message), [message]);
+  const { questions, actions } = useMemo(() => followUpsFor(raw), [raw]);
+  const lang = useMemo(() => replyLanguage(raw), [raw]);
+  const send = useCallback((text: string) => ask({ text }), [ask]);
+
+  const failed =
+    Array.isArray(message.content) &&
+    message.content.some((part) => part?.type === ContentTypes.ERROR);
+  if (failed || raw.trim() === '' || (questions.length === 0 && actions.length === 0)) {
+    return null;
+  }
+  return (
+    <div className="efaiw-followups" role="group" aria-label={localize('com_efaiw_fu_title')}>
+      {questions.map((question) => (
+        <button
+          key={question}
+          type="button"
+          className="efaiw-fu-question"
+          dir="auto"
+          onClick={() => send(question)}
+        >
+          <CornerDownLeft className="icon-sm" aria-hidden="true" />
+          <span>{question}</span>
+        </button>
+      ))}
+      {actions.length > 0 && (
+        <div className="efaiw-fu-actions">
+          {actions.map((action) => {
+            const { icon: Icon, label } = ACTION_VIEW[action];
+            const text =
+              action === 'translate' && lang === 'en'
+                ? localize('com_efaiw_fu_translate_ar')
+                : localize(label);
+            return (
+              <button
+                key={action}
+                type="button"
+                className="efaiw-fu-action"
+                onClick={() => send(ACTION_PROMPTS[action][lang])}
+              >
+                <Icon className="icon-sm" aria-hidden="true" />
+                <span>{text}</span>
+              </button>
+            );
+          })}
+        </div>
+      )}
+    </div>
+  );
+});
+
+/**
+ * EF (chat design #224): a letter, a memo or minutes gets a bar with its file name and one tap to Word or PDF, in the
+ * fund's identity (the same files as the reply's download menu).
+ */
+export const EfDocBar = memo(function EfDocBar({
+  message,
+  title,
+}: {
+  message: TMessage;
+  title?: string | null;
+}) {
+  const localize = useLocalize();
+  const isDocument = useMemo(() => isDocumentReply(rawReplyMarkdown(message)), [message]);
+  const name = safeFileName(title, localize('com_efaiw_download_default_name'));
+  const markdown = useCallback(() => replyMarkdown(message), [message]);
+  const formats = useDocumentDownloads({ markdown, name, hasTable: false, isOpen: isDocument });
+
+  if (!isDocument) {
+    return null;
+  }
+  const word = formats.find((item) => item.id === 'download-docx');
+  const pdf = formats.find((item) => item.id === 'download-pdf');
+  return (
+    <div className="efaiw-docbar">
+      <span className="efaiw-fmt efaiw-fmt-docx" aria-hidden="true">
+        DOCX
+      </span>
+      <span className="efaiw-docbar-text">
+        <span dir="auto">{`${name.replace(/\.+$/, '')}.docx`}</span>
+        <small>{localize('com_efaiw_docbar_hint')}</small>
+      </span>
+      {[word, pdf].map((item, i) =>
+        item?.onClick != null ? (
+          <button
+            key={item.id}
+            type="button"
+            className={i === 0 ? 'efaiw-docbar-pill efaiw-docbar-primary' : 'efaiw-docbar-pill'}
+            aria-label={localize('com_efaiw_docbar_download', { 0: item.ariaLabel ?? '' })}
+            onClick={(e) => item.onClick?.(e)}
+          >
+            <Download className="icon-sm" aria-hidden="true" />
+            <span>{item.ariaLabel}</span>
+          </button>
+        ) : null,
+      )}
+    </div>
+  );
+});
