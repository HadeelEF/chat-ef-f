diff --git a/client/src/utils/__tests__/efaiwFollowUps.spec.ts b/client/src/utils/__tests__/efaiwFollowUps.spec.ts
new file mode 100644
index 0000000..43d58ad
--- /dev/null
+++ b/client/src/utils/__tests__/efaiwFollowUps.spec.ts
@@ -0,0 +1,67 @@
+import {
+  followUpsFor,
+  isDocumentReply,
+  parseFollowUpsBlock,
+  replyLanguage,
+  ruleActions,
+  stripFollowUps,
+} from '../efaiwFollowUps';
+
+const BLOCK =
+  '```efaiw-followups\n{"q":["ما أسباب ارتفاع الجسيمات؟","قارن بالعام الماضي"],"a":["letter","shorten"]}\n```';
+const SUMMARY =
+  '> **الخلاصة:** تحسّنت جودة الهواء 6٪.\n\n## التفاصيل\n- بند أول\n- بند ثانٍ\n- بند ثالث';
+
+describe('efaiwFollowUps (chat design #224)', () => {
+  it('reads the block Baseer writes at the end of a reply', () => {
+    expect(parseFollowUpsBlock(`${SUMMARY}\n\n${BLOCK}`)).toEqual({
+      questions: ['ما أسباب ارتفاع الجسيمات؟', 'قارن بالعام الماضي'],
+      actions: ['letter', 'shorten'],
+    });
+  });
+
+  it('removes the block from what is shown, copied, downloaded and shared, also while it streams', () => {
+    expect(stripFollowUps(`${SUMMARY}\n\n${BLOCK}`)).toBe(SUMMARY);
+    expect(stripFollowUps(`${SUMMARY}\n\n\`\`\`efaiw-followups\n{"q":["ما أسب`)).toBe(SUMMARY);
+    expect(stripFollowUps(SUMMARY)).toBe(SUMMARY);
+    expect(stripFollowUps(`${SUMMARY}\n\n\`\`\`efai`)).toBe(SUMMARY);
+    const code = 'مثال:\n```js\nconst a = 1;\n```';
+    expect(stripFollowUps(code)).toBe(code);
+    expect(stripFollowUps('نص\n```express')).toBe('نص\n```express');
+  });
+
+  it('keeps only actions from the fixed list, at most two, and short questions, at most three', () => {
+    const long = 'س'.repeat(120);
+    const text = `نص\n\`\`\`efaiw-followups\n{"q":["أ","ب","ج","د","${long}"],"a":["delete_all","letter","letter","email","table"]}\n\`\`\``;
+    expect(parseFollowUpsBlock(text)).toEqual({
+      questions: ['أ', 'ب', 'ج'],
+      actions: ['letter', 'email'],
+    });
+  });
+
+  it('ignores a malformed or empty block', () => {
+    expect(parseFollowUpsBlock('نص\n```efaiw-followups\n{q: [}\n```')).toBeNull();
+    expect(parseFollowUpsBlock('نص\n```efaiw-followups\n{"q":[],"a":[]}\n```')).toBeNull();
+    expect(parseFollowUpsBlock('نص بلا كتلة')).toBeNull();
+  });
+
+  it('falls back to rules: a summary with a table suggests a letter, a letter suggests email and proofreading', () => {
+    const table = '## ملخص\n| المؤشر | القيمة |\n|---|---|\n| PM2.5 | 35 |\n- أ\n- ب\n- ج';
+    expect(ruleActions(table)).toEqual(['letter', 'translate']);
+    const letter = '**الموضوع:** ملخص التقرير\n\nسعادة المدير المحترم،\nنرفع لكم الملخص.';
+    expect(isDocumentReply(letter)).toBe(true);
+    expect(ruleActions(letter)).toEqual(['email', 'proofread', 'translate']);
+    expect(ruleActions('نعم، يشمل التقرير محطتين في الرياض.')).toEqual(['explain', 'translate']);
+  });
+
+  it('uses the model block when valid and the rules otherwise', () => {
+    expect(followUpsFor(`${SUMMARY}\n${BLOCK}`).fromModel).toBe(true);
+    const ruled = followUpsFor('نعم، يشمل التقرير محطتين.');
+    expect(ruled).toEqual({ questions: [], actions: ['explain', 'translate'], fromModel: false });
+  });
+
+  it("detects the reply's language from its first strong letter", () => {
+    expect(replyLanguage('> **Summary:** Air quality improved.')).toBe('en');
+    expect(replyLanguage('> **الخلاصة:** تحسّنت جودة الهواء.')).toBe('ar');
+  });
+});
diff --git a/client/src/utils/__tests__/efaiwSkills.spec.ts b/client/src/utils/__tests__/efaiwSkills.spec.ts
