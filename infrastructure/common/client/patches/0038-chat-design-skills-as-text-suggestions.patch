@@ -0,0 +1,209 @@
+import { memo, useEffect, useId, useMemo, useState } from 'react';
+import * as Ariakit from '@ariakit/react';
+import { Ellipsis, GitFork, Pencil, RefreshCcw, Share2, Volume2 } from 'lucide-react';
+import { ForkOptions } from 'librechat-data-provider';
+import { DropdownPopup, TooltipAnchor, useToastContext } from '@librechat/client';
+import type { TConversation, TMessage } from 'librechat-data-provider';
+import type { MenuItemProps } from '~/common';
+import ShareButton from '~/components/Conversations/ConvoOptions/ShareButton';
+import useComposerModes, { SPEEDS } from '~/components/Chat/Input/composerModes';
+import type { SpeedId } from '~/components/Chat/Input/composerModes';
+import { useForkConvoMutation, useGetStartupConfig } from '~/data-provider';
+import { useNavigateToConvo, useLocalize } from '~/hooks';
+import { mainLandmark } from './DownloadReply';
+import { hoverButtonClasses } from './styles';
+
+/** The read-aloud control stays in the toolbar, out of view until it plays, so the menu can start it. */
+export const readAloudId = (messageId: string) => `efaiw-read-aloud-${messageId}`;
+
+const row = (icon: React.ReactNode, title: string, hint?: string) => (
+  <span className="efaiw-menu-row">
+    <span className="efaiw-menu-icon" aria-hidden="true">
+      {icon}
+    </span>
+    <span className="efaiw-menu-text">
+      <span>{title}</span>
+      {hint ? <small>{hint}</small> : null}
+    </span>
+  </span>
+);
+
+/**
+ * EF (chat design #224): «⋯» under a reply holds what is used less often, so the toolbar keeps five actions: sharing
+ * the chat first (signed-in employees only, ADR on shared links), then reading aloud, editing the reply, forking it to
+ * a new chat and asking again with each other Baseer model. Asking again switches the chat's model in place, then
+ * regenerates once the chat carries it.
+ */
+function EfReplyMore({
+  message,
+  conversation,
+  isLast,
+  canReadAloud,
+  canEdit,
+  onEdit,
+  canFork,
+  canRegenerate,
+  regenerate,
+  getLatestMessageId,
+}: {
+  message: TMessage;
+  conversation: TConversation;
+  isLast: boolean;
+  canReadAloud: boolean;
+  canEdit: boolean;
+  onEdit: () => void;
+  canFork: boolean;
+  canRegenerate: boolean;
+  regenerate: () => void;
+  getLatestMessageId?: () => string | undefined;
+}) {
+  const localize = useLocalize();
+  const menuId = useId();
+  const { showToast } = useToastContext();
+  const { data: startupConfig } = useGetStartupConfig();
+  const { navigateToConvo } = useNavigateToConvo();
+  const modes = useComposerModes();
+  const [isOpen, setIsOpen] = useState(false);
+  const [shareOpen, setShareOpen] = useState(false);
+  const [pendingSpeed, setPendingSpeed] = useState<SpeedId | null>(null);
+  const label = localize('com_efaiw_reply_more');
+  const conversationId = conversation.conversationId ?? '';
+
+  const forkConvo = useForkConvoMutation({
+    onSuccess: (data) => {
+      navigateToConvo(data.conversation);
+      showToast({ message: localize('com_ui_fork_success'), status: 'success' });
+    },
+    onError: () => showToast({ message: localize('com_ui_fork_error'), status: 'error' }),
+  });
+
+  /* Regenerate once the chat has switched to the chosen model: `regenerate` sends the chat as it is rendered. */
+  useEffect(() => {
+    if (pendingSpeed != null && modes.speed === pendingSpeed) {
+      setPendingSpeed(null);
+      regenerate();
+    }
+  }, [pendingSpeed, modes.speed, regenerate]);
+
+  const otherSpeeds = useMemo(
+    () =>
+      modes.available && canRegenerate
+        ? SPEEDS.filter((s) => s.id !== modes.speed && modes.specOf(s.id) != null)
+        : [],
+    [modes, canRegenerate],
+  );
+
+  const items: MenuItemProps[] = [];
+  if (startupConfig?.sharedLinksEnabled === true && conversationId) {
+    items.push({
+      id: 'reply-more-share',
+      onClick: () => setShareOpen(true),
+      render: (props) => (
+        <div {...props}>
+          {row(
+            <Share2 className="icon-md" />,
+            localize('com_efaiw_share_chat'),
+            localize('com_efaiw_share_chat_hint'),
+          )}
+        </div>
+      ),
+    });
+    items.push({ separate: true });
+  }
+  if (canReadAloud) {
+    items.push({
+      id: 'reply-more-read',
+      onClick: () => document.getElementById(readAloudId(message.messageId))?.click(),
+      render: (props) => (
+        <div {...props}>
+          {row(<Volume2 className="icon-md" />, localize('com_efaiw_read_aloud'))}
+        </div>
+      ),
+    });
+  }
+  if (canEdit) {
+    items.push({
+      id: 'reply-more-edit',
+      onClick: onEdit,
+      render: (props) => (
+        <div {...props}>
+          {row(<Pencil className="icon-md" />, localize('com_efaiw_edit_reply'))}
+        </div>
+      ),
+    });
+  }
+  if (canFork && conversationId) {
+    items.push({
+      id: 'reply-more-fork',
+      onClick: () =>
+        forkConvo.mutate({
+          messageId: message.messageId,
+          conversationId,
+          option: ForkOptions.DIRECT_PATH,
+          splitAtTarget: false,
+          latestMessageId: getLatestMessageId?.(),
+        }),
+      render: (props) => (
+        <div {...props}>
+          {row(<GitFork className="icon-md" />, localize('com_efaiw_fork_reply'))}
+        </div>
+      ),
+    });
+  }
+  /* One row per other Baseer model, not a sub-menu: it reads as one list on the phone's sheet. */
+  for (const s of otherSpeeds) {
+    const name = modes.specOf(s.id)?.label ?? s.id;
+    items.push({
+      id: `reply-more-redo-${s.id}`,
+      onClick: () => {
+        setPendingSpeed(s.id);
+        modes.setSpeed(s.id);
+      },
+      render: (props) => (
+        <div {...props}>
+          {row(<RefreshCcw className="icon-md" />, localize('com_efaiw_redo_with', { 0: name }))}
+        </div>
+      ),
+    });
+  }
+
+  if (items.length === 0) {
+    return null;
+  }
+
+  return (
+    <>
+      <DropdownPopup
+        portal={true}
+        menuId={menuId}
+        focusLoop={true}
+        unmountOnHide={true}
+        isOpen={isOpen}
+        setIsOpen={setIsOpen}
+        className="efaiw-reply-more-menu"
+        portalElement={mainLandmark}
+        preserveTabOrder={false}
+        trigger={
+          <TooltipAnchor
+            description={label}
+            render={
+              <Ariakit.MenuButton
+                aria-label={label}
+                data-testid={isLast ? 'reply-more-button' : undefined}
+                className={hoverButtonClasses({ isActive: isOpen || shareOpen, isLast })}
+              >
+                <Ellipsis size={19} aria-hidden="true" />
+              </Ariakit.MenuButton>
+            }
+          />
+        }
+        items={items}
+      />
+      {shareOpen && (
+        <ShareButton conversationId={conversationId} open={shareOpen} onOpenChange={setShareOpen} />
+      )}
+    </>
+  );
+}
+
+export default memo(EfReplyMore);
