new file mode 100644
index 0000000..ee84d60
--- /dev/null
+++ b/client/src/components/Chat/Input/EfSkillsTip.tsx
@@ -0,0 +1,56 @@
+import { memo, useState } from 'react';
+import { useRecoilValue } from 'recoil';
+import { Permissions, PermissionTypes } from 'librechat-data-provider';
+import { useAgentCapabilities, useGetAgentsConfig, useHasAccess, useLocalize } from '~/hooks';
+import store from '~/store';
+
+const SEEN_KEY = 'efaiw:skills-tip-seen';
+
+const wasSeen = () => {
+  try {
+    return localStorage.getItem(SEEN_KEY) === '1';
+  } catch {
+    return true;
+  }
+};
+
+/**
+ * EF (chat design #224): once, above the message box of a new chat, how to use a skill; «فهمت» hides it for good on
+ * this browser. Only where «$» works.
+ */
+function EfSkillsTip() {
+  const localize = useLocalize();
+  const [hidden, setHidden] = useState(wasSeen);
+  const dollarCommandEnabled = useRecoilValue(store.dollarCommand);
+  const canUseSkills = useHasAccess({
+    permissionType: PermissionTypes.SKILLS,
+    permission: Permissions.USE,
+  });
+  const { agentsConfig } = useGetAgentsConfig();
+  const { skillsEnabled } = useAgentCapabilities(agentsConfig?.capabilities);
+
+  if (hidden || !dollarCommandEnabled || !canUseSkills || !skillsEnabled) {
+    return null;
+  }
+  return (
+    <div className="efaiw-skills-tip" role="note">
+      <b>{localize('com_efaiw_skills_tip_title')}</b>
+      <span>{localize('com_efaiw_skills_tip_body')}</span>
+      <button
+        type="button"
+        onClick={() => {
+          try {
+            localStorage.setItem(SEEN_KEY, '1');
+          } catch {
+            /* Private mode: hidden for this visit only. */
+          }
+          setHidden(true);
+        }}
+      >
+        {localize('com_efaiw_skills_tip_ok')}
+      </button>
+    </div>
+  );
+}
+
+export default memo(EfSkillsTip);
