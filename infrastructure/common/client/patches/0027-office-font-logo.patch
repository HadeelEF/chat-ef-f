+import { embeddedOpenType, fontKey, obfuscateFont } from '../efaiwBrandAssets';
+import type { EfOfficeAssets } from '../efaiwBrandAssets';
+import { buildDocxParts } from '../efaiwDocx';
+import { buildPptxParts } from '../efaiwPptx';
+
+/** A minimal TrueType file: the OS/2, head and name tables the EOT header is read from, then filler. */
+function sfnt({ weight = 400, fsType = 4, italic = false } = {}): Uint8Array {
+  const names: Array<[number, string]> = [
+    [1, 'Test Sans'],
+    [2, weight === 700 ? 'Bold' : 'Regular'],
+    [4, `Test Sans ${weight === 700 ? 'Bold' : 'Regular'}`],
+    [5, 'Version 1.000'],
+  ];
+  const utf16be = (text: string) =>
+    Uint8Array.from([...text].flatMap((ch) => [ch.charCodeAt(0) >> 8, ch.charCodeAt(0) & 0xff]));
+  const strings = names.map(([, text]) => utf16be(text));
+  const nameSize = 6 + names.length * 12 + strings.reduce((sum, s) => sum + s.length, 0);
+  const os2At = 12 + 3 * 16;
+  const headAt = os2At + 96;
+  const nameAt = headAt + 54;
+  const font = new Uint8Array(nameAt + nameSize + 100).fill(0x5a);
+  const view = new DataView(font.buffer);
+  view.setUint32(0, 0x00010000);
+  view.setUint16(4, 3);
+  [
+    ['OS/2', os2At],
+    ['head', headAt],
+    ['name', nameAt],
+  ].forEach(([tag, offset], i) => {
+    font.set(
+      [...(tag as string)].map((ch) => ch.charCodeAt(0)),
+      12 + i * 16,
+    );
+    view.setUint32(12 + i * 16 + 8, offset as number);
+  });
+  view.setUint16(os2At + 4, weight);
+  view.setUint16(os2At + 8, fsType);
+  font.set([2, 11, 5, 3, 0, 0, 0, 0, 0, 0], os2At + 32);
+  view.setUint32(os2At + 42, 0x8000202f);
+  view.setUint16(os2At + 62, italic ? 0x21 : 0x40);
+  view.setUint32(os2At + 78, 0x20000001);
+  view.setUint32(headAt + 8, 0x12345678);
+  view.setUint16(nameAt, 0);
+  view.setUint16(nameAt + 2, names.length);
+  view.setUint16(nameAt + 4, 6 + names.length * 12);
+  let offset = 0;
+  names.forEach(([id], i) => {
+    const at = nameAt + 6 + i * 12;
+    [3, 1, 0x409, id, strings[i].length, offset].forEach((v, j) => view.setUint16(at + j * 2, v));
+    font.set(strings[i], nameAt + 6 + names.length * 12 + offset);
+    offset += strings[i].length;
+  });
+  return font;
+}
+
+const assets = (): EfOfficeAssets => ({
+  font: 'Test Sans',
+  regular: sfnt(),
+  bold: sfnt({ weight: 700 }),
+  logo: { png: new Uint8Array([137, 80, 78, 71]), width: 300, height: 100 },
+  logoWhite: { png: new Uint8Array([137, 80, 78, 71, 1]), width: 300, height: 64 },
+});
+
+describe('fontKey and obfuscateFont (ECMA-376 §17.8.1)', () => {
+  it('makes a braced, upper-case GUID', () => {
+    expect(fontKey()).toMatch(/^\{[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}\}$/);
+    expect(fontKey()).not.toBe(fontKey());
+  });
+
+  it('XORs the first 32 bytes with the GUID bytes read from the end', () => {
+    const font = new Uint8Array(40);
+    const out = obfuscateFont(font, '{00112233-4455-6677-8899-AABBCCDDEEFF}');
+    expect(Array.from(out.subarray(0, 16))).toEqual([
+      0xff, 0xee, 0xdd, 0xcc, 0xbb, 0xaa, 0x99, 0x88, 0x77, 0x66, 0x55, 0x44, 0x33, 0x22, 0x11,
+      0x00,
+    ]);
+    expect(Array.from(out.subarray(16, 32))).toEqual(Array.from(out.subarray(0, 16)));
+    expect(Array.from(out.subarray(32))).toEqual(new Array(8).fill(0));
+  });
+
+  it('gives the original font back with the same key, and leaves the input alone', () => {
+    const font = sfnt();
+    const key = fontKey();
+    const copy = font.slice();
+    expect(obfuscateFont(obfuscateFont(font, key), key)).toEqual(copy);
+    expect(font).toEqual(copy);
+  });
+});
+
+describe('embeddedOpenType', () => {
+  it('wraps the font unchanged under a header from its own tables', () => {
+    const font = sfnt({ weight: 700, italic: true });
+    const eot = embeddedOpenType(font);
+    const view = new DataView(eot.buffer);
+    expect(view.getUint32(0, true)).toBe(eot.length);
+    expect(view.getUint32(4, true)).toBe(font.length);
+    expect(view.getUint32(8, true)).toBe(0x00020001);
+    expect(Array.from(eot.subarray(16, 26))).toEqual([2, 11, 5, 3, 0, 0, 0, 0, 0, 0]);
+    expect(eot[26]).toBe(1);
+    expect(eot[27]).toBe(1);
+    expect(view.getUint32(28, true)).toBe(700);
+    expect(view.getUint16(32, true)).toBe(4);
+    expect(view.getUint16(34, true)).toBe(0x504c);
+    expect(view.getUint32(36, true)).toBe(0x8000202f);
+    expect(view.getUint32(52, true)).toBe(0x20000001);
+    expect(view.getUint32(60, true)).toBe(0x12345678);
+    const strings: string[] = [];
+    let at = 82;
+    for (let i = 0; i < 4; i++) {
+      const size = view.getUint16(at, true);
+      strings.push(new TextDecoder('utf-16le').decode(eot.subarray(at + 2, at + 2 + size)));
+      at += 4 + size;
+    }
+    expect(strings).toEqual(['Test Sans', 'Bold', 'Version 1.000', 'Test Sans Bold']);
+    expect(view.getUint16(at, true)).toBe(0);
+    expect(eot.subarray(at + 2)).toEqual(font);
+  });
+
+  it('refuses a file without the tables it needs', () => {
+    expect(() => embeddedOpenType(new Uint8Array(12))).toThrow('font tables missing');
+  });
+});
+
