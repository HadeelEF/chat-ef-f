--- /dev/null
+++ b/client/src/utils/efaiwBrandAssets.ts
@@ -0,0 +1,197 @@
+/**
+ * EF (#157): the brand's own files for Word and PowerPoint downloads, fetched from the platform (same origin, and
+ * already in the browser's cache from the app's own fonts) once per page:
+ * - Aktiv Grotesk Regular and Bold, the original files (TrueType outlines, one family). Their licence flag (fsType 4)
+ *   allows embedding for preview and print, so a reader without the font gets a read-only file (owner decision
+ *   2026-10-23, #157).
+ * - The horizontal logos (blue for white pages, white for the blue title slide), drawn to PNG at print resolution
+ *   from the original SVG. Only the viewport is sized to the artwork's own viewBox, so nothing is stretched or redrawn.
+ * Any failure gives null, and the files are written as before: Tahoma, no logo.
+ */
+export type EfLogo = { png: Uint8Array; width: number; height: number };
+
+export type EfOfficeAssets = {
+  /** The family name in the font files, which Word and PowerPoint match against. */
+  font: string;
+  regular: Uint8Array;
+  bold: Uint8Array;
+  logo: EfLogo;
+  logoWhite: EfLogo;
+};
+
+export const EF_OFFICE_FONT = 'Aktiv Grotesk';
+
+const LOGO_PX = 1600;
+
+async function bytes(path: string): Promise<Uint8Array> {
+  const response = await fetch(path);
+  if (!response.ok) {
+    throw new Error(`${path}: ${response.status}`);
+  }
+  return new Uint8Array(await response.arrayBuffer());
+}
+
+async function logoPng(path: string): Promise<EfLogo> {
+  const response = await fetch(path);
+  if (!response.ok) {
+    throw new Error(`${path}: ${response.status}`);
+  }
+  const doc = new DOMParser().parseFromString(await response.text(), 'image/svg+xml');
+  const svg = doc.documentElement;
+  const [, , width, height] = (svg.getAttribute('viewBox') ?? '').split(/[\s,]+/).map(Number);
+  if (!(width > 0 && height > 0)) {
+    throw new Error(`${path}: no viewBox`);
+  }
+  const pxW = LOGO_PX;
+  const pxH = Math.round((LOGO_PX * height) / width);
+  svg.setAttribute('width', String(pxW));
+  svg.setAttribute('height', String(pxH));
+  const url = URL.createObjectURL(
+    new Blob([new XMLSerializer().serializeToString(doc)], { type: 'image/svg+xml' }),
+  );
+  try {
+    const image = new Image();
+    image.src = url;
+    await image.decode();
+    const canvas = document.createElement('canvas');
+    canvas.width = pxW;
+    canvas.height = pxH;
+    const context = canvas.getContext('2d');
+    if (!context) {
+      throw new Error('canvas unavailable');
+    }
+    context.drawImage(image, 0, 0, pxW, pxH);
+    const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/png'));
+    if (!blob) {
+      throw new Error(`${path}: PNG encoding failed`);
+    }
+    return { png: new Uint8Array(await blob.arrayBuffer()), width, height };
+  } finally {
+    URL.revokeObjectURL(url);
+  }
+}
+
+let assets: Promise<EfOfficeAssets | null> | null = null;
+
+export function loadEfOfficeAssets(): Promise<EfOfficeAssets | null> {
+  assets ??= Promise.all([
+    bytes('/assets/fonts/aktiv-grotesk-regular.otf'),
+    bytes('/assets/fonts/aktiv-grotesk-bold.otf'),
+    logoPng('/assets/logo.svg'),
+    logoPng('/assets/logo-dark.svg'),
+  ]).then(
+    ([regular, bold, logo, logoWhite]) => ({
+      font: EF_OFFICE_FONT,
+      regular,
+      bold,
+      logo,
+      logoWhite,
+    }),
+    () => {
+      assets = null;
+      return null;
+    },
+  );
+  return assets;
+}
+
+/** A fresh GUID in braces, upper case: the key Word obfuscates an embedded font with. */
+export function fontKey(): string {
+  const hex = Array.from(crypto.getRandomValues(new Uint8Array(16)), (b) =>
+    b.toString(16).padStart(2, '0'),
+  )
+    .join('')
+    .toUpperCase();
+  return `{${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}}`;
+}
+
+/**
+ * ECMA-376 Part 1 §17.8.1: the first 32 bytes of the font XOR the key, whose bytes are the GUID's hex digits read
+ * from the end (as LibreOffice and Word read it back).
+ */
+export function obfuscateFont(font: Uint8Array, key: string): Uint8Array {
+  const hex = key.replace(/[{}-]/g, '');
+  const keyBytes = Array.from({ length: 16 }, (_, i) =>
+    parseInt(hex.slice(30 - i * 2, 32 - i * 2), 16),
+  );
+  const out = font.slice();
+  for (let i = 0; i < 32; i++) {
+    out[i] ^= keyBytes[i % 16];
+  }
+  return out;
+}
+
+/**
+ * PowerPoint keeps an embedded font as Embedded OpenType (.fntdata): a little-endian header taken from the font's own
+ * OS/2, head and name tables, then the font unchanged (version 0x00020001, no subsetting, compression or XOR).
+ */
+export function embeddedOpenType(font: Uint8Array): Uint8Array {
+  const view = new DataView(font.buffer, font.byteOffset, font.byteLength);
+  const tables = new Map<string, number>();
+  for (let i = 0; i < view.getUint16(4); i++) {
+    const at = 12 + i * 16;
+    tables.set(String.fromCharCode(...font.subarray(at, at + 4)), view.getUint32(at + 8));
+  }
+  const os2 = tables.get('OS/2');
+  const head = tables.get('head');
+  const name = tables.get('name');
+  if (os2 == null || head == null || name == null) {
+    throw new Error('font tables missing');
+  }
+  const nameString = (id: number): Uint8Array => {
+    const storage = name + view.getUint16(name + 4);
+    for (let i = 0; i < view.getUint16(name + 2); i++) {
+      const at = name + 6 + i * 12;
+      if (
+        view.getUint16(at) === 3 &&
+        view.getUint16(at + 2) === 1 &&
+        view.getUint16(at + 4) === 0x409 &&
+        view.getUint16(at + 6) === id
+      ) {
+        const raw = font.subarray(
+          storage + view.getUint16(at + 10),
+          storage + view.getUint16(at + 10) + view.getUint16(at + 8),
+        );
+        const le = new Uint8Array(raw.length);
+        for (let j = 0; j + 1 < raw.length; j += 2) {
+          le[j] = raw[j + 1];
+          le[j + 1] = raw[j];
+        }
+        return le;
+      }
+    }
+    return new Uint8Array(0);
+  };
+  const names = [nameString(1), nameString(2), nameString(5), nameString(4)];
+  // Padding1 sits at 80; each name is its size and the padding after it; then RootStringSize (0) and the font.
+  const size = 82 + names.reduce((sum, n) => sum + 4 + n.length, 0) + 2 + font.length;
+  const out = new Uint8Array(size);
+  const eot = new DataView(out.buffer);
+  eot.setUint32(0, size, true);
+  eot.setUint32(4, font.length, true);
+  eot.setUint32(8, 0x00020001, true);
+  eot.setUint32(12, 0, true);
+  out.set(font.subarray(os2 + 32, os2 + 42), 16);
+  out[26] = 1;
+  out[27] = view.getUint16(os2 + 62) & 1;
+  eot.setUint32(28, view.getUint16(os2 + 4), true);
