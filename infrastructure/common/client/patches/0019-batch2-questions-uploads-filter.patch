--- /dev/null
+++ b/client/src/components/Messages/Content/Error/ContentFilterError.tsx
@@ -0,0 +1,19 @@
+import type { ErrorRendererProps } from './parts';
+import { readString } from './parts';
+import { useLocalize } from '~/hooks';
+
+/** The server's block message names the pattern's label: "Submitted content contains a <label>. Remove it…". */
+const LABEL_PATTERN = /contains an? (.+?)\. Remove it/;
+
+/**
+ * EF (#129): a message or file the sensitive-data filter (`filters` in librechat.yaml) refused
+ * before it reached the model. The payload has no `code`, so it fell through to the provider
+ * renderer («Qwen could not complete this request» + the raw code), which blamed the model.
+ */
+export default function ContentFilterError({ json }: ErrorRendererProps) {
+  const localize = useLocalize();
+  const label = LABEL_PATTERN.exec(readString(json, 'message') ?? '')?.[1];
+  return label != null
+    ? localize('com_efaiw_content_filter_block', { 0: label })
+    : localize('com_efaiw_content_filter_block_generic');
+}
