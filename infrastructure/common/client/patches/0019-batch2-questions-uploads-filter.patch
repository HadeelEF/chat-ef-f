diff --git a/client/src/utils/efaiwFiles.ts b/client/src/utils/efaiwFiles.ts
new file mode 100644
index 0000000..a079fbf
--- /dev/null
+++ b/client/src/utils/efaiwFiles.ts
@@ -0,0 +1,56 @@
+import type { TranslationKeys } from '~/hooks/useLocalize';
+
+type Localize = (key: TranslationKeys, values?: Record<string, string>) => string;
+
+/**
+ * EF (#129): file texts that upstream writes as fixed English, mapped to translated ones. Uploads
+ * became an employee feature with #129, and these showed in English in the Arabic UI.
+ *
+ * Upload errors: sentences from the browser (utils/files.ts) or the server's upload response.
+ */
+const FILE_ERRORS: Array<[RegExp, TranslationKeys]> = [
+  [/^File size limit exceeded: (\S+) MB$/, 'com_efaiw_file_size_limit'],
+  [/^Total file size limit exceeded: (\S+) MB$/, 'com_efaiw_file_total_size_limit'],
+  [/^File limit reached: (\d+) files$/, 'com_efaiw_file_count_limit'],
+  [/^Unable to determine file type for: (.+)$/, 'com_efaiw_file_type_unknown'],
+  [/^Unsupported file type: (.*)$/, 'com_efaiw_file_type_unsupported'],
+  [/^No text found in document$/, 'com_efaiw_file_no_text'],
+  [
+    /^Submitted content contains an? (.+?)\. Remove it and try again\.$/,
+    'com_efaiw_content_filter_block',
+  ],
+  [
+    /^Submitted content was blocked by content policy\.$/,
+    'com_efaiw_content_filter_block_generic',
+  ],
+];
+
+/** The translated sentence for a known upstream upload error, or undefined. */
+export function localizeFileError(message: string, localize: Localize): string | undefined {
+  for (const [pattern, key] of FILE_ERRORS) {
+    const match = pattern.exec(message);
+    if (match != null) {
+      return localize(key, match[1] != null ? { 0: match[1] } : undefined);
+    }
+  }
+  return undefined;
+}
+
+/** File kinds under a file's name: the chip's `fileTypes[...].title` and the preview's type. */
+const FILE_TYPE_TITLES: Record<string, TranslationKeys> = {
+  Document: 'com_efaiw_filetype_document',
+  Spreadsheet: 'com_efaiw_filetype_spreadsheet',
+  Presentation: 'com_efaiw_filetype_presentation',
+  Code: 'com_efaiw_filetype_code',
+  Audio: 'com_efaiw_filetype_audio',
+  Video: 'com_efaiw_filetype_video',
+  Image: 'com_efaiw_filetype_image',
+  Text: 'com_efaiw_filetype_text',
+  File: 'com_efaiw_filetype_file',
+};
+
+/** The translated kind for an upstream file-type title; other titles (PDF, CSV, …) unchanged. */
+export function localizeFileTypeTitle(title: string, localize: Localize): string {
+  const key = FILE_TYPE_TITLES[title];
+  return key != null ? localize(key) : title;
+}
