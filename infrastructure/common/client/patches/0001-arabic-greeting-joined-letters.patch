+++ b/packages/client/src/components/SplitText.tsx
@@ -58,6 +58,11 @@ const splitGraphemes = (text: string): string[] => {
   }
 };
 
+/** Letters of joining scripts must stay in one box per word, or each letter takes its isolated form. */
+const JOINING_SCRIPT = /[\p{Script=Arabic}\p{Script=Syriac}\p{Script=Nko}\p{Script=Mongolian}\p{Script=Adlam}]/u;
+const splitUnits = (word: string): string[] =>
+  JOINING_SCRIPT.test(word) ? [word] : splitGraphemes(word);
+
 const SplitText: React.FC<SplitTextProps> = ({
   text = '',
   className = '',
@@ -71,7 +76,7 @@ const SplitText: React.FC<SplitTextProps> = ({
   onLetterAnimationComplete,
   onLineCountChange,
 }) => {
