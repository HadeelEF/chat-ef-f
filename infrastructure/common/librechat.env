# EF AI Workspace — LibreChat application policy, shared by EVERY environment (Railway, Windows local, Ubuntu on-premises).
#
# Single source of truth for non-secret application behaviour:
#   - Docker Compose reads this file with `env_file:` (infrastructure/compose/compose.yaml).
#   - Railway: .railway/railway.ts declares the same KEY=value pairs; scripts/validate/railway_checks.py fails
#     if the two drift apart.
# NO SECRETS and nothing environment-specific here (no URLs, hosts, ports or credentials).
# Change a value only through a reviewed pull request; security-relevant flags are enforced by compose_checks.py.

NODE_ENV=production
CONFIG_PATH=/app/librechat.yaml
# Exactly one reverse proxy hop in front of LibreChat (Railway edge, on-prem Caddy) — needed for correct client IPs.
TRUST_PROXY=1
NO_INDEX=true

# Authentication policy (ADR-0024; Entra ID SSO is M6).
#   - LibreChat's own registration form is off: no sign-up link and /api/auth/register refuses. Accounts are created by
#     the administrator with `npm run create-user` (docs/operations/deployment.md section 3); existing accounts keep
#     signing in with email and password.
ALLOW_REGISTRATION=false
ALLOW_EMAIL_LOGIN=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=false
# Shared links for signed-in employees only (#125): PUBLIC=false keeps every link behind the login, also for links a
# user marks "public" (interface.sharedLinks in librechat.yaml). Never set PUBLIC to true: it would open those links to
# anyone on the internet.
ALLOW_SHARED_LINKS=true
ALLOW_SHARED_LINKS_PUBLIC=false

# Conversation search (OD-02 #4: Meilisearch in M3; owner decision 2026-10-21, #125). The private Meilisearch service
# and its key are per environment: MEILI_HOST and MEILI_MASTER_KEY come from compose.yaml / .railway/railway.ts.
SEARCH=true
# Every start indexes whatever is missing from the index (#135). Upstream's default (1000) skips the start-up sync while
# fewer than 1000 messages are unindexed, once anything is indexed at all: on Railway dev 28 of 30 messages stayed out
# of the index and search found nothing (api/db/indexSync.js). Chats written while LibreChat runs are indexed at once.
MEILI_SYNC_THRESHOLD=0

# Scheduled chats (experimental upstream, Agents scope M5): firing is switched off. The engine still arms for
# reconciliation and needs Redis or this assertion; it is true because every environment runs exactly ONE librechat
# replica (enforced by compose_checks.py and railway_checks.py). Revisit both values before scaling or enabling schedules.
SCHEDULES_DISABLED=true
SCHEDULES_SINGLE_PROCESS=true

DEBUG_LOGGING=false

# PROVISIONAL (FR-015 AC-3): owner-selected working name «بصير» (2026-10-19); not institutional brand approval (D-04, #7).
# In v0.8.8 it sets the browser-tab title and login logo alt text, not the logo or PWA name (docs/design/design-system.md §4).
APP_TITLE=بصير | صندوق البيئة

# No upstream branding or links in the UI (#43, L1; docs/design/audits/brand-implementation-matrix.md S-04, S-05c). LICENSE
# stays in the image (MIT notice).
#   CUSTOM_FOOTER replaces "LibreChat v0.8.8 - Every AI for Everyone" under the composer with a trust notice (#100, UX audit
#   U-04) in production wording that keeps the data rule (#108). PROVISIONAL until Corporate Communications approves it
#   (#7). Markdown; `|` would split it in parts.
#   HELP_AND_FAQ_URL -> the account menu's «المساعدة» opens the EF help page shipped with the web client
#   (infrastructure/common/client/brand/assets/ef-help.html, #103), never librechat.ai. PROVISIONAL text (#7).
CUSTOM_FOOTER=بصير قد يخطئ، فتحقّق من المعلومات المهمة. لا تُدخل معلومات سرية أو بيانات شخصية.
HELP_AND_FAQ_URL=/assets/ef-help.html

# Web client (#105): serve the pre-built brotli files next to the gzip ones (about 12% smaller on first load).
ENABLE_STATIC_ASSET_BROTLI=true
