# EF AI Workspace — environment template for the Docker Compose stacks in this directory (Windows local, Ubuntu on-prem).
#
# PLACEHOLDERS ONLY. Never commit a filled-in copy (.env is git-ignored). Railway does not use this file
# (.railway/railway.ts + scripts/setup/railway-secrets.sh).
# Generate a complete .env instead of editing by hand (Linux / WSL2 / macOS):
#   scripts/setup/new-env.sh local      |   scripts/setup/new-env.sh onprem --hostname <dns-name>
# Required values are intentionally empty: `docker compose` refuses to start until each one is set.
# Every secret is generated freshly per environment; use hex/alphanumeric values only (they are embedded in a URI).
# Development and production credentials are always different: never copy a .env between environments.

# --- URL users open (local: http://localhost:3080; on-prem: https://<EFAIW_HOSTNAME>) ---
DOMAIN_CLIENT=
DOMAIN_SERVER=

# --- Admin Panel (required, ADR-0016) ---
# URL admins open (local: http://localhost:3000; on-prem: https://<EFAIW_ADMIN_HOSTNAME>), without a trailing slash.
ADMIN_PANEL_URL=
# Session encryption key of the panel: 32 bytes as 64 hex chars.
ADMIN_PANEL_SESSION_SECRET=

# --- LibreChat secrets (required) ---
# CREDS_KEY: 32 bytes as 64 hex chars. Losing CREDS_KEY/CREDS_IV makes stored credentials unreadable: keep a copy
# in an approved secret store (on-prem) — not in Git, not in chat.
CREDS_KEY=
# CREDS_IV: 16 bytes as 32 hex chars
CREDS_IV=
# JWT secrets: 32 bytes as 64 hex chars each
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- MongoDB (required) ---
# Root account: used only by the MongoDB entrypoint and for backup/restore, never by LibreChat.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
# Least-privilege application account (readWrite on MONGO_APP_DATABASE only), created on first start.
MONGO_APP_USERNAME=
MONGO_APP_PASSWORD=
# Optional; defaults to LibreChat.
# MONGO_APP_DATABASE=LibreChat

# --- Meilisearch, conversation search (required, #125) ---
# Master key of the private search service: 32 bytes as 64 hex chars. The index is rebuilt from MongoDB, so a lost key
# only means a new key and an empty index that LibreChat refills on its next start.
MEILI_MASTER_KEY=

# --- Approved LLM provider (#37, OD-01) — optional for local stacks ---
# API key of the Qwen endpoint (Alibaba Cloud Model Studio, OpenAI-compatible API). Leave empty to run without a
# model: chats then end with a generic provider error. Synthetic data only; never commit a real key.
QWEN_API_KEY=

# --- Windows / workstation local (compose.local.yaml) ---
# Loopback port for http://localhost:<port> (default 3080).
# LOCAL_HTTP_PORT=3080
# Loopback port of the Admin Panel, http://localhost:<port> (default 3000).
# LOCAL_ADMIN_PORT=3000

# --- Ubuntu on-premises (compose.onprem.yaml) ---
# Internal DNS name users open (must resolve to this server), e.g. ai-workspace.internal.example
EFAIW_HOSTNAME=
# Internal DNS name of the Admin Panel (must resolve to this server; covered by the same certificate), e.g.
# admin.ai-workspace.internal.example
EFAIW_ADMIN_HOSTNAME=
# TLS mode for the Caddy reverse proxy (docs/operations/ubuntu-onprem.md):
#   /etc/caddy/tls/fullchain.pem /etc/caddy/tls/privkey.pem   enterprise CA certificate placed in EFAIW_TLS_DIR (recommended)
#   internal                                                   Caddy's own CA (lab / pilot only; clients must trust it)
#   ops@example.com                                            public ACME (only for publicly resolvable names)
EFAIW_TLS=
# Host directory holding fullchain.pem / privkey.pem (default ./tls, git-ignored).
# EFAIW_TLS_DIR=./tls
# Interface and ports the proxy publishes (defaults 0.0.0.0, 80, 443). Restrict with the host firewall as well.
# EFAIW_BIND_ADDRESS=0.0.0.0
# EFAIW_HTTP_PORT=80
# EFAIW_HTTPS_PORT=443
