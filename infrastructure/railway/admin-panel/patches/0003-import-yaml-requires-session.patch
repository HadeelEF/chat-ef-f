+/**
+ * EF AI Workspace (#165): the session check {@link apiFetch} makes, for a server function that
+ * never calls the LibreChat API.
+ *
+ * @throws {Error} If no session bearer is available even after a refresh attempt.
+ */
+export async function requireAdminBearer(): Promise<void> {
+  if (!(await ensureFreshBearer(PROACTIVE_REFRESH_SKEW_MS))) {
+    throw new Error('No admin session token available');
+  }
