+/**
+ * EF AI Workspace (#160): Environment Fund brand files, copied from the repository's brand folder into public/ef by
+ * the image build (infrastructure/railway/admin-panel.Dockerfile), unaltered.
+ */
+const base = (import.meta.env.VITE_BASE_PATH || '').replace(/\/$/, '');
+
+export const efAsset = (file: string): string => `${base}/ef/${file}`;
