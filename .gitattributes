# Normalize line endings in the repository
* text=auto eol=lf

# Explicit text types
*.md   text diff=markdown
*.yml  text
*.yaml text
*.json text
*.py   text diff=python
*.sh   text eol=lf

# Binary brand assets (never diffed or normalized)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.pdf  binary

# EF brand files are kept byte for byte as delivered (brand guideline: preserve the original logo files)
infrastructure/common/client/brand/assets/*.svg -text
